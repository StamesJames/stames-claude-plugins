#!/usr/bin/env python3
"""workflow-lists: mechanical checks and summaries for the dev-workflow list files.

Run from the target project (any directory inside its git repo):

  workflow-lists check [--errors-only] [FILE...]   validate lists, CLAUDE.md, USER_WORKFLOW.md
  workflow-lists summary [--ideas] [FILE...]       one line per open item
  workflow-lists stamp                             value for _Found:_ / _Written:_ stamps
  workflow-lists hook                              PostToolUse hook (reads hook JSON on stdin)

The rules checked here are the mechanical part of
skills/setup-workflow/list-format.md; keep both in sync.
Exit codes: 0 fine (warnings allowed), 1 errors found, 2 not set up or bad usage.
Standard library only.
"""

import json
import re
import subprocess
import sys
import time
from pathlib import Path

LISTS = ["CLAUDE_ANALYSIS.md", "USER_ANALYSIS.md", "CLAUDE_PLAN.md", "USER_PLAN.md"]
KIND = {
    "CLAUDE_ANALYSIS.md": "analysis",
    "USER_ANALYSIS.md": "analysis",
    "CLAUDE_PLAN.md": "plan",
    "USER_PLAN.md": "plan",
}
USER_FILES = {"USER_ANALYSIS.md", "USER_PLAN.md"}
# How ids are written outside the files (list-format.md -> "Ids outside the files").
REF_PREFIX = {
    "CLAUDE_ANALYSIS.md": "",
    "USER_ANALYSIS.md": "U",
    "CLAUDE_PLAN.md": "claude:",
    "USER_PLAN.md": "",
}
ANALYSIS_SECTIONS = {
    1: "Bugs",
    2: "Performance",
    3: "Cleanliness / architecture",
    4: "Suggested order of work",
}
SEVERITIES = {"H", "M", "L"}
TAGS = SEVERITIES | {"HOLD", "CONFLICT"}
EFFORTS = {"low", "medium", "high", "xhigh", "max"}
OLD_PATHS = [".claude/skills/", "~/.claude/skills"]
REMOVED_SKILLS = {
    "/fix-next-user-finding": "`/fix-next-finding user-only`",
    "/fix-all-user-findings": "`/fix-all-findings user-only`",
    "/implement-all-claude-features": "approving CLAUDE_PLAN.md items into USER_PLAN.md",
}
TEMPLATES = Path(__file__).resolve().parent.parent / "skills" / "setup-workflow" / "templates"

DATE = r"\d{4}-\d{2}-\d{2} \d{2}:\d{2} [A-Za-z0-9+:-]+"
COMMIT = r"`?(?:[0-9a-f]{4,40}|no commit)`?"
STAMP_RE = {
    "analysis": re.compile(rf"^_Found: {DATE} \({COMMIT}\)_$"),
    "plan": re.compile(rf"^_Written: {DATE} \({COMMIT}\)_$"),
}
UPDATED_RE = re.compile(rf"^_Updated: {DATE} \({COMMIT}\)_$")
FAILED_RE = re.compile(
    rf"^_Failed: {DATE} \(`?(?P<branch>workflow/failed/[^`,\s]+)`?, [^)]+\): .+_$"
)
MODEL_RE = re.compile(r"^\*\*Model:\*\* `?[\w.:-]+`?(?:, reasoning (?P<effort>\w+))?\s*$")
NEXT_ID_RE = re.compile(r"^_Next id: (?P<id>\S+?)_\s*$")
HEADING_RE = re.compile(r"^###\s+(?P<rest>.*)$")
ID_RE = re.compile(r"^(?P<id>(?:\d+\.\d+|[FI]\d+))\b\s*(?P<rest>.*)$")
FIELD_RE = re.compile(r"^\s*(?:[-*]\s+)?\*\*(?P<key>[^*]+?):?\*\*:?")
BRANCH_RE = re.compile(r"workflow/failed/[\w./-]*[\w-]")
PASS_RE = re.compile(rf"^- {DATE} at {COMMIT}: .+")
DROPPED_RE = re.compile(r"^- (?P<id>[FI]\d+) .+ — .+ \(\d{4}-\d{2}-\d{2}[^)]*\)\.?$")
PLAN_REF_RE = re.compile(r"(?<![\w:])(?P<claude>claude:)?(?P<id>[FI]\d+)\b")
ANALYSIS_REF_RE = re.compile(r"(?<![\w.:/-])(?P<user>U)?(?P<id>\d+\.\d+)(?!\w|\.\d)")


# --------------------------------------------------------------------------- helpers


def git(root, *args):
    try:
        out = subprocess.run(
            ["git", *args], cwd=root, capture_output=True, text=True, check=True
        )
    except (OSError, subprocess.CalledProcessError):
        return None
    return out.stdout.strip()


def find_root(start):
    top = git(start, "rev-parse", "--show-toplevel")
    return Path(top) if top else Path(start).resolve()


def masked_lines(text):
    """Lines with HTML comments and fenced code blanked out, line numbers preserved."""
    text = re.sub(r"<!--.*?-->", lambda m: "\n" * m.group().count("\n"), text, flags=re.S)
    lines, fenced = [], False
    for line in text.split("\n"):
        if line.lstrip().startswith("```"):
            fenced = not fenced
            lines.append("")
        else:
            lines.append("" if fenced else line)
    return lines


def slug(title):
    words = re.findall(r"[a-z0-9]+", title.lower())[:5]
    return "-".join(words) or "untitled"


def plural(n, word):
    return f"{n} {word}" + ("" if n == 1 else "s")


class Problems:
    def __init__(self):
        self.items = []

    def add(self, level, file, line, msg, about=None):
        self.items.append(
            {"level": level, "file": file, "line": line, "msg": msg, "about": about or file}
        )


# --------------------------------------------------------------------------- parsing


class Section:
    def __init__(self, title, line):
        self.title = title
        self.line = line
        self.role = "other"  # items | order | dropped | other
        self.number = None  # analysis section number
        self.prefix = None  # expected id prefix ("1." / "F" / "I")
        self.next_ids = []  # (line, value)
        self.no_open = []  # line numbers of "_No open items._" / "_None yet._"
        self.items = []
        self.text = []  # (line, text) of section-level lines


class Item:
    def __init__(self, file, section, line, heading):
        self.file = file
        self.section = section
        self.line = line
        self.heading = heading
        self.id = None
        self.tags = []
        self.title = ""
        self.body = []  # (line, text)

    @property
    def ref(self):
        if self.id is None:
            return slug(self.title)
        return REF_PREFIX[self.file] + self.id

    @property
    def severity(self):
        return self.tags[0] if self.tags and self.tags[0] in SEVERITIES else None

    def field(self, *keys):
        for _, text in self.body:
            m = FIELD_RE.match(text)
            if m and m.group("key").strip().lower() in keys:
                return text[m.end():].strip()
        return None

    def fields(self):
        keys = set()
        for _, text in self.body:
            m = FIELD_RE.match(text)
            if m:
                keys.add(m.group("key").strip().lower())
        return keys


class ListFile:
    def __init__(self, root, name):
        self.name = name
        self.kind = KIND[name]
        self.user = name in USER_FILES
        self.path = root / name
        self.exists = self.path.is_file()
        self.raw = self.path.read_text(encoding="utf-8") if self.exists else ""
        self.lines = masked_lines(self.raw)
        self.header = []  # (line, text) before the first "## "
        self.sections = []
        self.stray = []  # items before any section
        if self.exists:
            self._parse()

    def _parse(self):
        section = item = None
        for n, line in enumerate(self.lines, 1):
            if line.startswith("## "):
                section, item = Section(line[3:].strip(), n), None
                self._classify(section)
                self.sections.append(section)
                continue
            m = HEADING_RE.match(line)
            if m:
                item = Item(self.name, section, n, m.group("rest").strip())
                self._parse_heading(item)
                (section.items if section else self.stray).append(item)
                continue
            if item is not None:
                item.body.append((n, line))
            elif section is not None:
                section.text.append((n, line))
                if NEXT_ID_RE.match(line.strip()):
                    section.next_ids.append((n, NEXT_ID_RE.match(line.strip()).group("id")))
                elif line.strip() in ("_No open items._", "_None yet._"):
                    section.no_open.append(n)
            else:
                self.header.append((n, line))

    def _classify(self, section):
        title = section.title
        if self.kind == "analysis":
            m = re.match(r"^(\d+)\.\s*(.*)$", title)
            if m:
                section.number = int(m.group(1))
                if section.number in (1, 2, 3):
                    section.role, section.prefix = "items", f"{section.number}."
                elif section.number == 4:
                    section.role = "order"
        else:
            low = title.lower()
            if low == "concrete features":
                section.role, section.prefix = "items", "F"
            elif low == "ideas":
                section.role, section.prefix = "items", "I"
            elif low == "dropped":
                section.role = "dropped"
            elif "order" in low:
                section.role = "order"

    @staticmethod
    def _parse_heading(item):
        rest = item.heading
        m = ID_RE.match(rest)
        if m:
            item.id, rest = m.group("id"), m.group("rest")
        while True:
            t = re.match(r"^\[([A-Za-z]+)\]\s*", rest)
            if not t:
                break
            item.tags.append(t.group(1).upper() if t.group(1).upper() in TAGS else t.group(1))
            rest = rest[t.end():]
        item.title = rest.strip()

    def items(self, ideas=True):
        for s in self.sections:
            if s.role == "items" and (ideas or s.prefix != "I"):
                yield from s.items

    def section(self, role=None, prefix=None, number=None):
        for s in self.sections:
            if (role is None or s.role == role) and (prefix is None or s.prefix == prefix) and (
                number is None or s.number == number
            ):
                return s
        return None


def load(root):
    return {name: ListFile(root, name) for name in LISTS}


# --------------------------------------------------------------------------- checks


def id_number(item_id):
    return int(re.search(r"(\d+)$", item_id).group(1))


def check_structure(lf, probs):
    name = lf.name
    entry = "warn" if lf.user else "error"
    for it in lf.stray:
        probs.add("error", name, it.line, f"item `{it.heading}` sits before any `## ` section")

    if lf.kind == "analysis":
        for num, title in ANALYSIS_SECTIONS.items():
            if not lf.section(number=num):
                probs.add("error", name, None, f"missing section `## {num}. {title}`")
    else:
        for title, prefix in (("Concrete features", "F"), ("Ideas", "I")):
            if not lf.section(prefix=prefix):
                probs.add("error", name, None, f"missing section `## {title}`")
        if not lf.user and not lf.section(role="dropped"):
            probs.add("error", name, None, "missing section `## Dropped`")
    if not lf.user:
        for s in lf.sections:
            if s.role == "other":
                probs.add("warn", name, s.line, f"unexpected section `## {s.title}`")

    seen = {}
    for s in lf.sections:
        if s.role != "items":
            continue
        next_val = None
        if not s.next_ids:
            probs.add("error", name, s.line, f"section `{s.title}` has no `_Next id:_` line")
        elif len(s.next_ids) > 1:
            probs.add("error", name, s.next_ids[1][0], f"section `{s.title}` has several `_Next id:_` lines")
        if s.next_ids:
            line, val = s.next_ids[0]
            if not re.fullmatch(re.escape(s.prefix) + r"\d+", val):
                probs.add("error", name, line, f"`_Next id: {val}_` should look like `{s.prefix}<n>`")
            else:
                next_val = id_number(val)
        if s.items and s.no_open:
            probs.add("error", name, s.no_open[0], f"`_No open items._` in `{s.title}`, which has items")
        if not s.items and not s.no_open:
            probs.add("error", name, s.line, f"empty section `{s.title}` lacks its `_No open items._` line")

        for it in s.items:
            for line, text in it.body:
                if NEXT_ID_RE.match(text.strip()):
                    probs.add("error", name, line, "`_Next id:_` must come before the first item of its section")
            if it.id is None:
                if lf.kind == "analysis" or not lf.user:
                    probs.add(entry, name, it.line, f"heading `{it.heading}` has no id")
            else:
                if not re.fullmatch(re.escape(s.prefix) + r"\d+", it.id):
                    probs.add(entry, name, it.line, f"id {it.id} doesn't belong in `{s.title}` (expected `{s.prefix}<n>`)")
                elif next_val is not None and id_number(it.id) >= next_val:
                    probs.add("error", name, it.line, f"id {it.id} is not below `_Next id: {s.next_ids[0][1]}_` (count the next id up)")
                if it.id in seen:
                    probs.add("error", name, it.line, f"duplicate id {it.id} (also line {seen[it.id]}); ids are never reused")
                else:
                    seen[it.id] = it.line
            check_entry(lf, it, probs)

    dropped = lf.section(role="dropped")
    if dropped:
        entries = [(n, t.strip()) for n, t in dropped.text if t.strip().startswith("- ")]
        if entries and dropped.no_open:
            probs.add("error", name, dropped.no_open[0], "`_None yet._` in `Dropped`, which has entries")
        for n, t in entries:
            m = DROPPED_RE.match(t)
            if not m:
                probs.add("warn", name, n, "dropped line should read `- <id> <name> — <reason> (<date>)`")
            elif m.group("id") in seen:
                probs.add("error", name, n, f"dropped id {m.group('id')} is also an open item (line {seen[m.group('id')]}); ids are never reused")


def check_entry(lf, it, probs):
    name = lf.name
    entry = "warn" if lf.user else "error"
    if not it.tags or it.severity is None:
        probs.add(entry, name, it.line, f"{it.ref}: severity [H], [M] or [L] should follow the id")
    for tag in it.tags[1:]:
        if tag not in TAGS:
            probs.add("warn", name, it.line, f"{it.ref}: unknown tag [{tag}]")
        elif tag in SEVERITIES:
            probs.add(entry, name, it.line, f"{it.ref}: several severities")
    if "CONFLICT" in it.tags and lf.kind == "analysis":
        probs.add("warn", name, it.line, f"{it.ref}: [CONFLICT] is only used in plan files")

    body = [(n, t.strip()) for n, t in it.body if t.strip()]
    stamp_word = "_Found:" if lf.kind == "analysis" else "_Written:"
    if not body or not body[0][1].startswith(stamp_word):
        probs.add(entry, name, it.line, f"{it.ref}: first line after the heading should be the `{stamp_word} …_` stamp")
    elif not STAMP_RE[lf.kind].match(body[0][1]):
        probs.add(entry, name, body[0][0], f"{it.ref}: stamp should read `{stamp_word} YYYY-MM-DD HH:MM TZ (`commit`)_`")

    for n, t in body:
        if t.startswith("_Updated:") and not UPDATED_RE.match(t):
            probs.add("error", name, n, f"{it.ref}: `_Updated:_` should read `_Updated: YYYY-MM-DD HH:MM TZ (`commit`)_`")
        if t.startswith("_Failed:") and not FAILED_RE.match(t):
            probs.add("error", name, n, f"{it.ref}: `_Failed:_` should read `_Failed: <date time TZ> (`workflow/failed/...`, <model>): <reason>_`")
        if t.startswith("**Model:**"):
            m = MODEL_RE.match(t)
            if not m:
                probs.add(entry, name, n, f"{it.ref}: `**Model:**` should read `**Model:** <model>[, reasoning <level>]`")
            elif m.group("effort") and m.group("effort") not in EFFORTS:
                probs.add(entry, name, n, f"{it.ref}: reasoning level `{m.group('effort')}` is not one of {', '.join(sorted(EFFORTS))}")

    if lf.user:
        return
    have = it.fields()
    if lf.kind == "analysis":
        need = ["fix"]
    elif it.section.prefix == "F":
        need = ["what", "why", "done when", "design docs", "how", "size"]
        if "effort" in have:
            have.add("size")
    else:
        need = ["what", "why", "design docs", "open questions"]
    if "CONFLICT" in it.tags:
        need += ["conflicts with", "why anyway"]
    missing = [k for k in need if k not in have]
    if missing:
        fields = ", ".join(f"**{k[0].upper()}{k[1:]}:**" for k in missing)
        probs.add("error", name, it.line, f"{it.ref}: missing {fields}")


def check_header(lf, probs):
    name = lf.name
    text = "\n".join(t for _, t in lf.header)
    for old in OLD_PATHS:
        if old in text:
            probs.add("warn", name, None, f"header points to the old skill path `{old}`; use the template's wording")
    for skill, now in REMOVED_SKILLS.items():
        if re.search(re.escape(skill) + r"(?![\w-])", lf.raw):
            probs.add("warn", name, None, f"names the removed skill `{skill}` (now {now})")
    if "list-format.md" not in text:
        probs.add("warn", name, None, "header doesn't point to `list-format.md` for the rules")
    if not lf.user:
        passes = [n for n, t in lf.header if t.strip() == "Passes:"]
        if not passes:
            probs.add("error", name, None, "header lacks the `Passes:` list")
        else:
            for n, t in lf.header:
                if n > passes[0] and t.startswith("- ") and not PASS_RE.match(t):
                    probs.add("warn", name, n, "pass line should start `- YYYY-MM-DD HH:MM TZ at <commit>: `")


def resolve(lists, owner, ref_file, item_id):
    """Is item_id an open item of ref_file (or, for bare plan ids, of either plan)?"""
    def ids(name):
        return {it.id for it in lists[name].items()}
    if item_id in ids(ref_file):
        return ref_file
    if lists[owner].kind == "plan" and ref_file == owner:
        other = "USER_PLAN.md" if owner == "CLAUDE_PLAN.md" else "CLAUDE_PLAN.md"
        if item_id in ids(other):
            return other
    return None


def check_references(lists, probs):
    for lf in lists.values():
        if not lf.exists:
            continue
        name = lf.name
        # Keep open for: lines in plan items.
        if lf.kind == "plan":
            for it in lf.items():
                lines, grab = [], False
                for n, t in it.body:
                    if t.strip().startswith("**Keep open for:**"):
                        grab = True
                    elif grab and (not t.strip() or FIELD_RE.match(t)):
                        grab = False
                    if grab:
                        lines.append((n, t))
                for n, t in lines:
                    t = re.sub(r'"[^"]*"|“[^”]*”', "", t)
                    for m in PLAN_REF_RE.finditer(t):
                        target = "CLAUDE_PLAN.md" if m.group("claude") else name
                        if not resolve(lists, name, target, m.group("id")):
                            probs.add("error", name, n, f"{it.ref}: **Keep open for:** names {m.group(0)}, which is not an open item", about=target)
        # Suggested-order sections.
        order = lf.section(role="order")
        if not order:
            continue
        for n, t in order.text:
            if lf.kind == "analysis":
                for m in ANALYSIS_REF_RE.finditer(t):
                    target = "USER_ANALYSIS.md" if m.group("user") else name
                    if not resolve(lists, name, target, m.group("id")):
                        probs.add("error", name, n, f"suggested order names {m.group(0)}, which is not an open item", about=target)
            else:
                for m in PLAN_REF_RE.finditer(t):
                    target = "CLAUDE_PLAN.md" if m.group("claude") else name
                    if not resolve(lists, name, target, m.group("id")):
                        probs.add("error", name, n, f"suggested order names {m.group(0)}, which is not an open item", about=target)
        if name == "CLAUDE_ANALYSIS.md":
            open_items = list(lf.items())
            content = [t for _, t in order.text if t.strip() and t.strip() != "---"]
            if not open_items and content != ["_No open items._"]:
                probs.add("error", name, order.line, "no open findings, so section 4 should be just `_No open items._`")
            elif open_items and order.no_open:
                probs.add("warn", name, order.no_open[0], "section 4 says `_No open items._` but there are open findings")
            elif open_items:
                text = "\n".join(content)
                named = {m.group("id") for m in ANALYSIS_REF_RE.finditer(text) if not m.group("user")}
                for it in open_items:
                    if it.id and it.id not in named and "HOLD" not in it.tags:
                        probs.add("warn", name, it.line, f"{it.ref} is not in section 4 (suggested order)")


def check_branches(root, lists, probs):
    out = git(root, "branch", "--list", "workflow/failed/*", "--format=%(refname:short)")
    if out is None:
        return
    branches = set(out.split()) if out else set()
    mentioned = set()
    for lf in lists.values():
        for m in BRANCH_RE.finditer(lf.raw):
            mentioned.add(m.group(0))
        for it in lf.items():
            for n, t in it.body:
                t = t.strip()
                fm = FAILED_RE.match(t)
                if fm and fm.group("branch") not in branches:
                    probs.add("error", lf.name, n, f"{it.ref}: `_Failed:_` names branch {fm.group('branch')}, which doesn't exist")
                elif not fm:
                    for m in BRANCH_RE.finditer(t):
                        if m.group(0) not in branches:
                            probs.add("warn", lf.name, n, f"{it.ref}: names branch {m.group(0)}, which doesn't exist")
    for b in sorted(branches - mentioned):
        probs.add("warn", None, None, f"branch {b} is named by no entry; if its item is done, delete it (`git branch -D {b}`)")


def section_body(lines, title):
    """Lines of the `## <title>` section (up to the next `## `)."""
    out, inside = [], False
    for n, line in enumerate(lines, 1):
        if line.startswith("## "):
            inside = line[3:].strip().lower() == title.lower()
            continue
        if inside:
            out.append((n, line))
    return out


def check_claude_md(root, probs):
    path = root / "CLAUDE.md"
    if not path.is_file():
        probs.add("warn", "CLAUDE.md", None, "missing; it should hold the `## Workflow` section")
        return
    lines = masked_lines(path.read_text(encoding="utf-8"))
    if not any(l.strip() == "## Workflow" for l in lines):
        probs.add("warn", "CLAUDE.md", None, "no `## Workflow` section")
        return
    body = section_body(lines, "Workflow")
    for sub in ("### Code scope", "### Verification"):
        if not any(t.strip() == sub for _, t in body):
            probs.add("warn", "CLAUDE.md", None, f"`## Workflow` lacks `{sub}`")
    text = "\n".join(t for _, t in body)
    for old in OLD_PATHS:
        if old in text:
            probs.add("warn", "CLAUDE.md", None, f"`## Workflow` points to the old skill path `{old}`")
    for skill, now in REMOVED_SKILLS.items():
        if re.search(re.escape(skill) + r"(?![\w-])", text):
            probs.add("warn", "CLAUDE.md", None, f"`## Workflow` names the removed skill `{skill}` (now {now})")


def check_user_workflow(root, probs):
    template = TEMPLATES / "USER_WORKFLOW.md"
    if not template.is_file():
        return
    have = masked_lines((root / "USER_WORKFLOW.md").read_text(encoding="utf-8"))
    want = masked_lines(template.read_text(encoding="utf-8"))
    headings = {l.strip() for l in have if l.startswith("#")}
    for l in want:
        if re.match(r"^#{2,3} ", l) and l.strip() not in headings:
            probs.add("warn", "USER_WORKFLOW.md", None, f"lacks the template's section `{l.strip()}`")
    runs = "\n".join(t for _, t in section_body(have, "Runs"))
    for _, t in section_body(want, "Runs"):
        m = re.match(r"^- ([^:`]+):", t)
        if m and not re.search(r"^- " + re.escape(m.group(1)) + ":", runs, re.M | re.I):
            probs.add("warn", "USER_WORKFLOW.md", None, f"`## Runs` lacks the setting `{m.group(1)}:` (runs use the default)")


def run_checks(root, files=None):
    probs = Problems()
    lists = load(root)
    for lf in lists.values():
        if not lf.exists:
            probs.add("error", lf.name, None, "missing; create it from the template")
            continue
        check_header(lf, probs)
        check_structure(lf, probs)
    check_references(lists, probs)
    check_branches(root, lists, probs)
    if not files:
        check_claude_md(root, probs)
        check_user_workflow(root, probs)
    if files:
        probs.items = [p for p in probs.items if p["file"] in files or p["about"] in files]
    return lists, probs.items


def format_problem(p):
    where = p["file"] or "git"
    if p["line"]:
        where += f":{p['line']}"
    return f"{p['level']:<5} {where}: {p['msg']}"


# --------------------------------------------------------------------------- commands


def setup_root():
    root = find_root(Path.cwd())
    if not (root / "USER_WORKFLOW.md").is_file():
        print(f"not set up: {root / 'USER_WORKFLOW.md'} is missing (run /setup-workflow)")
        sys.exit(2)
    return root


def pick_files(args):
    files = [Path(a).name for a in args]
    bad = [f for f in files if f not in LISTS]
    if bad:
        print(f"unknown list file(s): {', '.join(bad)}; expected one of {', '.join(LISTS)}")
        sys.exit(2)
    return files


def cmd_check(args):
    errors_only = "--errors-only" in args
    files = pick_files([a for a in args if not a.startswith("--")])
    root = setup_root()
    lists, found = run_checks(root, files)
    if errors_only:
        found = [p for p in found if p["level"] == "error"]
    found.sort(key=lambda p: (p["level"] != "error", LISTS.index(p["file"]) if p["file"] in LISTS else 9, p["line"] or 0))
    for p in found:
        print(format_problem(p))
    errors = sum(p["level"] == "error" for p in found)
    warnings = len(found) - errors
    open_count = sum(1 for lf in lists.values() for _ in lf.items(ideas=False))
    if not found:
        print(f"OK: no problems ({plural(open_count, 'open item')}, ideas not counted)")
    else:
        print(f"{plural(errors, 'error')}, {plural(warnings, 'warning')}")
    return 1 if errors else 0


def describe(it):
    parts = [f"L{it.line}"]
    size = it.field("size", "effort")
    if size:
        m = re.match(r"^\W*([SML])\b", size)
        if m:
            parts.append(f"size {m.group(1)}")
    model = next((t.strip()[len("**Model:**"):].strip() for _, t in it.body if t.strip().startswith("**Model:**")), None)
    if model:
        parts.append("model " + model.replace("`", "").replace(", reasoning ", " reasoning "))
    if it.field("decisions") is not None:
        parts.append("decisions")
    for _, t in it.body:
        m = FAILED_RE.match(t.strip())
        if m:
            parts.append(f"FAILED ({m.group('branch')})")
    if any(t.strip().startswith("_Updated:") for _, t in it.body):
        parts.append("updated")
    head = " ".join([it.ref, *(f"[{t}]" for t in it.tags), it.title])
    return f"  {head} — {', '.join(parts)}"


def cmd_summary(args):
    ideas = "--ideas" in args
    files = pick_files([a for a in args if not a.startswith("--")]) or LISTS
    root = setup_root()
    lists = load(root)
    total_open = total_held = total_ideas = 0
    for name in files:
        lf = lists[name]
        if not lf.exists:
            print(f"{name}: missing")
            continue
        work = list(lf.items(ideas=False))
        idea_items = [it for it in lf.items() if it.section.prefix == "I"]
        held = [it for it in work if "HOLD" in it.tags]
        total_open += len(work) - len(held)
        total_held += len(held)
        total_ideas += len(idea_items)
        head = f"{name}: {len(work) - len(held)} open"
        if held:
            head += f", {len(held)} on hold"
        if lf.kind == "plan":
            head += f", {plural(len(idea_items), 'idea')} (backlog)"
        print(head)
        for it in work:
            print(describe(it))
        if ideas:
            for it in idea_items:
                print(describe(it))
    print(f"TOTAL: {total_open} open, {total_held} on hold, {plural(total_ideas, 'idea')}")
    return 0


def cmd_stamp(_args):
    root = find_root(Path.cwd())
    commit = git(root, "rev-parse", "--short", "HEAD") or "no commit"
    print(f"{time.strftime('%Y-%m-%d %H:%M %Z')} (`{commit}`)")
    return 0


def cmd_hook(_args):
    try:
        data = json.load(sys.stdin)
    except (ValueError, OSError):
        return 0
    path = (data.get("tool_input") or {}).get("file_path")
    if not path:
        return 0
    path = Path(path)
    if not path.is_absolute():
        path = Path(data.get("cwd") or Path.cwd()) / path
    name, root = path.name, path.resolve().parent
    if name not in LISTS or not (root / "USER_WORKFLOW.md").is_file():
        return 0
    _, found = run_checks(root, [name])
    errors = [p for p in found if p["level"] == "error"]
    if not errors:
        return 0
    print(
        f"workflow-lists: {name} breaks the list rules after this edit "
        "(see list-format.md; if you are mid-change, finish it, then run `workflow-lists check`):",
        file=sys.stderr,
    )
    for p in errors:
        print("  " + format_problem(p), file=sys.stderr)
    return 2


COMMANDS = {"check": cmd_check, "summary": cmd_summary, "stamp": cmd_stamp, "hook": cmd_hook}


def main(argv):
    if len(argv) < 2 or argv[1] not in COMMANDS:
        print(__doc__.strip())
        return 2
    return COMMANDS[argv[1]](argv[2:])


if __name__ == "__main__":
    sys.exit(main(sys.argv))
