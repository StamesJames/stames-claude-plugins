#!/usr/bin/env python3
"""workflow-lists: mechanical checks and summaries for the dev-workflow list files.

Run from the target project (any directory inside its git repo):

  workflow-lists check [--errors-only] [FILE...]   validate lists, CLAUDE.md, USER_WORKFLOW.md
  workflow-lists summary [--ideas] [FILE...]       one line per open item
  workflow-lists show ID...                        print the entries with these ids
  workflow-lists section FILE HEADING...           print these `## ` sections of FILE
  workflow-lists stamp                             value for _Found:_ / _Written:_ stamps
  workflow-lists delete ID... [--to ID] [--dropped REASON]
                                                   delete entries with their mentions and branches
  workflow-lists set ID decisions TEXT | model SPEC|none | hold | unhold
                        | failed BRANCH|none MODEL REASON | updated
                                                   change one line of an entry
  workflow-lists add FILE --title T [--section N] [--sev S] [--model M] [--before ID] < body
                                                   add an entry with the next id and a stamp
  workflow-lists move ID FILE [--note TEXT]        move an idea to the other idea file
  workflow-lists pass FILE TEXT                    add a stamped line to the Passes list
  workflow-lists find [--since COMMIT] [--show] [PATH...]
                                                   analysis entries citing these files
  workflow-lists triage LIST... [--skip IDS] [--only IDS]
                                                   work order and mechanical triage for a run
  workflow-lists hook                              PostToolUse hook (reads hook JSON on stdin)

The rules checked here are the mechanical part of
skills/setup-workflow/list-format.md; keep both in sync.
Exit codes: 0 fine (warnings allowed), 1 errors found (show / section: an id or
heading not found), 2 not set up or bad usage.
Standard library only.
"""

import json
import re
import subprocess
import sys
import time
from pathlib import Path

LISTS = ["CLAUDE_ANALYSIS.md", "USER_ANALYSIS.md", "CLAUDE_PLAN.md", "USER_IDEAS.md", "CLAUDE_IDEAS.md"]
KIND = {
    "CLAUDE_ANALYSIS.md": "analysis",
    "USER_ANALYSIS.md": "analysis",
    "CLAUDE_PLAN.md": "plan",
    "USER_IDEAS.md": "ideas",
    "CLAUDE_IDEAS.md": "ideas",
}
USER_FILES = {"USER_ANALYSIS.md", "USER_IDEAS.md"}
# The user's ideas need only a heading: no id, severity or stamp required.
MINIMAL_FILES = {"USER_IDEAS.md"}
OLD_PLAN = "USER_PLAN.md"  # replaced in plugin version 3 (setup-workflow -> C)
# How ids are written outside the files (list-format.md -> "Ids outside the files").
REF_PREFIX = {
    "CLAUDE_ANALYSIS.md": "",
    "USER_ANALYSIS.md": "U",
    "CLAUDE_PLAN.md": "",
    "USER_IDEAS.md": "",
    "CLAUDE_IDEAS.md": "claude:",
}
ANALYSIS_SECTIONS = {
    1: "Bugs",
    2: "Performance",
    3: "Cleanliness / architecture",
    4: "Suggested order of work",
}
SEVERITIES = {"H", "M", "L"}
TAGS = SEVERITIES | {"HOLD", "CONFLICT"}
EFFORTS = {"low", "medium", "high", "xhigh"}
OLD_PATHS = [".claude/skills/", "~/.claude/skills"]
REMOVED_SKILLS = {
    "/fix-next-user-finding": "`/fix-next-finding user-only`",
    "/fix-all-user-findings": "`/fix-all-findings user-only`",
    "/implement-all-claude-features": "`/implement-all-features`, which works off CLAUDE_PLAN.md",
    "/explore-feature": "`/plan-features <idea or wish>`",
}
TEMPLATES = Path(__file__).resolve().parent.parent / "skills" / "setup-workflow" / "templates"

DATE = r"\d{4}-\d{2}-\d{2} \d{2}:\d{2} [A-Za-z0-9+:-]+"
COMMIT = r"`?(?:[0-9a-f]{4,40}|no commit)`?"
STAMP_RE = {
    "analysis": re.compile(rf"^_Found: {DATE} \({COMMIT}\)_$"),
    "plan": re.compile(rf"^_Written: {DATE} \({COMMIT}\)_$"),
    "ideas": re.compile(rf"^_Written: {DATE} \({COMMIT}\)_$"),
}
UPDATED_RE = re.compile(rf"^_Updated: {DATE} \({COMMIT}\)_$")
FAILED_RE = re.compile(
    rf"^_Failed: {DATE} \((?:`?(?P<branch>workflow/failed/[^`,\s]+)`?|no changes), (?P<model>[^)]+)\): (?P<reason>.+)_$"
)
MODEL_RE = re.compile(r"^\*\*Model:\*\* `?[\w.:-]+`?(?:, reasoning (?P<effort>\w+))?\s*$")
NEXT_ID_RE = re.compile(r"^_Next id: (?P<id>\S+?)_\s*$")
HEADING_RE = re.compile(r"^###\s+(?P<rest>.*)$")
ID_RE = re.compile(r"^(?P<id>(?:\d+\.\d+|[FI]\d+))\b\s*(?P<rest>.*)$")
FIELD_RE = re.compile(r"^\s*(?:[-*]\s+)?\*\*(?P<key>[^*]+?):?\*\*:?")
BRANCH_RE = re.compile(r"workflow/failed/[\w./-]*[\w-]")
PASS_RE = re.compile(rf"^- {DATE} at {COMMIT}: .+")
DROPPED_RE = re.compile(r"^- (?P<id>[FI]\d+) .+ — .+ \(\d{4}-\d{2}-\d{2}[^)]*\)\.?$")
PLAN_REF_RE = re.compile(r"(?<![\w:])(?P<claude>claude:)?(?P<id>[FI]\d+)\b")
ANALYSIS_REF_RE = re.compile(r"\*\*(?P<user>U)?(?P<id>\d+\.\d+)\*\*")
PLAN_BOLD_REF_RE = re.compile(r"\*\*(?P<claude>claude:)?(?P<id>[FI]\d+)\*\*")


# --------------------------------------------------------------------------- helpers


def git(root, *args):
    try:
        out = subprocess.run(
            ["git", *args], cwd=root, capture_output=True, text=True, check=True
        )
    except (OSError, subprocess.CalledProcessError):
        return None
    return out.stdout.strip()


def find_root(start):
    top = git(start, "rev-parse", "--show-toplevel")
    return Path(top) if top else Path(start).resolve()


def masked_lines(text):
    """Lines with HTML comments and fenced code blanked out, line numbers preserved."""
    text = re.sub(r"<!--.*?-->", lambda m: "\n" * m.group().count("\n"), text, flags=re.S)
    lines, fenced = [], False
    for line in text.split("\n"):
        if line.lstrip().startswith("```"):
            fenced = not fenced
            lines.append("")
        else:
            lines.append("" if fenced else line)
    return lines


def slug(title):
    words = re.findall(r"[a-z0-9]+", title.lower())[:5]
    return "-".join(words) or "untitled"


def plural(n, word):
    return f"{n} {word}" + ("" if n == 1 else "s")


class Problems:
    def __init__(self):
        self.items = []

    def add(self, level, file, line, msg, about=None):
        self.items.append(
            {"level": level, "file": file, "line": line, "msg": msg, "about": about or file}
        )


# --------------------------------------------------------------------------- parsing


class Section:
    def __init__(self, title, line):
        self.title = title
        self.line = line
        self.role = "other"  # items | order | dropped | other
        self.number = None  # analysis section number
        self.prefix = None  # expected id prefix ("1." / "F" / "I")
        self.next_ids = []  # (line, value)
        self.no_open = []  # line numbers of "_No open items._" / "_None yet._"
        self.items = []
        self.text = []  # (line, text) of section-level lines


class Item:
    def __init__(self, file, section, line, heading):
        self.file = file
        self.section = section
        self.line = line
        self.heading = heading
        self.id = None
        self.tags = []
        self.title = ""
        self.body = []  # (line, text)

    @property
    def ref(self):
        if self.id is None:
            return slug(self.title)
        return REF_PREFIX[self.file] + self.id

    @property
    def severity(self):
        return self.tags[0] if self.tags and self.tags[0] in SEVERITIES else None

    def field(self, *keys):
        for _, text in self.body:
            m = FIELD_RE.match(text)
            if m and m.group("key").strip().lower() in keys:
                return text[m.end():].strip()
        return None

    def fields(self):
        keys = set()
        for _, text in self.body:
            m = FIELD_RE.match(text)
            if m:
                keys.add(m.group("key").strip().lower())
        return keys


class ListFile:
    def __init__(self, root, name):
        self.name = name
        self.kind = KIND[name]
        self.user = name in USER_FILES
        self.minimal = name in MINIMAL_FILES
        self.path = root / name
        self.exists = self.path.is_file()
        self.raw = self.path.read_text(encoding="utf-8") if self.exists else ""
        self.lines = masked_lines(self.raw)
        self.header = []  # (line, text) before the first "## "
        self.sections = []
        self.stray = []  # items before any section
        if self.exists:
            self._parse()

    def _parse(self):
        section = item = None
        for n, line in enumerate(self.lines, 1):
            if line.startswith("## "):
                section, item = Section(line[3:].strip(), n), None
                self._classify(section)
                self.sections.append(section)
                continue
            m = HEADING_RE.match(line)
            if m:
                item = Item(self.name, section, n, m.group("rest").strip())
                self._parse_heading(item)
                (section.items if section else self.stray).append(item)
                continue
            if item is not None:
                item.body.append((n, line))
            elif section is not None:
                section.text.append((n, line))
                if NEXT_ID_RE.match(line.strip()):
                    section.next_ids.append((n, NEXT_ID_RE.match(line.strip()).group("id")))
                elif line.strip() in ("_No open items._", "_None yet._"):
                    section.no_open.append(n)
            else:
                self.header.append((n, line))

    def _classify(self, section):
        title = section.title
        if self.kind == "analysis":
            m = re.match(r"^(\d+)\.\s*(.*)$", title)
            if m:
                section.number = int(m.group(1))
                if section.number in (1, 2, 3):
                    section.role, section.prefix = "items", f"{section.number}."
                elif section.number == 4:
                    section.role = "order"
        else:
            low = title.lower()
            if self.kind == "plan" and low == "concrete features":
                section.role, section.prefix = "items", "F"
            elif self.kind == "ideas" and low == "ideas":
                section.role, section.prefix = "items", "I"
            elif self.kind == "ideas" and low == "dropped":
                section.role = "dropped"
            elif "order" in low:
                section.role = "order"

    @staticmethod
    def _parse_heading(item):
        rest = item.heading
        m = ID_RE.match(rest)
        if m:
            item.id, rest = m.group("id"), m.group("rest")
        while True:
            t = re.match(r"^\[([A-Za-z]+)\]\s*", rest)
            if not t:
                break
            item.tags.append(t.group(1).upper() if t.group(1).upper() in TAGS else t.group(1))
            rest = rest[t.end():]
        item.title = rest.strip()

    def items(self, ideas=True):
        for s in self.sections:
            if s.role == "items" and (ideas or s.prefix != "I"):
                yield from s.items

    def section(self, role=None, prefix=None, number=None):
        for s in self.sections:
            if (role is None or s.role == role) and (prefix is None or s.prefix == prefix) and (
                number is None or s.number == number
            ):
                return s
        return None


def load(root):
    return {name: ListFile(root, name) for name in LISTS}


# --------------------------------------------------------------------------- checks


def id_number(item_id):
    return int(re.search(r"(\d+)$", item_id).group(1))


def check_structure(lf, probs):
    name = lf.name
    entry = "warn" if lf.user else "error"
    for it in lf.stray:
        probs.add("error", name, it.line, f"item `{it.heading}` sits before any `## ` section")

    if lf.kind == "analysis":
        for num, title in ANALYSIS_SECTIONS.items():
            if not lf.section(number=num):
                probs.add("error", name, None, f"missing section `## {num}. {title}`")
    elif lf.kind == "plan":
        if not lf.section(prefix="F"):
            probs.add("error", name, None, "missing section `## Concrete features`")
    else:
        if not lf.section(prefix="I"):
            probs.add("error", name, None, "missing section `## Ideas`")
        if not lf.user and not lf.section(role="dropped"):
            probs.add("error", name, None, "missing section `## Dropped`")
    if not lf.user:
        for s in lf.sections:
            if s.role != "other":
                continue
            if lf.kind == "plan" and s.title.lower() in ("ideas", "dropped"):
                probs.add("warn", name, s.line, f"`## {s.title}` is from the old plan layout (Claude's ideas now live in CLAUDE_IDEAS.md); run /setup-workflow check to migrate")
            else:
                probs.add("warn", name, s.line, f"unexpected section `## {s.title}`")

    seen = {}
    for s in lf.sections:
        if s.role != "items":
            continue
        next_val = None
        if not s.next_ids:
            probs.add("error", name, s.line, f"section `{s.title}` has no `_Next id:_` line")
        elif len(s.next_ids) > 1:
            probs.add("error", name, s.next_ids[1][0], f"section `{s.title}` has several `_Next id:_` lines")
        if s.next_ids:
            line, val = s.next_ids[0]
            if not re.fullmatch(re.escape(s.prefix) + r"\d+", val):
                probs.add("error", name, line, f"`_Next id: {val}_` should look like `{s.prefix}<n>`")
            else:
                next_val = id_number(val)
        if s.items and s.no_open:
            probs.add("error", name, s.no_open[0], f"`_No open items._` in `{s.title}`, which has items")
        if not s.items and not s.no_open:
            probs.add("error", name, s.line, f"empty section `{s.title}` lacks its `_No open items._` line")

        for it in s.items:
            for line, text in it.body:
                if NEXT_ID_RE.match(text.strip()):
                    probs.add("error", name, line, "`_Next id:_` must come before the first item of its section")
            if it.id is None:
                if not lf.minimal:
                    probs.add(entry, name, it.line, f"heading `{it.heading}` has no id")
            else:
                if not re.fullmatch(re.escape(s.prefix) + r"\d+", it.id):
                    probs.add(entry, name, it.line, f"id {it.id} doesn't belong in `{s.title}` (expected `{s.prefix}<n>`)")
                elif next_val is not None and id_number(it.id) >= next_val:
                    probs.add("error", name, it.line, f"id {it.id} is not below `_Next id: {s.next_ids[0][1]}_` (count the next id up)")
                if it.id in seen:
                    probs.add("error", name, it.line, f"duplicate id {it.id} (also line {seen[it.id]}); ids are never reused")
                else:
                    seen[it.id] = it.line
            check_entry(lf, it, probs)

    dropped = lf.section(role="dropped")
    if dropped:
        entries = [(n, t.strip()) for n, t in dropped.text if t.strip().startswith("- ")]
        if entries and dropped.no_open:
            probs.add("error", name, dropped.no_open[0], "`_None yet._` in `Dropped`, which has entries")
        for n, t in entries:
            m = DROPPED_RE.match(t)
            if not m:
                probs.add("warn", name, n, "dropped line should read `- <id> <name> — <reason> (<date>)`")
            elif m.group("id") in seen:
                probs.add("error", name, n, f"dropped id {m.group('id')} is also an open item (line {seen[m.group('id')]}); ids are never reused")


def check_entry(lf, it, probs):
    name = lf.name
    entry = "warn" if lf.user else "error"
    if it.severity is None and not lf.minimal:  # optional in the user's ideas
        probs.add(entry, name, it.line, f"{it.ref}: severity [H], [M] or [L] should follow the id")
    for tag in it.tags:
        if tag not in TAGS:
            probs.add("warn", name, it.line, f"{it.ref}: unknown tag [{tag}]")
    if sum(tag in SEVERITIES for tag in it.tags) > 1:
        probs.add(entry, name, it.line, f"{it.ref}: several severities")
    if "CONFLICT" in it.tags and lf.kind == "analysis":
        probs.add("warn", name, it.line, f"{it.ref}: [CONFLICT] is only used in plan and idea files")

    body = [(n, t.strip()) for n, t in it.body if t.strip()]
    stamp_word = "_Found:" if lf.kind == "analysis" else "_Written:"
    if not body or not body[0][1].startswith(stamp_word):
        if not lf.minimal:  # optional in the user's ideas
            probs.add(entry, name, it.line, f"{it.ref}: first line after the heading should be the `{stamp_word} …_` stamp")
    elif not STAMP_RE[lf.kind].match(body[0][1]):
        probs.add(entry, name, body[0][0], f"{it.ref}: stamp should read `{stamp_word} YYYY-MM-DD HH:MM TZ (`commit`)_`")

    for n, t in body:
        if t.startswith("_Updated:") and not UPDATED_RE.match(t):
            probs.add("error", name, n, f"{it.ref}: `_Updated:_` should read `_Updated: YYYY-MM-DD HH:MM TZ (`commit`)_`")
        if t.startswith("_Failed:") and not FAILED_RE.match(t):
            probs.add("error", name, n, f"{it.ref}: `_Failed:_` should read `_Failed: <date time TZ> (`workflow/failed/...` or no changes, <model>): <reason>_`")
        if t.startswith("**Model:**"):
            m = MODEL_RE.match(t)
            if not m:
                probs.add(entry, name, n, f"{it.ref}: `**Model:**` should read `**Model:** <model>[, reasoning <level>]`")
            elif m.group("effort") and m.group("effort") not in EFFORTS:
                probs.add(entry, name, n, f"{it.ref}: reasoning level `{m.group('effort')}` is not one of {', '.join(sorted(EFFORTS))}")

    if lf.user:
        return
    have = it.fields()
    if lf.kind == "analysis":
        need = ["fix"]
    elif lf.kind == "plan":
        need = ["what", "why", "done when", "design docs", "how", "size"]
        if "effort" in have:
            have.add("size")
    else:
        need = ["what", "why", "design docs", "open questions"]
    if "CONFLICT" in it.tags:
        need += ["conflicts with", "why anyway"]
    missing = [k for k in need if k not in have]
    if missing:
        fields = ", ".join(f"**{k[0].upper()}{k[1:]}:**" for k in missing)
        probs.add("error", name, it.line, f"{it.ref}: missing {fields}")


def check_header(lf, probs):
    name = lf.name
    text = "\n".join(t for _, t in lf.header)
    for old in OLD_PATHS:
        if old in text:
            probs.add("warn", name, None, f"header points to the old skill path `{old}`; use the template's wording")
    for skill, now in REMOVED_SKILLS.items():
        if re.search(re.escape(skill) + r"(?![\w-])", lf.raw):
            probs.add("warn", name, None, f"names the removed skill `{skill}` (now {now})")
    if "list-format.md" not in text:
        probs.add("warn", name, None, "header doesn't point to `list-format.md` for the rules")
    if not lf.user:
        passes = [n for n, t in lf.header if t.strip() == "Passes:"]
        if not passes:
            probs.add("error", name, None, "header lacks the `Passes:` list")
        else:
            for n, t in lf.header:
                if n > passes[0] and t.startswith("- ") and not PASS_RE.match(t):
                    probs.add("warn", name, n, "pass line should start `- YYYY-MM-DD HH:MM TZ at <commit>: `")


def resolve(lists, ref_file, item_id):
    """Is item_id an open item of ref_file?"""
    return item_id in {it.id for it in lists[ref_file].items()}


def plan_ref_file(m):
    """The file a PLAN_REF_RE match points to: F -> the plan, I -> the user's ideas,
    claude:I -> Claude's ideas (claude:F is left over from the old layout and resolves nowhere)."""
    if m.group("claude"):
        return "CLAUDE_IDEAS.md"
    return "CLAUDE_PLAN.md" if m.group("id").startswith("F") else "USER_IDEAS.md"


def check_references(lists, probs):
    for lf in lists.values():
        if not lf.exists:
            continue
        name = lf.name
        # Keep open for: lines in plan and idea items.
        if lf.kind != "analysis":
            for it in lf.items():
                lines, grab = [], False
                for n, t in it.body:
                    if t.strip().startswith("**Keep open for:**"):
                        grab = True
                    elif grab and (not t.strip() or FIELD_RE.match(t)):
                        grab = False
                    if grab:
                        lines.append((n, t))
                for n, t in lines:
                    t = re.sub(r'"[^"]*"|“[^”]*”', "", t)
                    for m in PLAN_REF_RE.finditer(t):
                        target = plan_ref_file(m)
                        if not resolve(lists, target, m.group("id")):
                            probs.add("error", name, n, f"{it.ref}: **Keep open for:** names {m.group(0)}, which is not an open item", about=target)
        # Suggested-order sections.
        order = lf.section(role="order")
        if not order:
            continue
        for n, t in order.text:
            if lf.kind == "analysis":
                for m in ANALYSIS_REF_RE.finditer(t):
                    target = "USER_ANALYSIS.md" if m.group("user") else name
                    if not resolve(lists, target, m.group("id")):
                        probs.add("error", name, n, f"suggested order names {m.group(0)}, which is not an open item", about=target)
            else:
                for m in PLAN_BOLD_REF_RE.finditer(t):
                    target = plan_ref_file(m)
                    if not resolve(lists, target, m.group("id")):
                        probs.add("error", name, n, f"suggested order names {m.group(0)}, which is not an open item", about=target)
        if name == "CLAUDE_ANALYSIS.md":
            open_items = list(lf.items())
            content = [t for _, t in order.text if t.strip() and t.strip() != "---"]
            if not open_items and content != ["_No open items._"]:
                probs.add("error", name, order.line, "no open findings, so section 4 should be just `_No open items._`")
            elif open_items and order.no_open:
                probs.add("warn", name, order.no_open[0], "section 4 says `_No open items._` but there are open findings")
            elif open_items:
                text = "\n".join(content)
                named = {m.group("id") for m in ANALYSIS_REF_RE.finditer(text) if not m.group("user")}
                for it in open_items:
                    if it.id and it.id not in named and "HOLD" not in it.tags:
                        probs.add("warn", name, it.line, f"{it.ref} is not in section 4 (suggested order)")


def check_branches(root, lists, probs):
    out = git(root, "branch", "--list", "workflow/failed/*", "--format=%(refname:short)")
    if out is None:
        return
    branches = set(out.split()) if out else set()
    mentioned = set()
    for lf in lists.values():
        for m in BRANCH_RE.finditer(lf.raw):
            mentioned.add(m.group(0))
        for it in lf.items():
            for n, t in it.body:
                t = t.strip()
                fm = FAILED_RE.match(t)
                if fm and fm.group("branch") and fm.group("branch") not in branches:
                    probs.add("error", lf.name, n, f"{it.ref}: `_Failed:_` names branch {fm.group('branch')}, which doesn't exist")
                elif not fm:
                    for m in BRANCH_RE.finditer(t):
                        if m.group(0) not in branches:
                            probs.add("warn", lf.name, n, f"{it.ref}: names branch {m.group(0)}, which doesn't exist")
    for b in sorted(branches - mentioned):
        probs.add("warn", None, None, f"branch {b} is named by no entry; if its item is done, delete it (`git branch -D {b}`)")


def section_body(lines, title):
    """Lines of the `## <title>` section (up to the next `## `)."""
    out, inside = [], False
    for n, line in enumerate(lines, 1):
        if line.startswith("## "):
            inside = line[3:].strip().lower() == title.lower()
            continue
        if inside:
            out.append((n, line))
    return out


def check_claude_md(root, probs):
    path = root / "CLAUDE.md"
    if not path.is_file():
        probs.add("warn", "CLAUDE.md", None, "missing; it should hold the `## Workflow` section")
        return
    lines = masked_lines(path.read_text(encoding="utf-8"))
    if not any(l.strip() == "## Workflow" for l in lines):
        probs.add("warn", "CLAUDE.md", None, "no `## Workflow` section")
        return
    body = section_body(lines, "Workflow")
    for sub in ("### Code scope", "### Verification"):
        if not any(t.strip() == sub for _, t in body):
            probs.add("warn", "CLAUDE.md", None, f"`## Workflow` lacks `{sub}`")
    text = "\n".join(t for _, t in body)
    for old in OLD_PATHS:
        if old in text:
            probs.add("warn", "CLAUDE.md", None, f"`## Workflow` points to the old skill path `{old}`")
    for skill, now in REMOVED_SKILLS.items():
        if re.search(re.escape(skill) + r"(?![\w-])", text):
            probs.add("warn", "CLAUDE.md", None, f"`## Workflow` names the removed skill `{skill}` (now {now})")


def check_user_workflow(root, probs):
    template = TEMPLATES / "USER_WORKFLOW.md"
    if not template.is_file():
        return
    have = masked_lines((root / "USER_WORKFLOW.md").read_text(encoding="utf-8"))
    want = masked_lines(template.read_text(encoding="utf-8"))
    headings = {l.strip() for l in have if l.startswith("#")}
    for l in want:
        if re.match(r"^#{2,3} ", l) and l.strip() not in headings:
            probs.add("warn", "USER_WORKFLOW.md", None, f"lacks the template's section `{l.strip()}`")
    runs = "\n".join(t for _, t in section_body(have, "Runs"))
    for _, t in section_body(want, "Runs"):
        m = re.match(r"^- ([^:`]+):", t)
        if m and not re.search(r"^- " + re.escape(m.group(1)) + ":", runs, re.M | re.I):
            probs.add("warn", "USER_WORKFLOW.md", None, f"`## Runs` lacks the setting `{m.group(1)}:` (runs use the default)")


def run_checks(root, files=None):
    probs = Problems()
    lists = load(root)
    old_layout = (root / OLD_PLAN).is_file()
    if old_layout:
        probs.add("warn", OLD_PLAN, None, "old plan layout: USER_PLAN.md is replaced by USER_IDEAS.md (ideas) and CLAUDE_PLAN.md (concrete features); run /setup-workflow check to migrate", about=None)
    for lf in lists.values():
        if not lf.exists:
            fix = "migrate the old plan layout with /setup-workflow check" if old_layout else "create it from the template"
            probs.add("error", lf.name, None, f"missing; {fix}")
            continue
        check_header(lf, probs)
        check_structure(lf, probs)
    check_references(lists, probs)
    check_branches(root, lists, probs)
    if not files:
        check_claude_md(root, probs)
        check_user_workflow(root, probs)
    if files:
        probs.items = [p for p in probs.items if p["file"] in files or p["about"] in files]
    return lists, probs.items


def format_problem(p):
    where = p["file"] or "git"
    if p["line"]:
        where += f":{p['line']}"
    return f"{p['level']:<5} {where}: {p['msg']}"


# --------------------------------------------------------------------------- commands


def setup_root():
    root = find_root(Path.cwd())
    if not (root / "USER_WORKFLOW.md").is_file():
        print(f"not set up: {root / 'USER_WORKFLOW.md'} is missing (run /setup-workflow)")
        sys.exit(2)
    return root


def pick_files(args):
    files = [Path(a).name for a in args]
    bad = [f for f in files if f not in LISTS]
    if bad:
        print(f"unknown list file(s): {', '.join(bad)}; expected one of {', '.join(LISTS)}")
        sys.exit(2)
    return files


def cmd_check(args):
    errors_only = "--errors-only" in args
    files = pick_files([a for a in args if not a.startswith("--")])
    root = setup_root()
    lists, found = run_checks(root, files)
    if errors_only:
        found = [p for p in found if p["level"] == "error"]
    found.sort(key=lambda p: (p["level"] != "error", LISTS.index(p["file"]) if p["file"] in LISTS else 9, p["line"] or 0))
    for p in found:
        print(format_problem(p))
    errors = sum(p["level"] == "error" for p in found)
    warnings = len(found) - errors
    work = [it for name, lf in lists.items() if not files or name in files for it in lf.items(ideas=False)]
    held = sum("HOLD" in it.tags for it in work)
    if not found:
        print(f"OK: no problems ({len(work) - held} open, {held} on hold, ideas not counted)")
    else:
        print(f"{plural(errors, 'error')}, {plural(warnings, 'warning')}")
    return 1 if errors else 0


def describe(it):
    parts = [f"L{it.line}"]
    size = it.field("size", "effort")
    if size:
        m = re.match(r"^\W*([SML])\b", size)
        if m:
            parts.append(f"size {m.group(1)}")
    model = next((t.strip()[len("**Model:**"):].strip() for _, t in it.body if t.strip().startswith("**Model:**")), None)
    if model:
        parts.append("model " + model.replace("`", "").replace(", reasoning ", " reasoning "))
    if it.field("decisions") is not None:
        parts.append("decisions")
    for _, t in it.body:
        m = FAILED_RE.match(t.strip())
        if m:
            parts.append(f"FAILED ({m.group('branch') or 'no changes'})")
    if any(t.strip().startswith("_Updated:") for _, t in it.body):
        parts.append("updated")
    head = " ".join([it.ref, *(f"[{t}]" for t in it.tags), it.title])
    return f"  {head} — {', '.join(parts)}"


def cmd_summary(args):
    ideas = "--ideas" in args
    files = pick_files([a for a in args if not a.startswith("--")]) or LISTS
    root = setup_root()
    lists = load(root)
    total_open = total_held = total_ideas = 0
    for name in files:
        lf = lists[name]
        if not lf.exists:
            print(f"{name}: missing")
            continue
        work = list(lf.items(ideas=False))
        idea_items = [it for it in lf.items() if it.section.prefix == "I"]
        held = [it for it in work if "HOLD" in it.tags]
        total_open += len(work) - len(held)
        total_held += len(held)
        total_ideas += len(idea_items)
        if lf.kind == "ideas":
            held_ideas = sum("HOLD" in it.tags for it in idea_items)
            head = f"{name}: {plural(len(idea_items), 'idea')} (backlog)"
            if held_ideas:
                head += f", {held_ideas} on hold"
        else:
            head = f"{name}: {len(work) - len(held)} open"
            if held:
                head += f", {len(held)} on hold"
        print(head)
        for it in work:
            print(describe(it))
        if ideas:
            for it in idea_items:
                print(describe(it))
    print(f"TOTAL: {total_open} open, {total_held} on hold, {plural(total_ideas, 'idea')}")
    return 0


def trim(lines):
    """Drop trailing blank lines and `---` separators."""
    while lines and lines[-1].strip() in ("", "---"):
        lines.pop()
    return lines


def cmd_show(args):
    if not args:
        print("usage: workflow-lists show ID...")
        return 2
    root = setup_root()
    lists = load(root)
    refs = index(lists)
    missing = 0
    for ref in args:
        hit = refs.get(ref)
        if not hit:
            print(f"not found: {ref} (no open entry with this id)")
            missing += 1
            continue
        lf, it = hit
        a, b = entry_span(lf, it)
        print(f"==> {lf.name}:{it.line}")
        print("\n".join(lf.raw.split("\n")[a:b]))
    return 1 if missing else 0


def cmd_section(args):
    if len(args) < 2:
        print("usage: workflow-lists section FILE HEADING...")
        return 2
    path = Path(args[0])
    if not path.is_absolute():
        path = find_root(Path.cwd()) / path
    if not path.is_file():
        print(f"missing: {path}")
        return 2
    raw = path.read_text(encoding="utf-8").split("\n")
    masked = masked_lines("\n".join(raw))
    starts = [n for n, line in enumerate(masked) if re.match(r"^#{1,2} ", line)] + [len(raw)]
    missing = 0
    for want in args[1:]:
        want_low = want.lower().lstrip("# ").strip()
        hit = next((i for i, n in enumerate(starts[:-1])
                    if masked[n].startswith("## ") and masked[n][3:].strip().lower().startswith(want_low)), None)
        if hit is None:
            print(f"not found: ## {want}")
            missing += 1
            continue
        print("\n".join(trim(raw[starts[hit]:starts[hit + 1]])))
        print()
    return 1 if missing else 0


def cmd_stamp(_args):
    root = find_root(Path.cwd())
    commit = git(root, "rev-parse", "--short", "HEAD") or "no commit"
    print(f"{time.strftime('%Y-%m-%d %H:%M %Z')} (`{commit}`)")
    return 0


def cmd_hook(_args):
    try:
        data = json.load(sys.stdin)
    except (ValueError, OSError):
        return 0
    path = (data.get("tool_input") or {}).get("file_path")
    if not path:
        return 0
    path = Path(path)
    if not path.is_absolute():
        path = Path(data.get("cwd") or Path.cwd()) / path
    name, root = path.name, path.resolve().parent
    if name not in LISTS or not (root / "USER_WORKFLOW.md").is_file():
        return 0
    _, found = run_checks(root, [name])
    errors = [p for p in found if p["level"] == "error"]
    if not errors:
        return 0
    print(
        f"workflow-lists: {name} breaks the list rules after this edit "
        "(see list-format.md; if you are mid-change, finish it, then run `workflow-lists check`):",
        file=sys.stderr,
    )
    for p in errors:
        print("  " + format_problem(p), file=sys.stderr)
    return 2


# --------------------------------------------------------------------------- editing

FOOTER_KIND = {"CLAUDE_ANALYSIS.md": "analysis", "USER_ANALYSIS.md": "user analysis", "CLAUDE_PLAN.md": "plan"}
# A suggested-order bullet: `- **1.1** + **3.2**: why` (also `1.`, `,`, `and`, `together with`).
JOINER = r"\s*(?:\+|,|&|and|together with)\s*"
ORDER_LINE_RE = re.compile(
    rf"^(?P<lead>\s*(?:[-*]|\d+\.)\s+)(?P<refs>\*\*[^*\s]+\*\*(?:{JOINER}\*\*[^*\s]+\*\*)*)(?P<rest>.*)$"
)
BOLD_RE = re.compile(r"\*\*([^*\s]+)\*\*")
KEEP_OPEN = "**Keep open for:**"


def now_stamp(root):
    """(date time TZ, short commit) for stamps written now."""
    return time.strftime("%Y-%m-%d %H:%M %Z"), git(root, "rev-parse", "--short", "HEAD") or "no commit"


def index(lists):
    """ref as used outside the files -> (ListFile, Item)."""
    refs = {}
    for lf in lists.values():
        for s in lf.sections:
            for it in s.items:
                refs.setdefault(it.ref, (lf, it))
    return refs


def entry_span(lf, it):
    """0-based [start, end) of an entry's lines, without trailing blank and `---` lines."""
    raw = lf.raw.split("\n")
    end = len(raw)
    for k in range(it.line, len(lf.lines)):
        if lf.lines[k].startswith("## ") or HEADING_RE.match(lf.lines[k]):
            end = k
            break
    start = it.line - 1
    while end - 1 > start and raw[end - 1].strip() in ("", "---"):
        end -= 1
    return start, end


def section_span(lf, section):
    """0-based [start, end) of a section's body (after its heading, up to the next `## `)."""
    start = section.line
    end = next((k for k in range(start, len(lf.lines)) if lf.lines[k].startswith("## ")), len(lf.lines))
    return start, end


def save(lf, raw):
    lf.path.write_text("\n".join(raw), encoding="utf-8")


def collapse_blanks(raw, i):
    """Leave at most one blank line where lines were removed at index i."""
    while 0 < i < len(raw) and not raw[i - 1].strip() and not raw[i].strip():
        del raw[i]


def split_top(value):
    """Split at commas outside parentheses and quotes."""
    parts, cur, depth, quote = [], "", 0, None
    for ch in value:
        if quote:
            quote = None if ch == quote else quote
        elif ch in "\"“":
            quote = '"' if ch == '"' else "”"
        elif ch == "(":
            depth += 1
        elif ch == ")":
            depth = max(0, depth - 1)
        elif ch == "," and depth == 0:
            parts.append(cur.strip())
            cur = ""
            continue
        cur += ch
    if cur.strip():
        parts.append(cur.strip())
    return parts


def wrap(text, width=95, indent=""):
    import textwrap
    return textwrap.wrap(text, width=width, subsequent_indent=indent,
                         break_on_hyphens=False, break_long_words=False) or [text]


def edit_order(lf, tokens, new=None):
    """Remove (or replace by `new`) the bold ids in `tokens` from the suggested-order section.
    Returns (changes, lines left for a manual edit)."""
    order = lf.section(role="order")
    if not order:
        return [], []
    raw = lf.raw.split("\n")
    start, end = section_span(lf, order)
    changes, left = [], []
    k = start
    while k < end:
        line = raw[k]
        if not lf.lines[k] or not any(t in line for t in tokens):
            k += 1
            continue
        m = ORDER_LINE_RE.match(line)
        refs = BOLD_RE.findall(m.group("refs")) if m else []
        if not m or any(t in m.group("rest") for t in tokens):
            left.append((k + 1, line.strip()))
            k += 1
            continue
        refs = [new.strip("*") if f"**{r}**" in tokens else r for r in refs] if new else \
            [r for r in refs if f"**{r}**" not in tokens]
        if refs:
            raw[k] = m.group("lead") + " + ".join(f"**{r}**" for r in refs) + m.group("rest")
            changes.append(f"{lf.name}:{k + 1}: suggested order now `{raw[k].strip()[:70]}`")
            k += 1
            continue
        j = k + 1
        while j < end and raw[j].strip() and raw[j][0].isspace():
            j += 1
        del raw[k:j]
        end -= j - k
        changes.append(f"{lf.name}:{k + 1}: removed suggested-order step `{line.strip()[:70]}`")
    # renumber a numbered list, and fall back to `_No open items._` when no id is left
    n = 0
    for k in range(start, end):
        m = re.match(r"^(\d+)\.(\s.*)$", raw[k])
        if m:
            n += 1
            raw[k] = f"{n}.{m.group(2)}"
    body = [k for k in range(start, end) if raw[k].strip() not in ("", "---")]
    if changes and not body:
        raw[start:start] = ["", "_No open items._"]
        changes.append(f"{lf.name}: suggested order is empty now")
    elif body and not any(BOLD_RE.search(raw[k]) for k in body) and \
            [raw[k].strip() for k in body] != ["_No open items._"]:
        raw[body[0]:body[-1] + 1] = ["_No open items._"]
        changes.append(f"{lf.name}: suggested order is empty now")
    if changes:
        save(lf, raw)
    return changes, [(lf.name, n, t) for n, t in left]


def edit_keep_open(lf, ref, new=None):
    """Remove (or replace by `new`) `ref` in the file's **Keep open for:** lines."""
    raw = lf.raw.split("\n")
    masked = list(lf.lines)
    pat = re.compile(rf"^{re.escape(ref)}(?![\w.])")
    changes = []
    k = 0
    while k < len(raw):
        if not masked[k].strip().startswith(KEEP_OPEN):
            k += 1
            continue
        j = k + 1
        while j < len(raw) and raw[j].strip() and not FIELD_RE.match(raw[j]) and not raw[j].startswith("#"):
            j += 1
        value = " ".join(t.strip() for t in raw[k:j])[len(KEEP_OPEN):].strip()
        dot = value.endswith(".")
        parts = split_top(value.rstrip("."))
        if not any(pat.match(p) for p in parts):
            k = j
            continue
        if new:
            parts = [pat.sub(new, p) if pat.match(p) else p for p in parts]
        else:
            parts = [p for p in parts if not pat.match(p)]
        if parts:
            new_lines = wrap(f"{KEEP_OPEN} " + ", ".join(parts) + ("." if dot else ""))
            raw[k:j] = new_lines
            changes.append(f"{lf.name}:{k + 1}: **Keep open for:** now `{' '.join(new_lines)[:70]}`")
            k += len(new_lines)
        else:
            del raw[k:j]
            collapse_blanks(raw, k)
            changes.append(f"{lf.name}:{k + 1}: removed the **Keep open for:** line (only named {ref})")
        masked = masked_lines("\n".join(raw))
    if changes:
        save(lf, raw)
    return changes


def mention_patterns(lf, it):
    """{file: regex} for mentions of the entry `it` (of list file `lf`) that may remain."""
    i = re.escape(it.id or "")
    if lf.kind == "analysis":
        bare = rf"(?<![\w.]){i}(?!\w|\.\d)"
        user = rf"(?<![\w.])U{i}(?!\w|\.\d)"
        if lf.name == "CLAUDE_ANALYSIS.md":
            return {"CLAUDE_ANALYSIS.md": re.compile(bare)}
        return {"USER_ANALYSIS.md": re.compile(f"{bare}|{user}"), "CLAUDE_ANALYSIS.md": re.compile(user)}
    if it.id is None:
        return {}
    pre = r"claude:" if lf.name == "CLAUDE_IDEAS.md" else r"(?<![\w:])"
    rx = re.compile(rf"{pre}{i}\b")
    return {n: rx for n in ("CLAUDE_PLAN.md", "USER_IDEAS.md", "CLAUDE_IDEAS.md")}


def order_tokens(lf, it):
    """{file: bold tokens} naming the entry in suggested-order sections."""
    if lf.name == "CLAUDE_ANALYSIS.md":
        return {lf.name: {f"**{it.id}**"}}
    if lf.name == "USER_ANALYSIS.md":
        return {lf.name: {f"**{it.id}**", f"**U{it.id}**"}, "CLAUDE_ANALYSIS.md": {f"**U{it.id}**"}}
    if lf.name == "CLAUDE_IDEAS.md":
        return {lf.name: {f"**{it.id}**", f"**claude:{it.id}**"}}
    return {lf.name: {f"**{it.id}**"}}


def leftover_mentions(lists, pats):
    out = []
    for name, rx in pats.items():
        lf = lists[name]
        if not lf.exists:
            continue
        skip = set(n for n, _ in lf.header)
        dropped = lf.section(role="dropped")
        if dropped:
            a, b = section_span(lf, dropped)
            skip |= set(range(a + 1, b + 1))
        for n, line in enumerate(lf.lines, 1):
            if n not in skip and rx.search(line):
                out.append((name, n, line.strip()))
    return out


def report_check(root, files):
    _, found = run_checks(root, sorted(files))
    errors = [p for p in found if p["level"] == "error"]
    for p in errors:
        print(format_problem(p))
    print(f"check: {plural(len(errors), 'error')} in {', '.join(sorted(files))}" if errors else
          f"check: OK ({', '.join(sorted(files))})")
    return 1 if errors else 0


def take_opts(args, flags, bools=()):
    """Split `--flag value` / `--bool` options from positional args."""
    opts, pos, k = {}, [], 0
    while k < len(args):
        a = args[k]
        if a in flags and k + 1 < len(args):
            opts[a] = args[k + 1]
            k += 2
        elif a in bools:
            opts[a] = True
            k += 1
        else:
            pos.append(a)
            k += 1
    return opts, pos


def delete_entry(root, ref, new=None, dropped=None):
    """Delete one entry with its mentions. Returns (touched files, ok)."""
    lists = load(root)
    hit = index(lists).get(ref)
    if not hit:
        print(f"not found: {ref} (no open entry with this id)")
        return set(), False
    lf, it = hit
    raw = lf.raw.split("\n")
    a, b = entry_span(lf, it)
    text = "\n".join(raw[a:b])
    only = it.section.role == "items" and len(it.section.items) == 1
    raw[a:b] = ["_No open items._"] if only else []
    if not only:
        collapse_blanks(raw, a)
    save(lf, raw)
    touched = {lf.name}
    print(f"deleted {' '.join([ref, *(f'[{t}]' for t in it.tags), it.title])} ({lf.name}:{a + 1}-{b})")

    tokens = order_tokens(lf, it)
    pats = mention_patterns(lf, it)
    left = []
    for name, toks in tokens.items():
        lists = load(root)
        if lists[name].exists:
            changes, rest = edit_order(lists[name], toks, new)
            left += rest
            if changes:
                touched.add(name)
                print("\n".join(changes))
    if lf.kind != "analysis" and it.id:
        for name in ("CLAUDE_PLAN.md", "USER_IDEAS.md", "CLAUDE_IDEAS.md"):
            lists = load(root)
            if lists[name].exists:
                changes = edit_keep_open(lists[name], ref, new)
                if changes:
                    touched.add(name)
                    print("\n".join(changes))
    if dropped:
        lists = load(root)
        ideas = lists["CLAUDE_IDEAS.md"]
        sec = ideas.section(role="dropped")
        if lf.name != "CLAUDE_IDEAS.md" or not sec:
            print("--dropped only applies to CLAUDE_IDEAS.md entries (with a `## Dropped` section)")
        else:
            raw = ideas.raw.split("\n")
            s0, s1 = section_span(ideas, sec)
            line = f"- {it.id} {it.title} — {dropped} ({time.strftime('%Y-%m-%d')})"
            empty = [k for k in range(s0, s1) if raw[k].strip() == "_None yet._"]
            items = [k for k in range(s0, s1) if raw[k].startswith("- ")]
            if empty:
                raw[empty[0]] = line
            elif items:
                raw.insert(items[-1] + 1, line)
            else:
                raw[s0:s0] = ["", line]
            save(ideas, raw)
            touched.add(ideas.name)
            print(f"added to ## Dropped: {line}")
    for br in sorted(set(BRANCH_RE.findall(text))):
        if git(root, "branch", "-D", br) is not None:
            print(f"deleted branch {br}")
    lists = load(root)
    for name, n, t in left + [m for m in leftover_mentions(lists, pats) if m[:2] not in {(x, y) for x, y, _ in left}]:
        print(f"check this mention yourself: {name}:{n}: {t[:110]}")
    if lf.name in FOOTER_KIND:
        print(f"Refs: {FOOTER_KIND[lf.name]} {it.id} ({it.title})")
    return touched, True


def cmd_delete(args):
    opts, refs = take_opts(args, {"--to", "--dropped"})
    if not refs:
        print("usage: workflow-lists delete ID... [--to NEW_ID] [--dropped REASON]")
        return 2
    root = setup_root()
    touched, ok = set(), True
    for ref in refs:
        t, good = delete_entry(root, ref, opts.get("--to"), opts.get("--dropped"))
        touched |= t
        ok &= good
    rc = report_check(root, touched) if touched else 0
    return 1 if not ok or rc else 0


def after_stamps(raw, a, b):
    """Index right after the entry's stamp lines (_Found_/_Written_/_Updated_/_Failed_)."""
    k = a + 1
    while k < b and re.match(r"^_(Found|Written|Updated|Failed):", raw[k].strip()):
        k += 1
    return k


def cmd_set(args):
    if len(args) < 2:
        print("usage: workflow-lists set ID decisions TEXT | model SPEC|none | hold | unhold | "
              "failed BRANCH|none MODEL REASON | updated")
        return 2
    ref, what, rest = args[0], args[1], args[2:]
    root = setup_root()
    lists = load(root)
    hit = index(lists).get(ref)
    if not hit:
        print(f"not found: {ref} (no open entry with this id)")
        return 1
    lf, it = hit
    raw = lf.raw.split("\n")
    a, b = entry_span(lf, it)
    date_time, commit = now_stamp(root)
    today = date_time[:10]
    body = range(a + 1, b)

    def find(prefix):
        return [k for k in body if raw[k].strip().startswith(prefix)]

    if what in ("hold", "unhold"):
        tags = [t for t in it.tags if t != "HOLD"]
        if what == "hold":
            sev = 1 if tags and tags[0] in SEVERITIES else 0
            tags.insert(sev, "HOLD")
        head = " ".join(x for x in [it.id, *(f"[{t}]" for t in tags), it.title] if x)
        raw[a] = f"### {head}"
        msg = f"{ref}: heading now `{raw[a]}`"
    elif what == "decisions":
        if not rest:
            print("set ID decisions TEXT: the text is missing")
            return 2
        text = " ".join(rest)
        failed = [k for k in find("_Failed:") if FAILED_RE.match(raw[k].strip())]
        for k in failed:
            m = FAILED_RE.match(raw[k].strip())
            where = f"`{m.group('branch')}`" if m.group("branch") else "(no changes)"
            text += f"; earlier attempt on {where} ({m.group('model')}) failed: {m.group('reason')}"
        old = find("**Decisions:**")
        if old:
            k = old[0]
            j = k + 1
            while j < b and raw[j].strip() and not FIELD_RE.match(raw[j]):
                j += 1
            joined = " ".join(t.strip() for t in raw[k:j])
            raw[k:j] = wrap(f"{joined}; {text} ({today})")
        else:
            raw[b:b] = ["", *wrap(f"**Decisions:** {text} ({today})")]
        for k in sorted(failed, reverse=True):
            del raw[k]
        msg = f"{ref}: decisions recorded" + (" (the _Failed:_ stamp moved into them)" if failed else "")
    elif what == "model":
        spec = " ".join(rest)
        if not spec:
            print("set ID model SPEC|none: the model is missing")
            return 2
        old = find("**Model:**")
        line = f"**Model:** {spec}"
        if spec == "none":
            for k in reversed(old):
                del raw[k]
                collapse_blanks(raw, k)
            msg = f"{ref}: model line removed"
        else:
            if not MODEL_RE.match(line):
                print(f"bad model spec `{spec}`; expected `<model>[, reasoning <level>]`")
                return 2
            if old:
                raw[old[0]] = line
            else:
                raw[b:b] = ["", line]
            msg = f"{ref}: {line}"
    elif what == "failed":
        if len(rest) < 3:
            print("set ID failed BRANCH|none MODEL REASON")
            return 2
        branch, model, reason = rest[0], rest[1], " ".join(rest[2:])
        where = "no changes" if branch in ("none", "-") else f"`{branch}`"
        line = f"_Failed: {date_time} ({where}, {model}): {reason}_"
        raw.insert(after_stamps(raw, a, b), line)
        msg = f"{ref}: {line}"
    elif what == "updated":
        line = f"_Updated: {date_time} (`{commit}`)_"
        old = find("_Updated:")
        if old:
            raw[old[0]] = line
        else:
            raw.insert(after_stamps(raw, a, b), line)
        msg = f"{ref}: {line}"
    else:
        print(f"unknown field `{what}`; use decisions, model, hold, unhold, failed or updated")
        return 2
    save(lf, raw)
    print(msg)
    return report_check(root, {lf.name})


def items_section(lf, number=None):
    if lf.kind == "analysis":
        return lf.section(number=int(number)) if number else None
    return lf.section(prefix="F" if lf.kind == "plan" else "I")


def insert_entry(root, lf, section, entry, before=None):
    """Insert entry lines (heading first) into section; returns the 1-based heading line."""
    raw = lf.raw.split("\n")
    s0, s1 = section_span(lf, section)
    none = [k for k in range(s0, s1) if raw[k].strip() == "_No open items._"]
    if none:
        k = none[0]
        raw[k:k + 1] = entry
    elif before:
        hit = index({lf.name: lf}).get(before)
        if not hit or hit[1].section is not section:
            print(f"--before {before}: not an entry of this section")
            return None
        k = hit[1].line - 1
        raw[k:k] = entry + [""]
    else:
        k = s1
        while k > s0 and raw[k - 1].strip() in ("", "---"):
            k -= 1
        raw[k:k] = [""] + entry
        k += 1
    save(lf, raw)
    return k + 1


def next_id(lf, section):
    """Take the section's next id and count `_Next id:_` up. Returns the id or None."""
    if not section.next_ids:
        print(f"{lf.name}: section `{section.title}` has no `_Next id:_` line")
        return None
    n, val = section.next_ids[0]
    m = re.fullmatch(re.escape(section.prefix) + r"(\d+)", val)
    if not m:
        print(f"{lf.name}:{n}: `_Next id: {val}_` doesn't look like `{section.prefix}<n>`")
        return None
    raw = lf.raw.split("\n")
    raw[n - 1] = f"_Next id: {section.prefix}{int(m.group(1)) + 1}_"
    save(lf, raw)
    return val


def build_entry(lf, item_id, sev, title, body, stamp_line):
    head = " ".join(x for x in [item_id, f"[{sev}]" if sev else "", title] if x)
    lines = [f"### {head}", stamp_line]
    body = body.strip("\n")
    if body:
        lines += [""] + body.split("\n")
    return lines


def cmd_add(args):
    opts, pos = take_opts(args, {"--section", "--sev", "--title", "--model", "--before"})
    if len(pos) != 1 or "--title" not in opts:
        print("usage: workflow-lists add FILE --title TITLE [--section 1|2|3] [--sev H|M|L] "
              "[--model SPEC] [--before ID] < body")
        return 2
    name = pick_files(pos)[0]
    root = setup_root()
    lf = load(root)[name]
    sev = opts.get("--sev", "").upper().strip("[]")
    if sev and sev not in SEVERITIES:
        print(f"--sev {sev}: use H, M or L")
        return 2
    if not sev and not lf.minimal:
        print(f"{name} entries need a severity: --sev H|M|L")
        return 2
    section = items_section(lf, opts.get("--section"))
    if section is None:
        print("--section 1|2|3 is needed for an analysis file" if lf.kind == "analysis" else
              f"{name} has no items section")
        return 2
    body = "" if sys.stdin.isatty() else sys.stdin.read()
    if "--model" in opts:
        line = f"**Model:** {opts['--model']}"
        if not MODEL_RE.match(line):
            print(f"bad model spec `{opts['--model']}`")
            return 2
        body = body.rstrip("\n") + "\n\n" + line
    item_id = next_id(lf, section)
    if item_id is None:
        return 1
    date_time, commit = now_stamp(root)
    word = "Found" if lf.kind == "analysis" else "Written"
    lf = load(root)[name]
    section = items_section(lf, opts.get("--section"))
    entry = build_entry(lf, item_id, sev, opts["--title"], body, f"_{word}: {date_time} (`{commit}`)_")
    line = insert_entry(root, lf, section, entry, opts.get("--before"))
    if line is None:
        return 1
    print(f"added {REF_PREFIX[name]}{item_id} at {name}:{line}")
    return report_check(root, {name})


def cmd_move(args):
    opts, pos = take_opts(args, {"--note"})
    if len(pos) != 2:
        print("usage: workflow-lists move ID FILE [--note TEXT]   (e.g. move claude:I3 USER_IDEAS.md)")
        return 2
    ref, name = pos[0], pick_files(pos[1:])[0]
    root = setup_root()
    lists = load(root)
    hit = index(lists).get(ref)
    if not hit:
        print(f"not found: {ref} (no open entry with this id)")
        return 1
    lf, it = hit
    target = lists[name]
    if target.kind != lf.kind or target.name == lf.name:
        print(f"can only move between two files of the same kind ({lf.name} is `{lf.kind}`)")
        return 2
    raw = lf.raw.split("\n")
    a, b = entry_span(lf, it)
    body = [t for t in raw[a + 1:b] if not re.match(r"^_(Found|Written|Updated):", t.strip())]
    if opts.get("--note"):
        body += ["", *wrap(f"**Notes for Claude:** {opts['--note']}")]
    section = items_section(target)
    new_id = next_id(target, section)
    if new_id is None:
        return 1
    new_ref = REF_PREFIX[name] + new_id
    date_time, commit = now_stamp(root)
    word = "Found" if target.kind == "analysis" else "Written"
    target = load(root)[name]
    entry = build_entry(target, new_id, it.severity, " ".join([*(f"[{t}]" for t in it.tags if t not in SEVERITIES), it.title]),
                        "\n".join(body), f"_{word}: {date_time} (`{commit}`)_")
    line = insert_entry(root, target, items_section(target), entry)
    print(f"added {new_ref} at {name}:{line}")
    touched, ok = delete_entry(root, ref, new=new_ref)
    return report_check(root, touched | {name}) or (0 if ok else 1)


def cmd_pass(args):
    if len(args) < 2:
        print("usage: workflow-lists pass FILE TEXT")
        return 2
    name = pick_files(args[:1])[0]
    root = setup_root()
    lf = load(root)[name]
    raw = lf.raw.split("\n")
    head = [n for n, t in lf.header if t.strip() == "Passes:"]
    if not head:
        print(f"{name}: the header has no `Passes:` list")
        return 1
    k = head[0]  # 0-based index right after `Passes:`
    last = None
    while k < len(raw) and (not raw[k].strip() or raw[k].startswith("- ")) and not raw[k].startswith("#"):
        if raw[k].startswith("- "):
            last = k
        elif last is not None:
            break
        k += 1
    date_time, commit = now_stamp(root)
    line = f"- {date_time} at {commit}: {' '.join(args[1:])}"
    if last is None:
        raw[head[0]:head[0]] = ["", line]
    else:
        raw.insert(last + 1, line)
    save(lf, raw)
    print(f"{name}: {line}")
    return report_check(root, {name})


CITED_RE = re.compile(r"`([^`\s]+)`")


def cited_paths(lf, it):
    a, b = entry_span(lf, it)
    out = set()
    for t in lf.raw.split("\n")[a:b]:
        for c in CITED_RE.findall(t):
            c = re.sub(r":[\d,-]+$", "", c).rstrip("/")
            if ("/" in c or "." in c) and not c.startswith(("workflow/", "**")) and not re.fullmatch(r"[0-9a-f]{4,40}", c):
                out.add(c)
    return out


def cmd_find(args):
    opts, paths = take_opts(args, {"--since"}, {"--show"})
    root = setup_root()
    if "--since" in opts:
        out = git(root, "diff", "--name-only", f"{opts['--since']}..HEAD")
        if out is None:
            print(f"git diff {opts['--since']}..HEAD failed")
            return 2
        paths += [p for p in out.split("\n") if p and Path(p).name not in LISTS]
    if not paths:
        print("usage: workflow-lists find [--since COMMIT] [--show] [PATH...]")
        return 2
    lists = load(root)
    hits, uncited = [], []
    for name in ("CLAUDE_ANALYSIS.md", "USER_ANALYSIS.md"):
        lf = lists[name]
        for it in lf.items(ideas=False):
            cited = cited_paths(lf, it)
            if not cited:
                uncited.append(it.ref)
            elif any(p == c or p.endswith("/" + c) or p.startswith(c + "/") or c.startswith(p.rstrip("/") + "/")
                     for p in paths for c in cited):
                hits.append((lf, it))
    n = len(hits)
    print(f"{n} {'entry cites' if n == 1 else 'entries cite'} the {plural(len(set(paths)), 'path')}")
    for lf, it in hits:
        if "--show" in opts:
            a, b = entry_span(lf, it)
            print(f"==> {lf.name}:{it.line}")
            print("\n".join(lf.raw.split("\n")[a:b]))
        else:
            print(f"{lf.name}:{describe(it).strip()}")
    if uncited:
        print(f"cite no file (judge by title, `show` if needed): {' '.join(uncited)}")
    return 0


SEV_RANK = {"H": 0, "M": 1, "L": 2}
SIZE_RANK = {"S": 0, "M": 1, "L": 2}
NEEDS_RE = re.compile(r"\bneeds\s+(?:\*\*)?(F\d+)", re.I)
PLAN_FIELDS = ["what", "why", "done when", "design docs", "how", "size"]


def item_size(it):
    m = re.match(r"^\W*([SML])\b", it.field("size", "effort") or "")
    return m.group(1) if m else "?"


def item_model(it):
    for _, t in it.body:
        if t.strip().startswith("**Model:**"):
            return t.strip()[len("**Model:**"):].strip().replace("`", "")
    return "default"


def item_failed(it):
    for _, t in it.body:
        m = FAILED_RE.match(t.strip())
        if m:
            return m
    return None


def order_rank(lists, lf):
    """ref -> position in the file's suggested-order section."""
    sec = lf.section(role="order")
    rank = {}
    if not sec:
        return rank
    for _, t in sec.text:
        for b in BOLD_RE.findall(t):
            if lf.kind == "analysis":
                ref = b if b.startswith("U") or lf.name == "CLAUDE_ANALYSIS.md" else "U" + b
            else:
                ref = b
            rank.setdefault(ref, len(rank))
    return rank


def work_order(lists, items):
    """Order (ListFile, Item) pairs: suggested order, then what others build on, severity,
    size, file order; the user's findings before Claude's of the same or lower severity."""
    def key(pair, rank):
        lf, it = pair
        return (rank.get(it.ref, 10 ** 6), SEV_RANK.get(it.severity, 1), SIZE_RANK.get(item_size(it), 3), it.line)

    by_file = {}
    for pair in items:
        by_file.setdefault(pair[0].name, []).append(pair)
    queues = {name: sorted(pairs, key=lambda p: key(p, order_rank(lists, p[0]))) for name, pairs in by_file.items()}
    user, claude = queues.get("USER_ANALYSIS.md", []), queues.get("CLAUDE_ANALYSIS.md", [])
    merged = []
    while user or claude:
        if user and (not claude or SEV_RANK.get(claude[0][1].severity, 1) >= SEV_RANK.get(user[0][1].severity, 1)):
            merged.append(user.pop(0))
        else:
            merged.append(claude.pop(0))
    merged += queues.get("CLAUDE_PLAN.md", [])
    # what others build on ("needs F2") goes first
    refs = [it.ref for _, it in merged]
    needs = {it.ref: [n for n in NEEDS_RE.findall("\n".join(t for _, t in it.body)) if n in refs and n != it.ref]
             for _, it in merged}
    out, seen = [], set()

    def visit(ref, stack=()):
        if ref in seen or ref in stack:
            return
        for n in needs.get(ref, []):
            visit(n, stack + (ref,))
        seen.add(ref)
        out.append(ref)

    for r in refs:
        visit(r)
    pairs = {it.ref: (lf, it) for lf, it in merged}
    return [pairs[r] for r in out]


def triage_reason(root, lf, it):
    """Why an entry needs a look at the code before a run, or None if it is READY as written."""
    if lf.kind == "analysis":
        text = "\n".join(t for _, t in it.body).lower() + it.title.lower()
        if re.search(r"\b(verify|possible|possibly)\b", text):
            return "marked verify/possible"
        if lf.user and not cited_paths(lf, it):
            return "user finding citing no file"
        return "is it still there, is the fix clear"
    if "CONFLICT" in it.tags:
        return "[CONFLICT]"
    have = it.fields() | ({"size"} if "effort" in it.fields() else set())
    missing = [f for f in PLAN_FIELDS if f not in have]
    if missing:
        return "written or edited by hand (no " + ", ".join(missing) + ")"
    stamp = next((t for _, t in it.body if t.strip().startswith("_Written:")), "")
    m = re.search(r"\(`?([0-9a-f]{4,40})`?\)", stamp)
    cited = cited_paths(lf, it)
    if m and cited:
        out = git(root, "diff", "--name-only", f"{m.group(1)}..HEAD")
        if out:
            changed = [p for p in out.split("\n") if Path(p).name not in LISTS]
            hit = [c for c in cited if any(p == c or p.endswith("/" + c) or p.startswith(c + "/") for p in changed)]
            if hit:
                return "cited files changed since it was written (" + ", ".join(sorted(hit)[:3]) + ")"
    return None


def cmd_triage(args):
    opts, files = take_opts(args, {"--skip", "--only"})
    files = pick_files(files)
    if not files:
        print("usage: workflow-lists triage LIST... [--skip IDS] [--only IDS]   (ids comma- or space-separated)")
        return 2
    root = setup_root()
    lists = load(root)
    skip = set(re.split(r"[,\s]+", opts.get("--skip", "")) ) - {""}
    only = set(re.split(r"[,\s]+", opts.get("--only", ""))) - {""}
    items, held, skipped = [], [], []
    for name in files:
        lf = lists[name]
        for it in lf.items(ideas=False):
            if only and it.ref not in only:
                continue
            if "HOLD" in it.tags:
                held.append(it.ref)
            elif it.ref in skip:
                skipped.append(it.ref)
            else:
                items.append((lf, it))
    ordered = work_order(lists, items)
    print("ORDER: " + " ".join(it.ref for _, it in ordered))
    counts = {"READY": 0, "FAILED": 0, "CHECK": 0}
    for lf, it in ordered:
        head = f"{it.ref} | size {item_size(it)} | model {item_model(it)}"
        f = item_failed(it)
        if f:
            counts["FAILED"] += 1
            where = f.group("branch") or "no changes"
            print(f"FAILED: {head} | {it.title} — {where}, {f.group('model')}: {f.group('reason')}")
            continue
        why = triage_reason(root, lf, it)
        if why:
            counts["CHECK"] += 1
            print(f"CHECK: {head} | {it.title} — {why}")
        else:
            counts["READY"] += 1
            print(f"READY: {head}")
    if held:
        print("HELD: " + " ".join(held))
    if skipped:
        print("SKIPPED: " + " ".join(skipped))
    print(f"TOTAL: {counts['READY']} ready, {counts['CHECK']} to check, {counts['FAILED']} failed")
    return 0


COMMANDS = {
    "check": cmd_check,
    "summary": cmd_summary,
    "show": cmd_show,
    "section": cmd_section,
    "stamp": cmd_stamp,
    "delete": cmd_delete,
    "set": cmd_set,
    "add": cmd_add,
    "move": cmd_move,
    "pass": cmd_pass,
    "find": cmd_find,
    "triage": cmd_triage,
    "hook": cmd_hook,
}


def main(argv):
    if len(argv) < 2 or argv[1] not in COMMANDS:
        print(__doc__.strip())
        return 2
    return COMMANDS[argv[1]](argv[2:])


if __name__ == "__main__":
    sys.exit(main(sys.argv))
