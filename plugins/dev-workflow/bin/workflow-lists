#!/usr/bin/env python3
"""workflow-lists: mechanical checks and summaries for the dev-workflow list files.

Run from the target project (any directory inside its git repo):

  workflow-lists check [--errors-only] [FILE...]   validate lists, CLAUDE.md, USER_WORKFLOW.md
  workflow-lists summary [--ideas] [FILE...]       one line per open item
  workflow-lists show ID...                        print the entries with these ids
  workflow-lists section FILE HEADING...           print these `## ` sections of FILE
  workflow-lists stamp                             value for _Found:_ / _Written:_ stamps
  workflow-lists delete ID... [--to ID] [--dropped REASON]
                                                   delete entries with their mentions and branches
  workflow-lists set ID decisions TEXT | model SPEC|none | hold | unhold
                        | failed BRANCH|none MODEL REASON | updated
                                                   change one line of an entry
  workflow-lists add FILE --title T [--section N] [--sev S] [--model M] [--before ID] < body
                                                   add an entry with the next id and a stamp
  workflow-lists move ID FILE [--note TEXT]        move an idea to the other idea file
  workflow-lists pass FILE TEXT                    add a stamped line to the Passes list
  workflow-lists find [--since COMMIT] [--show] [PATH...]
                                                   analysis entries citing these files
  workflow-lists triage LIST... [--skip IDS] [--only IDS]
                                                   work order and mechanical triage for a run
  workflow-lists brief ID | --context              everything an item agent needs, in one output
  workflow-lists run start|queue|skip|log|next|result|commit|changes|end KIND ...
                                                   run state and bookkeeping for the loop skills
  workflow-lists run go KIND [--auto ...]          drive a prepared run: one `claude -p` per item
  workflow-lists stats [--by plugin,model,...] [--items] [--role item|review|analysis|all]
                                                   tables from the stats file of past runs
  workflow-lists hook                              PostToolUse hook (reads hook JSON on stdin)

The rules checked here are the mechanical part of
skills/setup-workflow/list-format.md; keep both in sync.
Exit codes: 0 fine (warnings allowed), 1 errors found (show / section: an id or
heading not found), 2 not set up or bad usage.
Standard library only.
"""

import json
import os
import re
import subprocess
import sys
import time
from pathlib import Path

LISTS = ["CLAUDE_ANALYSIS.md", "USER_ANALYSIS.md", "CLAUDE_PLAN.md", "USER_IDEAS.md", "CLAUDE_IDEAS.md"]
KIND = {
    "CLAUDE_ANALYSIS.md": "analysis",
    "USER_ANALYSIS.md": "analysis",
    "CLAUDE_PLAN.md": "plan",
    "USER_IDEAS.md": "ideas",
    "CLAUDE_IDEAS.md": "ideas",
}
USER_FILES = {"USER_ANALYSIS.md", "USER_IDEAS.md"}
# The user's ideas need only a heading: no id, severity or stamp required.
MINIMAL_FILES = {"USER_IDEAS.md"}
OLD_PLAN = "USER_PLAN.md"  # replaced in plugin version 3 (setup-workflow -> C)
# How ids are written outside the files (list-format.md -> "Ids outside the files").
REF_PREFIX = {
    "CLAUDE_ANALYSIS.md": "",
    "USER_ANALYSIS.md": "U",
    "CLAUDE_PLAN.md": "",
    "USER_IDEAS.md": "",
    "CLAUDE_IDEAS.md": "claude:",
}
ANALYSIS_SECTIONS = {
    1: "Bugs",
    2: "Performance",
    3: "Cleanliness / architecture",
    4: "Suggested order of work",
}
SEVERITIES = {"H", "M", "L"}
TAGS = SEVERITIES | {"HOLD", "CONFLICT"}
EFFORTS = {"low", "medium", "high", "xhigh"}
OLD_PATHS = [".claude/skills/", "~/.claude/skills"]
REMOVED_SKILLS = {
    "/fix-next-user-finding": "`/fix-next-finding user-only`",
    "/fix-all-user-findings": "`/fix-all-findings user-only`",
    "/implement-all-claude-features": "`/implement-all-features`, which works off CLAUDE_PLAN.md",
    "/explore-feature": "`/plan-features <idea or wish>`",
}
TEMPLATES = Path(__file__).resolve().parent.parent / "skills" / "setup-workflow" / "templates"

DATE = r"\d{4}-\d{2}-\d{2} \d{2}:\d{2} [A-Za-z0-9+:-]+"
COMMIT = r"`?(?:[0-9a-f]{4,40}|no commit)`?"
STAMP_RE = {
    "analysis": re.compile(rf"^_Found: {DATE} \({COMMIT}\)_$"),
    "plan": re.compile(rf"^_Written: {DATE} \({COMMIT}\)_$"),
    "ideas": re.compile(rf"^_Written: {DATE} \({COMMIT}\)_$"),
}
UPDATED_RE = re.compile(rf"^_Updated: {DATE} \({COMMIT}\)_$")
FAILED_RE = re.compile(
    rf"^_Failed: {DATE} \((?:`?(?P<branch>workflow/failed/[^`,\s]+)`?|no changes), (?P<model>[^)]+)\): (?P<reason>.+)_$"
)
MODEL_RE = re.compile(r"^\*\*Model:\*\* `?[\w.:-]+`?(?:, reasoning (?P<effort>\w+))?\s*$")
NEXT_ID_RE = re.compile(r"^_Next id: (?P<id>\S+?)_\s*$")
HEADING_RE = re.compile(r"^###\s+(?P<rest>.*)$")
ID_RE = re.compile(r"^(?P<id>(?:\d+\.\d+|[FI]\d+))\b\s*(?P<rest>.*)$")
FIELD_RE = re.compile(r"^\s*(?:[-*]\s+)?\*\*(?P<key>[^*]+?):?\*\*:?")
BRANCH_RE = re.compile(r"workflow/failed/[\w./-]*[\w-]")
PASS_RE = re.compile(rf"^- {DATE} at {COMMIT}: .+")
DROPPED_RE = re.compile(r"^- (?P<id>[FI]\d+) .+ — .+ \(\d{4}-\d{2}-\d{2}[^)]*\)\.?$")
PLAN_REF_RE = re.compile(r"(?<![\w:])(?P<claude>claude:)?(?P<id>[FI]\d+)\b")
ANALYSIS_REF_RE = re.compile(r"\*\*(?P<user>U)?(?P<id>\d+\.\d+)\*\*")
PLAN_BOLD_REF_RE = re.compile(r"\*\*(?P<claude>claude:)?(?P<id>[FI]\d+)\*\*")


# --------------------------------------------------------------------------- helpers


def git(root, *args):
    try:
        out = subprocess.run(
            ["git", *args], cwd=root, capture_output=True, text=True, check=True
        )
    except (OSError, subprocess.CalledProcessError):
        return None
    return out.stdout.strip()


def find_root(start):
    top = git(start, "rev-parse", "--show-toplevel")
    return Path(top) if top else Path(start).resolve()


def masked_lines(text):
    """Lines with HTML comments and fenced code blanked out, line numbers preserved."""
    text = re.sub(r"<!--.*?-->", lambda m: "\n" * m.group().count("\n"), text, flags=re.S)
    lines, fenced = [], False
    for line in text.split("\n"):
        if line.lstrip().startswith("```"):
            fenced = not fenced
            lines.append("")
        else:
            lines.append("" if fenced else line)
    return lines


def slug(title):
    words = re.findall(r"[a-z0-9]+", title.lower())[:5]
    return "-".join(words) or "untitled"


def plural(n, word):
    return f"{n} {word}" + ("" if n == 1 else "s")


class Problems:
    def __init__(self):
        self.items = []

    def add(self, level, file, line, msg, about=None):
        self.items.append(
            {"level": level, "file": file, "line": line, "msg": msg, "about": about or file}
        )


# --------------------------------------------------------------------------- parsing


class Section:
    def __init__(self, title, line):
        self.title = title
        self.line = line
        self.role = "other"  # items | order | dropped | other
        self.number = None  # analysis section number
        self.prefix = None  # expected id prefix ("1." / "F" / "I")
        self.next_ids = []  # (line, value)
        self.no_open = []  # line numbers of "_No open items._" / "_None yet._"
        self.items = []
        self.text = []  # (line, text) of section-level lines


class Item:
    def __init__(self, file, section, line, heading):
        self.file = file
        self.section = section
        self.line = line
        self.heading = heading
        self.id = None
        self.tags = []
        self.title = ""
        self.body = []  # (line, text)

    @property
    def ref(self):
        if self.id is None:
            return slug(self.title)
        return REF_PREFIX[self.file] + self.id

    @property
    def severity(self):
        return self.tags[0] if self.tags and self.tags[0] in SEVERITIES else None

    def field(self, *keys):
        for _, text in self.body:
            m = FIELD_RE.match(text)
            if m and m.group("key").strip().lower() in keys:
                return text[m.end():].strip()
        return None

    def fields(self):
        keys = set()
        for _, text in self.body:
            m = FIELD_RE.match(text)
            if m:
                keys.add(m.group("key").strip().lower())
        return keys


class ListFile:
    def __init__(self, root, name):
        self.name = name
        self.kind = KIND[name]
        self.user = name in USER_FILES
        self.minimal = name in MINIMAL_FILES
        self.path = root / name
        self.exists = self.path.is_file()
        self.raw = self.path.read_text(encoding="utf-8") if self.exists else ""
        self.lines = masked_lines(self.raw)
        self.header = []  # (line, text) before the first "## "
        self.sections = []
        self.stray = []  # items before any section
        if self.exists:
            self._parse()

    def _parse(self):
        section = item = None
        for n, line in enumerate(self.lines, 1):
            if line.startswith("## "):
                section, item = Section(line[3:].strip(), n), None
                self._classify(section)
                self.sections.append(section)
                continue
            m = HEADING_RE.match(line)
            if m:
                item = Item(self.name, section, n, m.group("rest").strip())
                self._parse_heading(item)
                (section.items if section else self.stray).append(item)
                continue
            if item is not None:
                item.body.append((n, line))
            elif section is not None:
                section.text.append((n, line))
                if NEXT_ID_RE.match(line.strip()):
                    section.next_ids.append((n, NEXT_ID_RE.match(line.strip()).group("id")))
                elif line.strip() in ("_No open items._", "_None yet._"):
                    section.no_open.append(n)
            else:
                self.header.append((n, line))

    def _classify(self, section):
        title = section.title
        if self.kind == "analysis":
            m = re.match(r"^(\d+)\.\s*(.*)$", title)
            if m:
                section.number = int(m.group(1))
                if section.number in (1, 2, 3):
                    section.role, section.prefix = "items", f"{section.number}."
                elif section.number == 4:
                    section.role = "order"
        else:
            low = title.lower()
            if self.kind == "plan" and low == "concrete features":
                section.role, section.prefix = "items", "F"
            elif self.kind == "ideas" and low == "ideas":
                section.role, section.prefix = "items", "I"
            elif self.kind == "ideas" and low == "dropped":
                section.role = "dropped"
            elif "order" in low:
                section.role = "order"

    @staticmethod
    def _parse_heading(item):
        rest = item.heading
        m = ID_RE.match(rest)
        if m:
            item.id, rest = m.group("id"), m.group("rest")
        while True:
            t = re.match(r"^\[([A-Za-z]+)\]\s*", rest)
            if not t:
                break
            item.tags.append(t.group(1).upper() if t.group(1).upper() in TAGS else t.group(1))
            rest = rest[t.end():]
        item.title = rest.strip()

    def items(self, ideas=True):
        for s in self.sections:
            if s.role == "items" and (ideas or s.prefix != "I"):
                yield from s.items

    def section(self, role=None, prefix=None, number=None):
        for s in self.sections:
            if (role is None or s.role == role) and (prefix is None or s.prefix == prefix) and (
                number is None or s.number == number
            ):
                return s
        return None


def load(root):
    return {name: ListFile(root, name) for name in LISTS}


# --------------------------------------------------------------------------- checks


def id_number(item_id):
    return int(re.search(r"(\d+)$", item_id).group(1))


def check_structure(lf, probs):
    name = lf.name
    entry = "warn" if lf.user else "error"
    for it in lf.stray:
        probs.add("error", name, it.line, f"item `{it.heading}` sits before any `## ` section")

    if lf.kind == "analysis":
        for num, title in ANALYSIS_SECTIONS.items():
            if not lf.section(number=num):
                probs.add("error", name, None, f"missing section `## {num}. {title}`")
    elif lf.kind == "plan":
        if not lf.section(prefix="F"):
            probs.add("error", name, None, "missing section `## Concrete features`")
    else:
        if not lf.section(prefix="I"):
            probs.add("error", name, None, "missing section `## Ideas`")
        if not lf.user and not lf.section(role="dropped"):
            probs.add("error", name, None, "missing section `## Dropped`")
    if not lf.user:
        for s in lf.sections:
            if s.role != "other":
                continue
            if lf.kind == "plan" and s.title.lower() in ("ideas", "dropped"):
                probs.add("warn", name, s.line, f"`## {s.title}` is from the old plan layout (Claude's ideas now live in CLAUDE_IDEAS.md); run /setup-workflow check to migrate")
            else:
                probs.add("warn", name, s.line, f"unexpected section `## {s.title}`")

    seen = {}
    for s in lf.sections:
        if s.role != "items":
            continue
        next_val = None
        if not s.next_ids:
            probs.add("error", name, s.line, f"section `{s.title}` has no `_Next id:_` line")
        elif len(s.next_ids) > 1:
            probs.add("error", name, s.next_ids[1][0], f"section `{s.title}` has several `_Next id:_` lines")
        if s.next_ids:
            line, val = s.next_ids[0]
            if not re.fullmatch(re.escape(s.prefix) + r"\d+", val):
                probs.add("error", name, line, f"`_Next id: {val}_` should look like `{s.prefix}<n>`")
            else:
                next_val = id_number(val)
        if s.items and s.no_open:
            probs.add("error", name, s.no_open[0], f"`_No open items._` in `{s.title}`, which has items")
        if not s.items and not s.no_open:
            probs.add("error", name, s.line, f"empty section `{s.title}` lacks its `_No open items._` line")

        for it in s.items:
            for line, text in it.body:
                if NEXT_ID_RE.match(text.strip()):
                    probs.add("error", name, line, "`_Next id:_` must come before the first item of its section")
            if it.id is None:
                if not lf.minimal:
                    probs.add(entry, name, it.line, f"heading `{it.heading}` has no id")
            else:
                if not re.fullmatch(re.escape(s.prefix) + r"\d+", it.id):
                    probs.add(entry, name, it.line, f"id {it.id} doesn't belong in `{s.title}` (expected `{s.prefix}<n>`)")
                elif next_val is not None and id_number(it.id) >= next_val:
                    probs.add("error", name, it.line, f"id {it.id} is not below `_Next id: {s.next_ids[0][1]}_` (count the next id up)")
                if it.id in seen:
                    probs.add("error", name, it.line, f"duplicate id {it.id} (also line {seen[it.id]}); ids are never reused")
                else:
                    seen[it.id] = it.line
            check_entry(lf, it, probs)

    dropped = lf.section(role="dropped")
    if dropped:
        entries = [(n, t.strip()) for n, t in dropped.text if t.strip().startswith("- ")]
        if entries and dropped.no_open:
            probs.add("error", name, dropped.no_open[0], "`_None yet._` in `Dropped`, which has entries")
        for n, t in entries:
            m = DROPPED_RE.match(t)
            if not m:
                probs.add("warn", name, n, "dropped line should read `- <id> <name> — <reason> (<date>)`")
            elif m.group("id") in seen:
                probs.add("error", name, n, f"dropped id {m.group('id')} is also an open item (line {seen[m.group('id')]}); ids are never reused")


def check_entry(lf, it, probs):
    name = lf.name
    entry = "warn" if lf.user else "error"
    if it.severity is None and not lf.minimal:  # optional in the user's ideas
        probs.add(entry, name, it.line, f"{it.ref}: severity [H], [M] or [L] should follow the id")
    for tag in it.tags:
        if tag not in TAGS:
            probs.add("warn", name, it.line, f"{it.ref}: unknown tag [{tag}]")
    if sum(tag in SEVERITIES for tag in it.tags) > 1:
        probs.add(entry, name, it.line, f"{it.ref}: several severities")
    if "CONFLICT" in it.tags and lf.kind == "analysis":
        probs.add("warn", name, it.line, f"{it.ref}: [CONFLICT] is only used in plan and idea files")

    body = [(n, t.strip()) for n, t in it.body if t.strip()]
    stamp_word = "_Found:" if lf.kind == "analysis" else "_Written:"
    if not body or not body[0][1].startswith(stamp_word):
        if not lf.minimal:  # optional in the user's ideas
            probs.add(entry, name, it.line, f"{it.ref}: first line after the heading should be the `{stamp_word} …_` stamp")
    elif not STAMP_RE[lf.kind].match(body[0][1]):
        probs.add(entry, name, body[0][0], f"{it.ref}: stamp should read `{stamp_word} YYYY-MM-DD HH:MM TZ (`commit`)_`")

    for n, t in body:
        if t.startswith("_Updated:") and not UPDATED_RE.match(t):
            probs.add("error", name, n, f"{it.ref}: `_Updated:_` should read `_Updated: YYYY-MM-DD HH:MM TZ (`commit`)_`")
        if t.startswith("_Failed:") and not FAILED_RE.match(t):
            probs.add("error", name, n, f"{it.ref}: `_Failed:_` should read `_Failed: <date time TZ> (`workflow/failed/...` or no changes, <model>): <reason>_`")
        if t.startswith("**Model:**"):
            m = MODEL_RE.match(t)
            if not m:
                probs.add(entry, name, n, f"{it.ref}: `**Model:**` should read `**Model:** <model>[, reasoning <level>]`")
            elif m.group("effort") and m.group("effort") not in EFFORTS:
                probs.add(entry, name, n, f"{it.ref}: reasoning level `{m.group('effort')}` is not one of {', '.join(sorted(EFFORTS))}")

    if lf.user:
        return
    have = it.fields()
    if lf.kind == "analysis":
        need = ["fix"]
    elif lf.kind == "plan":
        need = ["what", "why", "done when", "design docs", "how", "size"]
        if "effort" in have:
            have.add("size")
    else:
        need = ["what", "why", "design docs", "open questions"]
    if "CONFLICT" in it.tags:
        need += ["conflicts with", "why anyway"]
    missing = [k for k in need if k not in have]
    if missing:
        fields = ", ".join(f"**{k[0].upper()}{k[1:]}:**" for k in missing)
        probs.add("error", name, it.line, f"{it.ref}: missing {fields}")
    if lf.kind == "plan" and "verify" not in have:
        probs.add("warn", name, it.line, f"{it.ref}: no **Verify:** line (how an agent checks Done when)")


def check_header(lf, probs):
    name = lf.name
    text = "\n".join(t for _, t in lf.header)
    for old in OLD_PATHS:
        if old in text:
            probs.add("warn", name, None, f"header points to the old skill path `{old}`; use the template's wording")
    for skill, now in REMOVED_SKILLS.items():
        if re.search(re.escape(skill) + r"(?![\w-])", lf.raw):
            probs.add("warn", name, None, f"names the removed skill `{skill}` (now {now})")
    if "list-format.md" not in text:
        probs.add("warn", name, None, "header doesn't point to `list-format.md` for the rules")
    if not lf.user:
        passes = [n for n, t in lf.header if t.strip() == "Passes:"]
        if not passes:
            probs.add("error", name, None, "header lacks the `Passes:` list")
        else:
            for n, t in lf.header:
                if n > passes[0] and t.startswith("- ") and not PASS_RE.match(t):
                    probs.add("warn", name, n, "pass line should start `- YYYY-MM-DD HH:MM TZ at <commit>: `")


def resolve(lists, ref_file, item_id):
    """Is item_id an open item of ref_file?"""
    return item_id in {it.id for it in lists[ref_file].items()}


def plan_ref_file(m):
    """The file a PLAN_REF_RE match points to: F -> the plan, I -> the user's ideas,
    claude:I -> Claude's ideas (claude:F is left over from the old layout and resolves nowhere)."""
    if m.group("claude"):
        return "CLAUDE_IDEAS.md"
    return "CLAUDE_PLAN.md" if m.group("id").startswith("F") else "USER_IDEAS.md"


def check_references(lists, probs):
    for lf in lists.values():
        if not lf.exists:
            continue
        name = lf.name
        # Keep open for: lines in plan and idea items.
        if lf.kind != "analysis":
            for it in lf.items():
                lines, grab = [], False
                for n, t in it.body:
                    if t.strip().startswith("**Keep open for:**"):
                        grab = True
                    elif grab and (not t.strip() or FIELD_RE.match(t)):
                        grab = False
                    if grab:
                        lines.append((n, t))
                for n, t in lines:
                    t = re.sub(r'"[^"]*"|“[^”]*”', "", t)
                    for m in PLAN_REF_RE.finditer(t):
                        target = plan_ref_file(m)
                        if not resolve(lists, target, m.group("id")):
                            probs.add("error", name, n, f"{it.ref}: **Keep open for:** names {m.group(0)}, which is not an open item", about=target)
        # Suggested-order sections.
        order = lf.section(role="order")
        if not order:
            continue
        for n, t in order.text:
            if lf.kind == "analysis":
                for m in ANALYSIS_REF_RE.finditer(t):
                    target = "USER_ANALYSIS.md" if m.group("user") else name
                    if not resolve(lists, target, m.group("id")):
                        probs.add("error", name, n, f"suggested order names {m.group(0)}, which is not an open item", about=target)
            else:
                for m in PLAN_BOLD_REF_RE.finditer(t):
                    target = plan_ref_file(m)
                    if not resolve(lists, target, m.group("id")):
                        probs.add("error", name, n, f"suggested order names {m.group(0)}, which is not an open item", about=target)
        if name == "CLAUDE_ANALYSIS.md":
            open_items = list(lf.items())
            content = [t for _, t in order.text if t.strip() and t.strip() != "---"]
            if not open_items and content != ["_No open items._"]:
                probs.add("error", name, order.line, "no open findings, so section 4 should be just `_No open items._`")
            elif open_items and order.no_open:
                probs.add("warn", name, order.no_open[0], "section 4 says `_No open items._` but there are open findings")
            elif open_items:
                text = "\n".join(content)
                named = {m.group("id") for m in ANALYSIS_REF_RE.finditer(text) if not m.group("user")}
                for it in open_items:
                    if it.id and it.id not in named and "HOLD" not in it.tags:
                        probs.add("warn", name, it.line, f"{it.ref} is not in section 4 (suggested order)")


def check_branches(root, lists, probs):
    out = git(root, "branch", "--list", "workflow/failed/*", "--format=%(refname:short)")
    if out is None:
        return
    branches = set(out.split()) if out else set()
    mentioned = set()
    for lf in lists.values():
        for m in BRANCH_RE.finditer(lf.raw):
            mentioned.add(m.group(0))
        for it in lf.items():
            for n, t in it.body:
                t = t.strip()
                fm = FAILED_RE.match(t)
                if fm and fm.group("branch") and fm.group("branch") not in branches:
                    probs.add("error", lf.name, n, f"{it.ref}: `_Failed:_` names branch {fm.group('branch')}, which doesn't exist")
                elif not fm:
                    for m in BRANCH_RE.finditer(t):
                        if m.group(0) not in branches:
                            probs.add("warn", lf.name, n, f"{it.ref}: names branch {m.group(0)}, which doesn't exist")
    for b in sorted(branches - mentioned):
        probs.add("warn", None, None, f"branch {b} is named by no entry; if its item is done, delete it (`git branch -D {b}`)")


def section_body(lines, title):
    """Lines of the `## <title>` section (up to the next `## `)."""
    out, inside = [], False
    for n, line in enumerate(lines, 1):
        if line.startswith("## "):
            inside = line[3:].strip().lower() == title.lower()
            continue
        if inside:
            out.append((n, line))
    return out


def check_claude_md(root, probs):
    path = root / "CLAUDE.md"
    if not path.is_file():
        probs.add("warn", "CLAUDE.md", None, "missing; it should hold the `## Workflow` section")
        return
    lines = masked_lines(path.read_text(encoding="utf-8"))
    if not any(l.strip() == "## Workflow" for l in lines):
        probs.add("warn", "CLAUDE.md", None, "no `## Workflow` section")
        return
    body = section_body(lines, "Workflow")
    for sub in ("### Code scope", "### Verification"):
        if not any(t.strip() == sub for _, t in body):
            probs.add("warn", "CLAUDE.md", None, f"`## Workflow` lacks `{sub}`")
    text = "\n".join(t for _, t in body)
    for old in OLD_PATHS:
        if old in text:
            probs.add("warn", "CLAUDE.md", None, f"`## Workflow` points to the old skill path `{old}`")
    for skill, now in REMOVED_SKILLS.items():
        if re.search(re.escape(skill) + r"(?![\w-])", text):
            probs.add("warn", "CLAUDE.md", None, f"`## Workflow` names the removed skill `{skill}` (now {now})")


def check_user_workflow(root, probs):
    template = TEMPLATES / "USER_WORKFLOW.md"
    if not template.is_file():
        return
    have = masked_lines((root / "USER_WORKFLOW.md").read_text(encoding="utf-8"))
    want = masked_lines(template.read_text(encoding="utf-8"))
    headings = {l.strip() for l in have if l.startswith("#")}
    for l in want:
        if re.match(r"^#{2,3} ", l) and l.strip() not in headings:
            probs.add("warn", "USER_WORKFLOW.md", None, f"lacks the template's section `{l.strip()}`")
    runs = "\n".join(t for _, t in section_body(have, "Runs"))
    for _, t in section_body(want, "Runs"):
        m = re.match(r"^- ([^:`]+):", t)
        if m and not re.search(r"^- " + re.escape(m.group(1)) + ":", runs, re.M | re.I):
            probs.add("warn", "USER_WORKFLOW.md", None, f"`## Runs` lacks the setting `{m.group(1)}:` (runs use the default)")


def run_checks(root, files=None):
    probs = Problems()
    lists = load(root)
    old_layout = (root / OLD_PLAN).is_file()
    if old_layout:
        probs.add("warn", OLD_PLAN, None, "old plan layout: USER_PLAN.md is replaced by USER_IDEAS.md (ideas) and CLAUDE_PLAN.md (concrete features); run /setup-workflow check to migrate", about=None)
    for lf in lists.values():
        if not lf.exists:
            fix = "migrate the old plan layout with /setup-workflow check" if old_layout else "create it from the template"
            probs.add("error", lf.name, None, f"missing; {fix}")
            continue
        check_header(lf, probs)
        check_structure(lf, probs)
    check_references(lists, probs)
    check_branches(root, lists, probs)
    if not files:
        check_claude_md(root, probs)
        check_user_workflow(root, probs)
    if files:
        probs.items = [p for p in probs.items if p["file"] in files or p["about"] in files]
    return lists, probs.items


def format_problem(p):
    where = p["file"] or "git"
    if p["line"]:
        where += f":{p['line']}"
    return f"{p['level']:<5} {where}: {p['msg']}"


# --------------------------------------------------------------------------- commands


def setup_root():
    root = find_root(Path.cwd())
    if not (root / "USER_WORKFLOW.md").is_file():
        print(f"not set up: {root / 'USER_WORKFLOW.md'} is missing (run /setup-workflow)")
        sys.exit(2)
    return root


def pick_files(args):
    files = [Path(a).name for a in args]
    bad = [f for f in files if f not in LISTS]
    if bad:
        print(f"unknown list file(s): {', '.join(bad)}; expected one of {', '.join(LISTS)}")
        sys.exit(2)
    return files


def cmd_check(args):
    errors_only = "--errors-only" in args
    files = pick_files([a for a in args if not a.startswith("--")])
    root = setup_root()
    lists, found = run_checks(root, files)
    if errors_only:
        found = [p for p in found if p["level"] == "error"]
    found.sort(key=lambda p: (p["level"] != "error", LISTS.index(p["file"]) if p["file"] in LISTS else 9, p["line"] or 0))
    for p in found:
        print(format_problem(p))
    errors = sum(p["level"] == "error" for p in found)
    warnings = len(found) - errors
    work = [it for name, lf in lists.items() if not files or name in files for it in lf.items(ideas=False)]
    held = sum("HOLD" in it.tags for it in work)
    if not found:
        print(f"OK: no problems ({len(work) - held} open, {held} on hold, ideas not counted)")
    else:
        print(f"{plural(errors, 'error')}, {plural(warnings, 'warning')}")
    return 1 if errors else 0


def describe(it):
    parts = [f"L{it.line}"]
    size = it.field("size", "effort")
    if size:
        m = re.match(r"^\W*([SML])\b", size)
        if m:
            parts.append(f"size {m.group(1)}")
    model = next((t.strip()[len("**Model:**"):].strip() for _, t in it.body if t.strip().startswith("**Model:**")), None)
    if model:
        parts.append("model " + model.replace("`", "").replace(", reasoning ", " reasoning "))
    if it.field("decisions") is not None:
        parts.append("decisions")
    for _, t in it.body:
        m = FAILED_RE.match(t.strip())
        if m:
            parts.append(f"FAILED ({m.group('branch') or 'no changes'})")
    if any(t.strip().startswith("_Updated:") for _, t in it.body):
        parts.append("updated")
    head = " ".join([it.ref, *(f"[{t}]" for t in it.tags), it.title])
    return f"  {head} — {', '.join(parts)}"


def cmd_summary(args):
    ideas = "--ideas" in args
    files = pick_files([a for a in args if not a.startswith("--")]) or LISTS
    root = setup_root()
    lists = load(root)
    total_open = total_held = total_ideas = 0
    for name in files:
        lf = lists[name]
        if not lf.exists:
            print(f"{name}: missing")
            continue
        work = list(lf.items(ideas=False))
        idea_items = [it for it in lf.items() if it.section.prefix == "I"]
        held = [it for it in work if "HOLD" in it.tags]
        total_open += len(work) - len(held)
        total_held += len(held)
        total_ideas += len(idea_items)
        if lf.kind == "ideas":
            held_ideas = sum("HOLD" in it.tags for it in idea_items)
            head = f"{name}: {plural(len(idea_items), 'idea')} (backlog)"
            if held_ideas:
                head += f", {held_ideas} on hold"
        else:
            head = f"{name}: {len(work) - len(held)} open"
            if held:
                head += f", {len(held)} on hold"
        print(head)
        for it in work:
            print(describe(it))
        if ideas:
            for it in idea_items:
                print(describe(it))
    print(f"TOTAL: {total_open} open, {total_held} on hold, {plural(total_ideas, 'idea')}")
    return 0


def trim(lines):
    """Drop trailing blank lines and `---` separators."""
    while lines and lines[-1].strip() in ("", "---"):
        lines.pop()
    return lines


def cmd_show(args):
    if not args:
        print("usage: workflow-lists show ID...")
        return 2
    root = setup_root()
    lists = load(root)
    refs = index(lists)
    missing = 0
    for ref in args:
        hit = refs.get(ref)
        if not hit:
            print(f"not found: {ref} (no open entry with this id)")
            missing += 1
            continue
        lf, it = hit
        a, b = entry_span(lf, it)
        print(f"==> {lf.name}:{it.line}")
        print("\n".join(lf.raw.split("\n")[a:b]))
    return 1 if missing else 0


def cmd_section(args):
    if len(args) < 2:
        print("usage: workflow-lists section FILE HEADING...")
        return 2
    path = Path(args[0])
    if not path.is_absolute():
        path = find_root(Path.cwd()) / path
    if not path.is_file():
        print(f"missing: {path}")
        return 2
    raw = path.read_text(encoding="utf-8").split("\n")
    masked = masked_lines("\n".join(raw))
    starts = [n for n, line in enumerate(masked) if re.match(r"^#{1,2} ", line)] + [len(raw)]
    missing = 0
    for want in args[1:]:
        want_low = want.lower().lstrip("# ").strip()
        hit = next((i for i, n in enumerate(starts[:-1])
                    if masked[n].startswith("## ") and masked[n][3:].strip().lower().startswith(want_low)), None)
        if hit is None:
            print(f"not found: ## {want}")
            missing += 1
            continue
        print("\n".join(trim(raw[starts[hit]:starts[hit + 1]])))
        print()
    return 1 if missing else 0


def cmd_stamp(_args):
    root = find_root(Path.cwd())
    commit = git(root, "rev-parse", "--short", "HEAD") or "no commit"
    print(f"{time.strftime('%Y-%m-%d %H:%M %Z')} (`{commit}`)")
    return 0


def cmd_hook(_args):
    try:
        data = json.load(sys.stdin)
    except (ValueError, OSError):
        return 0
    path = (data.get("tool_input") or {}).get("file_path")
    if not path:
        return 0
    path = Path(path)
    if not path.is_absolute():
        path = Path(data.get("cwd") or Path.cwd()) / path
    name, root = path.name, path.resolve().parent
    if name not in LISTS or not (root / "USER_WORKFLOW.md").is_file():
        return 0
    _, found = run_checks(root, [name])
    errors = [p for p in found if p["level"] == "error"]
    if not errors:
        return 0
    print(
        f"workflow-lists: {name} breaks the list rules after this edit "
        "(see list-format.md; if you are mid-change, finish it, then run `workflow-lists check`):",
        file=sys.stderr,
    )
    for p in errors:
        print("  " + format_problem(p), file=sys.stderr)
    return 2


# --------------------------------------------------------------------------- editing

FOOTER_KIND = {"CLAUDE_ANALYSIS.md": "analysis", "USER_ANALYSIS.md": "user analysis", "CLAUDE_PLAN.md": "plan"}
# A suggested-order bullet: `- **1.1** + **3.2**: why` (also `1.`, `,`, `and`, `together with`).
JOINER = r"\s*(?:\+|,|&|and|together with)\s*"
ORDER_LINE_RE = re.compile(
    rf"^(?P<lead>\s*(?:[-*]|\d+\.)\s+)(?P<refs>\*\*[^*\s]+\*\*(?:{JOINER}\*\*[^*\s]+\*\*)*)(?P<rest>.*)$"
)
BOLD_RE = re.compile(r"\*\*([^*\s]+)\*\*")
KEEP_OPEN = "**Keep open for:**"


def now_stamp(root):
    """(date time TZ, short commit) for stamps written now."""
    return time.strftime("%Y-%m-%d %H:%M %Z"), git(root, "rev-parse", "--short", "HEAD") or "no commit"


def index(lists):
    """ref as used outside the files -> (ListFile, Item)."""
    refs = {}
    for lf in lists.values():
        for s in lf.sections:
            for it in s.items:
                refs.setdefault(it.ref, (lf, it))
    return refs


def entry_span(lf, it):
    """0-based [start, end) of an entry's lines, without trailing blank and `---` lines."""
    raw = lf.raw.split("\n")
    end = len(raw)
    for k in range(it.line, len(lf.lines)):
        if lf.lines[k].startswith("## ") or HEADING_RE.match(lf.lines[k]):
            end = k
            break
    start = it.line - 1
    while end - 1 > start and raw[end - 1].strip() in ("", "---"):
        end -= 1
    return start, end


def section_span(lf, section):
    """0-based [start, end) of a section's body (after its heading, up to the next `## `)."""
    start = section.line
    end = next((k for k in range(start, len(lf.lines)) if lf.lines[k].startswith("## ")), len(lf.lines))
    return start, end


def save(lf, raw):
    lf.path.write_text("\n".join(raw), encoding="utf-8")


def collapse_blanks(raw, i):
    """Leave at most one blank line where lines were removed at index i."""
    while 0 < i < len(raw) and not raw[i - 1].strip() and not raw[i].strip():
        del raw[i]


def split_top(value):
    """Split at commas outside parentheses and quotes."""
    parts, cur, depth, quote = [], "", 0, None
    for ch in value:
        if quote:
            quote = None if ch == quote else quote
        elif ch in "\"“":
            quote = '"' if ch == '"' else "”"
        elif ch == "(":
            depth += 1
        elif ch == ")":
            depth = max(0, depth - 1)
        elif ch == "," and depth == 0:
            parts.append(cur.strip())
            cur = ""
            continue
        cur += ch
    if cur.strip():
        parts.append(cur.strip())
    return parts


def wrap(text, width=95, indent=""):
    import textwrap
    return textwrap.wrap(text, width=width, subsequent_indent=indent,
                         break_on_hyphens=False, break_long_words=False) or [text]


def edit_order(lf, tokens, new=None):
    """Remove (or replace by `new`) the bold ids in `tokens` from the suggested-order section.
    Returns (changes, lines left for a manual edit)."""
    order = lf.section(role="order")
    if not order:
        return [], []
    raw = lf.raw.split("\n")
    start, end = section_span(lf, order)
    changes, left = [], []
    k = start
    while k < end:
        line = raw[k]
        if not lf.lines[k] or not any(t in line for t in tokens):
            k += 1
            continue
        m = ORDER_LINE_RE.match(line)
        refs = BOLD_RE.findall(m.group("refs")) if m else []
        if not m or any(t in m.group("rest") for t in tokens):
            left.append((k + 1, line.strip()))
            k += 1
            continue
        refs = [new.strip("*") if f"**{r}**" in tokens else r for r in refs] if new else \
            [r for r in refs if f"**{r}**" not in tokens]
        if refs:
            raw[k] = m.group("lead") + " + ".join(f"**{r}**" for r in refs) + m.group("rest")
            changes.append(f"{lf.name}:{k + 1}: suggested order now `{raw[k].strip()[:70]}`")
            k += 1
            continue
        j = k + 1
        while j < end and raw[j].strip() and raw[j][0].isspace():
            j += 1
        del raw[k:j]
        end -= j - k
        changes.append(f"{lf.name}:{k + 1}: removed suggested-order step `{line.strip()[:70]}`")
    # renumber a numbered list, and fall back to `_No open items._` when no id is left
    n = 0
    for k in range(start, end):
        m = re.match(r"^(\d+)\.(\s.*)$", raw[k])
        if m:
            n += 1
            raw[k] = f"{n}.{m.group(2)}"
    body = [k for k in range(start, end) if raw[k].strip() not in ("", "---")]
    if changes and not body:
        raw[start:start] = ["", "_No open items._"]
        changes.append(f"{lf.name}: suggested order is empty now")
    elif body and not any(BOLD_RE.search(raw[k]) for k in body) and \
            [raw[k].strip() for k in body] != ["_No open items._"]:
        raw[body[0]:body[-1] + 1] = ["_No open items._"]
        changes.append(f"{lf.name}: suggested order is empty now")
    if changes:
        save(lf, raw)
    return changes, [(lf.name, n, t) for n, t in left]


def edit_keep_open(lf, ref, new=None):
    """Remove (or replace by `new`) `ref` in the file's **Keep open for:** lines."""
    raw = lf.raw.split("\n")
    masked = list(lf.lines)
    pat = re.compile(rf"^{re.escape(ref)}(?![\w.])")
    changes = []
    k = 0
    while k < len(raw):
        if not masked[k].strip().startswith(KEEP_OPEN):
            k += 1
            continue
        j = k + 1
        while j < len(raw) and raw[j].strip() and not FIELD_RE.match(raw[j]) and not raw[j].startswith("#"):
            j += 1
        value = " ".join(t.strip() for t in raw[k:j])[len(KEEP_OPEN):].strip()
        dot = value.endswith(".")
        parts = split_top(value.rstrip("."))
        if not any(pat.match(p) for p in parts):
            k = j
            continue
        if new:
            parts = [pat.sub(new, p) if pat.match(p) else p for p in parts]
        else:
            parts = [p for p in parts if not pat.match(p)]
        if parts:
            new_lines = wrap(f"{KEEP_OPEN} " + ", ".join(parts) + ("." if dot else ""))
            raw[k:j] = new_lines
            changes.append(f"{lf.name}:{k + 1}: **Keep open for:** now `{' '.join(new_lines)[:70]}`")
            k += len(new_lines)
        else:
            del raw[k:j]
            collapse_blanks(raw, k)
            changes.append(f"{lf.name}:{k + 1}: removed the **Keep open for:** line (only named {ref})")
        masked = masked_lines("\n".join(raw))
    if changes:
        save(lf, raw)
    return changes


def mention_patterns(lf, it):
    """{file: regex} for mentions of the entry `it` (of list file `lf`) that may remain."""
    i = re.escape(it.id or "")
    if lf.kind == "analysis":
        bare = rf"(?<![\w.]){i}(?!\w|\.\d)"
        user = rf"(?<![\w.])U{i}(?!\w|\.\d)"
        if lf.name == "CLAUDE_ANALYSIS.md":
            return {"CLAUDE_ANALYSIS.md": re.compile(bare)}
        return {"USER_ANALYSIS.md": re.compile(f"{bare}|{user}"), "CLAUDE_ANALYSIS.md": re.compile(user)}
    if it.id is None:
        return {}
    pre = r"claude:" if lf.name == "CLAUDE_IDEAS.md" else r"(?<![\w:])"
    rx = re.compile(rf"{pre}{i}\b")
    return {n: rx for n in ("CLAUDE_PLAN.md", "USER_IDEAS.md", "CLAUDE_IDEAS.md")}


def order_tokens(lf, it):
    """{file: bold tokens} naming the entry in suggested-order sections."""
    if lf.name == "CLAUDE_ANALYSIS.md":
        return {lf.name: {f"**{it.id}**"}}
    if lf.name == "USER_ANALYSIS.md":
        return {lf.name: {f"**{it.id}**", f"**U{it.id}**"}, "CLAUDE_ANALYSIS.md": {f"**U{it.id}**"}}
    if lf.name == "CLAUDE_IDEAS.md":
        return {lf.name: {f"**{it.id}**", f"**claude:{it.id}**"}}
    return {lf.name: {f"**{it.id}**"}}


def leftover_mentions(lists, pats):
    out = []
    for name, rx in pats.items():
        lf = lists[name]
        if not lf.exists:
            continue
        skip = set(n for n, _ in lf.header)
        dropped = lf.section(role="dropped")
        if dropped:
            a, b = section_span(lf, dropped)
            skip |= set(range(a + 1, b + 1))
        for n, line in enumerate(lf.lines, 1):
            if n not in skip and rx.search(line):
                out.append((name, n, line.strip()))
    return out


def report_check(root, files):
    _, found = run_checks(root, sorted(files))
    errors = [p for p in found if p["level"] == "error"]
    for p in errors:
        print(format_problem(p))
    print(f"check: {plural(len(errors), 'error')} in {', '.join(sorted(files))}" if errors else
          f"check: OK ({', '.join(sorted(files))})")
    return 1 if errors else 0


def take_opts(args, flags, bools=()):
    """Split `--flag value` / `--bool` options from positional args."""
    opts, pos, k = {}, [], 0
    while k < len(args):
        a = args[k]
        if a in flags and k + 1 < len(args):
            opts[a] = args[k + 1]
            k += 2
        elif a in bools:
            opts[a] = True
            k += 1
        else:
            pos.append(a)
            k += 1
    return opts, pos


def delete_entry(root, ref, new=None, dropped=None):
    """Delete one entry with its mentions. Returns (touched files, ok)."""
    lists = load(root)
    hit = index(lists).get(ref)
    if not hit:
        print(f"not found: {ref} (no open entry with this id)")
        return set(), False
    lf, it = hit
    raw = lf.raw.split("\n")
    a, b = entry_span(lf, it)
    text = "\n".join(raw[a:b])
    only = it.section.role == "items" and len(it.section.items) == 1
    raw[a:b] = ["_No open items._"] if only else []
    if not only:
        collapse_blanks(raw, a)
    save(lf, raw)
    touched = {lf.name}
    print(f"deleted {' '.join([ref, *(f'[{t}]' for t in it.tags), it.title])} ({lf.name}:{a + 1}-{b})")

    tokens = order_tokens(lf, it)
    pats = mention_patterns(lf, it)
    left = []
    for name, toks in tokens.items():
        lists = load(root)
        if lists[name].exists:
            changes, rest = edit_order(lists[name], toks, new)
            left += rest
            if changes:
                touched.add(name)
                print("\n".join(changes))
    if lf.kind != "analysis" and it.id:
        for name in ("CLAUDE_PLAN.md", "USER_IDEAS.md", "CLAUDE_IDEAS.md"):
            lists = load(root)
            if lists[name].exists:
                changes = edit_keep_open(lists[name], ref, new)
                if changes:
                    touched.add(name)
                    print("\n".join(changes))
    if dropped:
        lists = load(root)
        ideas = lists["CLAUDE_IDEAS.md"]
        sec = ideas.section(role="dropped")
        if lf.name != "CLAUDE_IDEAS.md" or not sec:
            print("--dropped only applies to CLAUDE_IDEAS.md entries (with a `## Dropped` section)")
        else:
            raw = ideas.raw.split("\n")
            s0, s1 = section_span(ideas, sec)
            line = f"- {it.id} {it.title} — {dropped} ({time.strftime('%Y-%m-%d')})"
            empty = [k for k in range(s0, s1) if raw[k].strip() == "_None yet._"]
            items = [k for k in range(s0, s1) if raw[k].startswith("- ")]
            if empty:
                raw[empty[0]] = line
            elif items:
                raw.insert(items[-1] + 1, line)
            else:
                raw[s0:s0] = ["", line]
            save(ideas, raw)
            touched.add(ideas.name)
            print(f"added to ## Dropped: {line}")
    for br in sorted(set(BRANCH_RE.findall(text))):
        if git(root, "branch", "-D", br) is not None:
            print(f"deleted branch {br}")
    lists = load(root)
    for name, n, t in left + [m for m in leftover_mentions(lists, pats) if m[:2] not in {(x, y) for x, y, _ in left}]:
        print(f"check this mention yourself: {name}:{n}: {t[:110]}")
    if lf.name in FOOTER_KIND:
        print(f"Refs: {FOOTER_KIND[lf.name]} {it.id} ({it.title})")
    return touched, True


def cmd_delete(args):
    opts, refs = take_opts(args, {"--to", "--dropped"})
    if not refs:
        print("usage: workflow-lists delete ID... [--to NEW_ID] [--dropped REASON]")
        return 2
    root = setup_root()
    touched, ok = set(), True
    for ref in refs:
        t, good = delete_entry(root, ref, opts.get("--to"), opts.get("--dropped"))
        touched |= t
        ok &= good
    rc = report_check(root, touched) if touched else 0
    return 1 if not ok or rc else 0


def after_stamps(raw, a, b):
    """Index right after the entry's stamp lines (_Found_/_Written_/_Updated_/_Failed_)."""
    k = a + 1
    while k < b and re.match(r"^_(Found|Written|Updated|Failed):", raw[k].strip()):
        k += 1
    return k


def cmd_set(args):
    if len(args) < 2:
        print("usage: workflow-lists set ID decisions TEXT | model SPEC|none | hold | unhold | "
              "failed BRANCH|none MODEL REASON | updated")
        return 2
    ref, what, rest = args[0], args[1], args[2:]
    root = setup_root()
    lists = load(root)
    hit = index(lists).get(ref)
    if not hit:
        print(f"not found: {ref} (no open entry with this id)")
        return 1
    lf, it = hit
    raw = lf.raw.split("\n")
    a, b = entry_span(lf, it)
    date_time, commit = now_stamp(root)
    today = date_time[:10]
    body = range(a + 1, b)

    def find(prefix):
        return [k for k in body if raw[k].strip().startswith(prefix)]

    if what in ("hold", "unhold"):
        tags = [t for t in it.tags if t != "HOLD"]
        if what == "hold":
            sev = 1 if tags and tags[0] in SEVERITIES else 0
            tags.insert(sev, "HOLD")
        head = " ".join(x for x in [it.id, *(f"[{t}]" for t in tags), it.title] if x)
        raw[a] = f"### {head}"
        msg = f"{ref}: heading now `{raw[a]}`"
    elif what == "decisions":
        if not rest:
            print("set ID decisions TEXT: the text is missing")
            return 2
        text = " ".join(rest)
        failed = [k for k in find("_Failed:") if FAILED_RE.match(raw[k].strip())]
        for k in failed:
            m = FAILED_RE.match(raw[k].strip())
            where = f"`{m.group('branch')}`" if m.group("branch") else "(no changes)"
            text += f"; earlier attempt on {where} ({m.group('model')}) failed: {m.group('reason')}"
        old = find("**Decisions:**")
        if old:
            k = old[0]
            j = k + 1
            while j < b and raw[j].strip() and not FIELD_RE.match(raw[j]):
                j += 1
            joined = " ".join(t.strip() for t in raw[k:j])
            raw[k:j] = wrap(f"{joined}; {text} ({today})")
        else:
            raw[b:b] = ["", *wrap(f"**Decisions:** {text} ({today})")]
        for k in sorted(failed, reverse=True):
            del raw[k]
        msg = f"{ref}: decisions recorded" + (" (the _Failed:_ stamp moved into them)" if failed else "")
    elif what == "model":
        spec = " ".join(rest)
        if not spec:
            print("set ID model SPEC|none: the model is missing")
            return 2
        old = find("**Model:**")
        line = f"**Model:** {spec}"
        if spec == "none":
            for k in reversed(old):
                del raw[k]
                collapse_blanks(raw, k)
            msg = f"{ref}: model line removed"
        else:
            if not MODEL_RE.match(line):
                print(f"bad model spec `{spec}`; expected `<model>[, reasoning <level>]`")
                return 2
            if old:
                raw[old[0]] = line
            else:
                raw[b:b] = ["", line]
            msg = f"{ref}: {line}"
    elif what == "failed":
        if len(rest) < 3:
            print("set ID failed BRANCH|none MODEL REASON")
            return 2
        branch, model, reason = rest[0], rest[1], " ".join(rest[2:])
        where = "no changes" if branch in ("none", "-") else f"`{branch}`"
        line = f"_Failed: {date_time} ({where}, {model}): {reason}_"
        raw.insert(after_stamps(raw, a, b), line)
        msg = f"{ref}: {line}"
    elif what == "updated":
        line = f"_Updated: {date_time} (`{commit}`)_"
        old = find("_Updated:")
        if old:
            raw[old[0]] = line
        else:
            raw.insert(after_stamps(raw, a, b), line)
        msg = f"{ref}: {line}"
    else:
        print(f"unknown field `{what}`; use decisions, model, hold, unhold, failed or updated")
        return 2
    save(lf, raw)
    print(msg)
    return report_check(root, {lf.name})


def items_section(lf, number=None):
    if lf.kind == "analysis":
        return lf.section(number=int(number)) if number else None
    return lf.section(prefix="F" if lf.kind == "plan" else "I")


def insert_entry(root, lf, section, entry, before=None):
    """Insert entry lines (heading first) into section; returns the 1-based heading line."""
    raw = lf.raw.split("\n")
    s0, s1 = section_span(lf, section)
    none = [k for k in range(s0, s1) if raw[k].strip() == "_No open items._"]
    if none:
        k = none[0]
        raw[k:k + 1] = entry
    elif before:
        hit = index({lf.name: lf}).get(before)
        if not hit or hit[1].section is not section:
            print(f"--before {before}: not an entry of this section")
            return None
        k = hit[1].line - 1
        raw[k:k] = entry + [""]
    else:
        k = s1
        while k > s0 and raw[k - 1].strip() in ("", "---"):
            k -= 1
        raw[k:k] = [""] + entry
        k += 1
    save(lf, raw)
    return k + 1


def next_id(lf, section):
    """Take the section's next id and count `_Next id:_` up. Returns the id or None."""
    if not section.next_ids:
        print(f"{lf.name}: section `{section.title}` has no `_Next id:_` line")
        return None
    n, val = section.next_ids[0]
    m = re.fullmatch(re.escape(section.prefix) + r"(\d+)", val)
    if not m:
        print(f"{lf.name}:{n}: `_Next id: {val}_` doesn't look like `{section.prefix}<n>`")
        return None
    raw = lf.raw.split("\n")
    raw[n - 1] = f"_Next id: {section.prefix}{int(m.group(1)) + 1}_"
    save(lf, raw)
    return val


def build_entry(lf, item_id, sev, title, body, stamp_line):
    head = " ".join(x for x in [item_id, f"[{sev}]" if sev else "", title] if x)
    lines = [f"### {head}", stamp_line]
    body = body.strip("\n")
    if body:
        lines += [""] + body.split("\n")
    return lines


def cmd_add(args):
    opts, pos = take_opts(args, {"--section", "--sev", "--title", "--model", "--before"})
    if len(pos) != 1 or "--title" not in opts:
        print("usage: workflow-lists add FILE --title TITLE [--section 1|2|3] [--sev H|M|L] "
              "[--model SPEC] [--before ID] < body")
        return 2
    name = pick_files(pos)[0]
    root = setup_root()
    lf = load(root)[name]
    sev = opts.get("--sev", "").upper().strip("[]")
    if sev and sev not in SEVERITIES:
        print(f"--sev {sev}: use H, M or L")
        return 2
    if not sev and not lf.minimal:
        print(f"{name} entries need a severity: --sev H|M|L")
        return 2
    section = items_section(lf, opts.get("--section"))
    if section is None:
        print("--section 1|2|3 is needed for an analysis file" if lf.kind == "analysis" else
              f"{name} has no items section")
        return 2
    body = "" if sys.stdin.isatty() else sys.stdin.read()
    if "--model" in opts:
        line = f"**Model:** {opts['--model']}"
        if not MODEL_RE.match(line):
            print(f"bad model spec `{opts['--model']}`")
            return 2
        body = body.rstrip("\n") + "\n\n" + line
    item_id = next_id(lf, section)
    if item_id is None:
        return 1
    date_time, commit = now_stamp(root)
    word = "Found" if lf.kind == "analysis" else "Written"
    lf = load(root)[name]
    section = items_section(lf, opts.get("--section"))
    entry = build_entry(lf, item_id, sev, opts["--title"], body, f"_{word}: {date_time} (`{commit}`)_")
    line = insert_entry(root, lf, section, entry, opts.get("--before"))
    if line is None:
        return 1
    print(f"added {REF_PREFIX[name]}{item_id} at {name}:{line}")
    return report_check(root, {name})


def cmd_move(args):
    opts, pos = take_opts(args, {"--note"})
    if len(pos) != 2:
        print("usage: workflow-lists move ID FILE [--note TEXT]   (e.g. move claude:I3 USER_IDEAS.md)")
        return 2
    ref, name = pos[0], pick_files(pos[1:])[0]
    root = setup_root()
    lists = load(root)
    hit = index(lists).get(ref)
    if not hit:
        print(f"not found: {ref} (no open entry with this id)")
        return 1
    lf, it = hit
    target = lists[name]
    if target.kind != lf.kind or target.name == lf.name:
        print(f"can only move between two files of the same kind ({lf.name} is `{lf.kind}`)")
        return 2
    raw = lf.raw.split("\n")
    a, b = entry_span(lf, it)
    body = [t for t in raw[a + 1:b] if not re.match(r"^_(Found|Written|Updated):", t.strip())]
    if opts.get("--note"):
        body += ["", *wrap(f"**Notes for Claude:** {opts['--note']}")]
    section = items_section(target)
    new_id = next_id(target, section)
    if new_id is None:
        return 1
    new_ref = REF_PREFIX[name] + new_id
    date_time, commit = now_stamp(root)
    word = "Found" if target.kind == "analysis" else "Written"
    target = load(root)[name]
    entry = build_entry(target, new_id, it.severity, " ".join([*(f"[{t}]" for t in it.tags if t not in SEVERITIES), it.title]),
                        "\n".join(body), f"_{word}: {date_time} (`{commit}`)_")
    line = insert_entry(root, target, items_section(target), entry)
    print(f"added {new_ref} at {name}:{line}")
    touched, ok = delete_entry(root, ref, new=new_ref)
    return report_check(root, touched | {name}) or (0 if ok else 1)


def cmd_pass(args):
    if len(args) < 2:
        print("usage: workflow-lists pass FILE TEXT")
        return 2
    name = pick_files(args[:1])[0]
    root = setup_root()
    lf = load(root)[name]
    raw = lf.raw.split("\n")
    head = [n for n, t in lf.header if t.strip() == "Passes:"]
    if not head:
        print(f"{name}: the header has no `Passes:` list")
        return 1
    k = head[0]  # 0-based index right after `Passes:`
    last = None
    while k < len(raw) and (not raw[k].strip() or raw[k].startswith("- ")) and not raw[k].startswith("#"):
        if raw[k].startswith("- "):
            last = k
        elif last is not None:
            break
        k += 1
    date_time, commit = now_stamp(root)
    line = f"- {date_time} at {commit}: {' '.join(args[1:])}"
    if last is None:
        raw[head[0]:head[0]] = ["", line]
    else:
        raw.insert(last + 1, line)
    save(lf, raw)
    print(f"{name}: {line}")
    return report_check(root, {name})


CITED_RE = re.compile(r"`([^`\s]+)`")


def cited_paths(lf, it):
    a, b = entry_span(lf, it)
    out = set()
    for t in lf.raw.split("\n")[a:b]:
        for c in CITED_RE.findall(t):
            c = re.sub(r":[\d,-]+$", "", c).rstrip("/")
            if ("/" in c or "." in c) and not c.startswith(("workflow/", "**")) and not re.fullmatch(r"[0-9a-f]{4,40}", c):
                out.add(c)
    return out


def cmd_find(args):
    opts, paths = take_opts(args, {"--since"}, {"--show"})
    root = setup_root()
    if "--since" in opts:
        out = git(root, "diff", "--name-only", f"{opts['--since']}..HEAD")
        if out is None:
            print(f"git diff {opts['--since']}..HEAD failed")
            return 2
        paths += [p for p in out.split("\n") if p and Path(p).name not in LISTS]
    if not paths:
        print("usage: workflow-lists find [--since COMMIT] [--show] [PATH...]")
        return 2
    lists = load(root)
    hits, uncited = [], []
    for name in ("CLAUDE_ANALYSIS.md", "USER_ANALYSIS.md"):
        lf = lists[name]
        for it in lf.items(ideas=False):
            cited = cited_paths(lf, it)
            if not cited:
                uncited.append(it.ref)
            elif any(p == c or p.endswith("/" + c) or p.startswith(c + "/") or c.startswith(p.rstrip("/") + "/")
                     for p in paths for c in cited):
                hits.append((lf, it))
    n = len(hits)
    print(f"{n} {'entry cites' if n == 1 else 'entries cite'} the {plural(len(set(paths)), 'path')}")
    for lf, it in hits:
        if "--show" in opts:
            a, b = entry_span(lf, it)
            print(f"==> {lf.name}:{it.line}")
            print("\n".join(lf.raw.split("\n")[a:b]))
        else:
            print(f"{lf.name}:{describe(it).strip()}")
    if uncited:
        print(f"cite no file (judge by title, `show` if needed): {' '.join(uncited)}")
    return 0


SEV_RANK = {"H": 0, "M": 1, "L": 2}
SIZE_RANK = {"S": 0, "M": 1, "L": 2}
NEEDS_RE = re.compile(r"\bneeds\s+(?:\*\*)?(F\d+)", re.I)
PLAN_FIELDS = ["what", "why", "done when", "design docs", "how", "size"]


def item_size(it):
    m = re.match(r"^\W*([SML])\b", it.field("size", "effort") or "")
    return m.group(1) if m else "?"


def item_model(it):
    for _, t in it.body:
        if t.strip().startswith("**Model:**"):
            return t.strip()[len("**Model:**"):].strip().replace("`", "")
    return "default"


def item_failed(it):
    for _, t in it.body:
        m = FAILED_RE.match(t.strip())
        if m:
            return m
    return None


def order_rank(lists, lf):
    """ref -> position in the file's suggested-order section."""
    sec = lf.section(role="order")
    rank = {}
    if not sec:
        return rank
    for _, t in sec.text:
        for b in BOLD_RE.findall(t):
            if lf.kind == "analysis":
                ref = b if b.startswith("U") or lf.name == "CLAUDE_ANALYSIS.md" else "U" + b
            else:
                ref = b
            rank.setdefault(ref, len(rank))
    return rank


def work_order(lists, items):
    """Order (ListFile, Item) pairs: suggested order, then what others build on, severity,
    size, file order; the user's findings before Claude's of the same or lower severity."""
    def key(pair, rank):
        lf, it = pair
        return (rank.get(it.ref, 10 ** 6), SEV_RANK.get(it.severity, 1), SIZE_RANK.get(item_size(it), 3), it.line)

    by_file = {}
    for pair in items:
        by_file.setdefault(pair[0].name, []).append(pair)
    queues = {name: sorted(pairs, key=lambda p: key(p, order_rank(lists, p[0]))) for name, pairs in by_file.items()}
    user, claude = queues.get("USER_ANALYSIS.md", []), queues.get("CLAUDE_ANALYSIS.md", [])
    merged = []
    while user or claude:
        if user and (not claude or SEV_RANK.get(claude[0][1].severity, 1) >= SEV_RANK.get(user[0][1].severity, 1)):
            merged.append(user.pop(0))
        else:
            merged.append(claude.pop(0))
    merged += queues.get("CLAUDE_PLAN.md", [])
    # what others build on ("needs F2") goes first
    refs = [it.ref for _, it in merged]
    needs = {it.ref: [n for n in NEEDS_RE.findall("\n".join(t for _, t in it.body)) if n in refs and n != it.ref]
             for _, it in merged}
    out, seen = [], set()

    def visit(ref, stack=()):
        if ref in seen or ref in stack:
            return
        for n in needs.get(ref, []):
            visit(n, stack + (ref,))
        seen.add(ref)
        out.append(ref)

    for r in refs:
        visit(r)
    pairs = {it.ref: (lf, it) for lf, it in merged}
    return [pairs[r] for r in out]


def triage_reason(root, lf, it):
    """Why an entry needs a look at the code before a run, or None if it is READY as written."""
    if lf.kind == "analysis":
        text = "\n".join(t for _, t in it.body).lower() + it.title.lower()
        if re.search(r"\b(verify|possible|possibly)\b", text):
            return "marked verify/possible"
        if lf.user and not cited_paths(lf, it):
            return "user finding citing no file"
        return "is it still there, is the fix clear"
    if "CONFLICT" in it.tags:
        return "[CONFLICT]"
    have = it.fields() | ({"size"} if "effort" in it.fields() else set())
    missing = [f for f in PLAN_FIELDS if f not in have]
    if missing:
        return "written or edited by hand (no " + ", ".join(missing) + ")"
    stamp = next((t for _, t in it.body if t.strip().startswith("_Written:")), "")
    m = re.search(r"\(`?([0-9a-f]{4,40})`?\)", stamp)
    cited = cited_paths(lf, it)
    if m and cited:
        out = git(root, "diff", "--name-only", f"{m.group(1)}..HEAD")
        if out:
            changed = [p for p in out.split("\n") if Path(p).name not in LISTS]
            hit = [c for c in cited if any(p == c or p.endswith("/" + c) or p.startswith(c + "/") for p in changed)]
            if hit:
                return "cited files changed since it was written (" + ", ".join(sorted(hit)[:3]) + ")"
    return None


def cmd_triage(args):
    opts, files = take_opts(args, {"--skip", "--only"})
    files = pick_files(files)
    if not files:
        print("usage: workflow-lists triage LIST... [--skip IDS] [--only IDS]   (ids comma- or space-separated)")
        return 2
    root = setup_root()
    lists = load(root)
    skip = set(re.split(r"[,\s]+", opts.get("--skip", "")) ) - {""}
    only = set(re.split(r"[,\s]+", opts.get("--only", ""))) - {""}
    items, held, skipped = [], [], []
    for name in files:
        lf = lists[name]
        for it in lf.items(ideas=False):
            if only and it.ref not in only:
                continue
            if "HOLD" in it.tags:
                held.append(it.ref)
            elif it.ref in skip:
                skipped.append(it.ref)
            else:
                items.append((lf, it))
    ordered = work_order(lists, items)
    print("ORDER: " + " ".join(it.ref for _, it in ordered))
    counts = {"READY": 0, "FAILED": 0, "CHECK": 0}
    for lf, it in ordered:
        head = f"{it.ref} | size {item_size(it)} | model {item_model(it)}"
        f = item_failed(it)
        if f:
            counts["FAILED"] += 1
            where = f.group("branch") or "no changes"
            print(f"FAILED: {head} | {it.title} — {where}, {f.group('model')}: {f.group('reason')}")
            continue
        why = triage_reason(root, lf, it)
        if why:
            counts["CHECK"] += 1
            print(f"CHECK: {head} | {it.title} — {why}")
        else:
            counts["READY"] += 1
            print(f"READY: {head}")
    if held:
        print("HELD: " + " ".join(held))
    if skipped:
        print("SKIPPED: " + " ".join(skipped))
    print(f"TOTAL: {counts['READY']} ready, {counts['CHECK']} to check, {counts['FAILED']} failed")
    return 0


# --------------------------------------------------------------------------- runs

RUN_KINDS = {"fixes": ["CLAUDE_ANALYSIS.md", "USER_ANALYSIS.md"], "features": ["CLAUDE_PLAN.md"]}
MODEL_KINDS = ("triage", "features", "fixes", "review", "analysis")
ITEM_SKILL = {"fixes": "fix-next-finding", "features": "implement-next-feature"}
DEFAULT_RUNS = {
    "models": {k: ["inherit", None] for k in MODEL_KINDS},
    "escalate": None,
    "review": "features always; fixes of size M or L, or more than 150 changed lines",
    "rework": 1,
    "analyse": {"features": True, "fixes": False},
    "stop_after": 3,
    "run_branch": False,
    "limits": {"turns": 80, "usd": 5.0},
    "permissions": "bypassPermissions",
    "stats": "~/.claude/dev-workflow/stats.jsonl",
}
LIST_EXCLUDES = [".", ":!*_PLAN.md", ":!*_IDEAS.md", ":!*_ANALYSIS.md"]
PLUGIN_ROOT = Path(__file__).resolve().parent.parent
TEST_PATH_RE = re.compile(r"(^|/)(tests?|spec|__tests__)/|(^|/)test_[^/]+$|_test\.[^/]+$|\.(test|spec)\.[^/]+$")


def git_run(root, *args):
    """(ok, combined output) of a git command."""
    try:
        out = subprocess.run(["git", *args], cwd=root, capture_output=True, text=True)
    except OSError as e:
        return False, str(e)
    return out.returncode == 0, (out.stdout + out.stderr).strip()


def plugin_version():
    try:
        return json.loads((PLUGIN_ROOT / ".claude-plugin" / "plugin.json").read_text()).get("version", "?")
    except (OSError, ValueError):
        return "?"


def parse_runs(root):
    """Settings from USER_WORKFLOW.md -> ## Runs, and the names of the missing ones."""
    lines = masked_lines((root / "USER_WORKFLOW.md").read_text(encoding="utf-8"))
    text = "\n".join(t for _, t in section_body(lines, "Runs"))
    cfg = json.loads(json.dumps(DEFAULT_RUNS))
    missing = []

    def setting(name):
        m = re.search(rf"^- {name}:\s*(.+(?:\n  .+)*)", text, re.M | re.I)
        if not m:
            missing.append(name)
        return " ".join(m.group(1).split()) if m else None

    v = setting("Models")
    if v:
        for kind, model, effort in re.findall(
                rf"\b({'|'.join(MODEL_KINDS)})\s+`?([\w.:-]+)(?:,\s*reasoning\s+(\w+))?`?", v, re.I):
            cfg["models"][kind.lower()] = [model, effort or None]
    v = setting("Escalate failed items to")
    if v:
        m = re.match(r"`?([\w.:-]+)", v)
        cfg["escalate"] = None if not m or m.group(1).lower() in ("none", "no") else m.group(1)
    v = setting("Fresh review")
    if v:
        cfg["review"] = v
    v = setting("Rework rounds")
    if v and re.match(r"\d+", v):
        cfg["rework"] = int(re.match(r"\d+", v).group())
    v = setting("Analyse after run")
    if v:
        for kind, yes in re.findall(r"\b(features|fixes)\s+(yes|no)\b", v, re.I):
            cfg["analyse"][kind.lower()] = yes.lower() == "yes"
    v = setting("Stop after consecutive failures")
    if v and re.match(r"\d+", v):
        cfg["stop_after"] = int(re.match(r"\d+", v).group())
    v = setting("Run branch")
    if v:
        cfg["run_branch"] = v.lower().startswith("yes")
    v = setting("Limits per agent")
    if v:
        m = re.search(r"(\d+)\s*turns", v)
        if m:
            cfg["limits"]["turns"] = int(m.group(1))
        m = re.search(r"(\d+(?:\.\d+)?)\s*USD", v, re.I)
        if m:
            cfg["limits"]["usd"] = float(m.group(1))
    v = setting("Headless permissions")
    if v:
        m = re.match(r"`?(\w+)", v)
        if m:
            cfg["permissions"] = m.group(1)
    v = setting("Stats file")
    if v:
        m = re.match(r"`?([^`\s]+)", v)
        cfg["stats"] = None if not m or m.group(1).lower() == "none" else m.group(1)
    return cfg, missing


REVIEW_TOKEN_RE = re.compile(
    r"(?P<kind>\bfeatures\b|\bfixes\b|\bany item\b|\bitems\b)|(?P<always>\balways\b)|(?P<never>\bnever\b)"
    r"|of size (?P<sizes>[sml](?:\s*(?:or|and|,)\s*[sml])*)\b|more than (?P<lines>\d+) changed lines"
)


def review_due(rule, kind, size, lines):
    """Does the `Fresh review` rule ask for a review of this item? Clauses may name a kind
    (`features always; fixes of size M or L, or more than 150 changed lines`); a clause
    without one applies to every kind."""
    current, verdict = None, None
    for m in REVIEW_TOKEN_RE.finditer(rule.lower()):
        if m.group("kind"):
            current = m.group("kind") if m.group("kind") in ("features", "fixes") else None
            continue
        if current not in (None, kind):
            continue
        if m.group("always"):
            return True
        if m.group("never"):
            verdict = False
        elif m.group("sizes") and size.lower() in re.findall(r"[sml]", m.group("sizes")):
            return True
        elif m.group("lines") and lines > int(m.group("lines")):
            return True
    return bool(verdict)


def changed_lines(root, rev_range):
    ok, out = git_run(root, "diff", "--shortstat", rev_range, "--", *LIST_EXCLUDES)
    return sum(int(n) for n in re.findall(r"(\d+) (?:insertion|deletion)", out)) if ok else 0


def workflow_scope(root):
    lines = (root / "USER_WORKFLOW.md").read_text(encoding="utf-8").split("\n")
    return "workflow" if any(re.match(r"^- `workflow`", l) for l in lines) else None


def project_has_tests(root):
    out = git(root, "ls-files") or ""
    return any(TEST_PATH_RE.search(p) for p in out.split("\n"))


class Run:
    def __init__(self, root, kind):
        self.root, self.kind = root, kind
        out = git(root, "rev-parse", "--git-path", "workflow-run")
        d = Path(out) if out else Path(".git/workflow-run")
        self.dir = d if d.is_absolute() else Path.cwd() / d
        self.log_path = self.dir / f"{kind}.log"
        self.state_path = self.dir / f"{kind}.json"
        self.state = json.loads(self.state_path.read_text()) if self.state_path.is_file() else None

    def log(self, line):
        self.dir.mkdir(parents=True, exist_ok=True)
        with self.log_path.open("a", encoding="utf-8") as f:
            f.write(line.rstrip("\n") + "\n")

    def log_lines(self):
        return self.log_path.read_text(encoding="utf-8").split("\n") if self.log_path.is_file() else []

    def save(self):
        self.dir.mkdir(parents=True, exist_ok=True)
        self.state_path.write_text(json.dumps(self.state, indent=1), encoding="utf-8")

    def commit(self, files, subject, body=None, no_verify=False):
        scope = self.state.get("scope")
        if scope and subject.startswith("chore: "):
            subject = f"chore({scope}): " + subject[len("chore: "):]
        git_run(self.root, "add", "--", *files)
        args = ["commit", "-q", "-m", subject]
        for part in (body, self.state.get("footer")):
            if part:
                args += ["-m", part]
        if no_verify:
            args.append("--no-verify")
        ok, out = git_run(self.root, *args)
        if not ok:
            print(f"commit failed: {out}")
            return None
        return git(self.root, "rev-parse", "--short", "HEAD")

    def stat(self, record):
        """Append one JSON line to the stats file (if configured) and count the cost."""
        st = self.state
        record = {"ts": time.strftime("%Y-%m-%dT%H:%M:%S%z"), "project": self.root.name,
                  "plugin": st.get("plugin", plugin_version()), "run": st["start"], "kind": self.kind, **record}
        st["spent"] = round(st.get("spent", 0.0) + (record.get("cost_usd") or 0.0), 4)
        path = st["settings"].get("stats")
        if not path:
            return
        try:
            p = Path(path).expanduser()
            p.parent.mkdir(parents=True, exist_ok=True)
            with p.open("a", encoding="utf-8") as f:
                f.write(json.dumps(record, sort_keys=True) + "\n")
        except OSError as e:
            print(f"stats: could not write {path}: {e}")


def need_run(kind):
    if kind not in RUN_KINDS:
        print(f"unknown kind `{kind}`; use fixes or features")
        sys.exit(2)
    root = setup_root()
    run = Run(root, kind)
    return root, run


def need_state(kind):
    root, run = need_run(kind)
    if not run.state:
        print(f"no {kind} run is in progress (run start first)")
        sys.exit(2)
    return root, run


def dirty(root):
    return git(root, "status", "--porcelain") or ""


def item_model_spec(run, it):
    m = MODEL_RE.match(f"**Model:** {item_model(it)}") if it and item_model(it) != "default" else None
    if m:
        spec = item_model(it)
        return [spec.split(",")[0].strip(), m.group("effort")]
    return list(run.state["settings"]["models"][run.kind])


def wip_branch(root, ref):
    if ref.startswith("U"):
        base = f"workflow/failed/user-analysis-{ref[1:]}"
    elif ref.startswith("F"):
        base = f"workflow/failed/plan-{ref}"
    else:
        base = f"workflow/failed/analysis-{ref}"
    name, n = base, 1
    while git(root, "rev-parse", "--verify", "--quiet", f"refs/heads/{name}") is not None:
        n += 1
        name = f"{base}-{n}"
    return name


def save_attempt(run, ref, reason, before=None):
    """Move a failed attempt (uncommitted changes and any commits since `before`) to a WIP
    branch and put the run branch back to `before`. Returns the branch or None."""
    root = run.root
    head = git(root, "rev-parse", "--short", "HEAD")
    moved = bool(before) and git(root, "rev-parse", before) != git(root, "rev-parse", "HEAD")
    if not dirty(root) and not moved:
        return None
    branch = wip_branch(root, ref)
    back = run.state["run_branch"]
    ok, out = git_run(root, "switch", "-q", "-c", branch)
    if not ok:
        print(f"could not create {branch}: {out}")
        return None
    if dirty(root):
        git_run(root, "add", "-A")
        run.commit([], f"wip: failed attempt at {ref}", reason, no_verify=True)
    git_run(root, "switch", "-q", back)
    if moved:
        git_run(root, "reset", "-q", "--hard", before)
        print(f"moved the commits {before}..{head} of {ref} to {branch} and reset {back} to {before}")
    run.state.setdefault("saved", {}).setdefault(ref, []).append(branch)
    print(f"saved the attempt on {branch}")
    return branch


def record_failure(run, ref, model, reason):
    """Stamp the entry, commit it, count the failure. Returns the action line."""
    root = run.root
    saved = run.state.get("saved", {}).pop(ref, [])
    for br in saved[:-1]:
        git_run(root, "branch", "-D", br)
    branch = saved[-1] if saved else None
    lists = load(root)
    hit = index(lists).get(ref)
    if hit:
        lf, it = hit
        raw = lf.raw.split("\n")
        a, b = entry_span(lf, it)
        date_time, _ = now_stamp(root)
        where = f"`{branch}`" if branch else "no changes"
        raw.insert(after_stamps(raw, a, b), f"_Failed: {date_time} ({where}, {model}): {reason}_")
        save(lf, raw)
        run.commit([lf.name], f"chore: record failed attempt at {ref}")
    run.log(f"failed {ref} {branch or 'no-changes'} — {reason}")
    run.state["consecutive"] = run.state.get("consecutive", 0) + 1
    limit = run.state["settings"]["stop_after"]
    if run.state["consecutive"] >= limit:
        return f"STOP: {run.state['consecutive']} failures in a row (limit {limit}); something is wrong beyond one item"
    return "CONTINUE"


def cmd_run(args):
    if not args or args[0] not in RUN_COMMANDS:
        print("usage: workflow-lists run start|queue|skip|log|next|result|commit|changes|end|go KIND ...")
        return 2
    return RUN_COMMANDS[args[0]](args[1:])


def start_run(root, run, opts):
    """Create the run state (or resume an interrupted run). Returns True when resumed."""
    kind = run.kind
    last = [l for l in run.log_lines() if l.strip()][-1:]
    resumed = bool(run.state) and bool(last) and last[0] != "end"
    if resumed:
        st = run.state
        print(f"RESUMED the {kind} run from {st['start']} on {st['run_branch']} (interrupted)")
        cur = st.get("current")
        if cur:
            still_open = cur["id"] in index(load(root))
            moved = cur.get("before") and git(root, "rev-parse", cur["before"]) != git(root, "rev-parse", "HEAD")
            if dirty(root) or (moved and still_open):
                print(f"item {cur['id']} was interrupted mid-way: recording it as failed")
                save_attempt(run, cur["id"], "run interrupted", cur.get("before"))
                print(record_failure(run, cur["id"], cur["model"][0], "run interrupted"))
            elif still_open:
                st["queue"].insert(0, cur["id"])
                print(f"item {cur['id']} was interrupted before it finished: queued again first")
            else:
                run.log(f"RESULT: DONE {cur['id']} (finished before the interruption)")
            st["current"] = None
            run.save()
        return True
    if dirty(root):
        print("DIRTY: the tree has changes; every item commits, so commit or stash them first:")
        print(dirty(root))
        sys.exit(1)
    settings, missing = parse_runs(root)
    branch = git(root, "branch", "--show-current") or "HEAD"
    start = git(root, "rev-parse", "--short", "HEAD") or "no-commit"
    default = (git(root, "symbolic-ref", "--short", "refs/remotes/origin/HEAD") or "").split("/")[-1]
    if settings["run_branch"] and branch in {"main", "master", default} - {""}:
        base = f"workflow/{time.strftime('%Y-%m-%d')}-{kind}"
        name, n = base, 1
        while git(root, "rev-parse", "--verify", "--quiet", f"refs/heads/{name}") is not None:
            n += 1
            name = f"{base}-{n}"
        git_run(root, "switch", "-q", "-c", name)
        print(f"run branch: created and switched to {name} (the user merges it)")
        branch = name
    for f in (run.log_path, run.state_path):
        if f.exists():
            f.unlink()
    import shutil
    shutil.rmtree(run.dir / "analysis", ignore_errors=True)
    run.state = {
        "kind": kind, "start": start, "run_branch": branch, "plugin": plugin_version(),
        "lists": ["USER_ANALYSIS.md"] if opts.get("--user-only") else RUN_KINDS[kind],
        "user_only": bool(opts.get("--user-only")), "settings": settings, "missing": missing,
        "footer": opts.get("--footer"), "scope": workflow_scope(root),
        "max": int(opts["--max"]) if opts.get("--max") else None,
        "queue": [], "sizes": {}, "started": [], "partial": {}, "blocked": [], "redecided": [],
        "current": None, "retry": None, "rework": None, "reworked": {}, "consecutive": 0, "saved": {},
        "spent": 0.0, "tests": project_has_tests(root),
    }
    run.log(f"start {start} {branch}")
    for ref in re.split(r"[,\s]+", opts.get("--skip", "")):
        if ref:
            run.log(f"skip {ref}")
    run.save()
    print(f"STARTED a {kind} run from {start} on {branch} (plugin {run.state['plugin']})")
    return False


def print_settings(run, resumed):
    st = run.state
    s = st["settings"]
    m = s["models"]
    print("models: " + ", ".join(f"{k} {v[0]}" + (f" ({v[1]})" if v[1] else "") for k, v in m.items())
          + f"; escalate to {s['escalate'] or 'none'}")
    print(f"fresh review: {s['review']}; rework rounds: {s['rework']}; analyse after run: "
          f"{'yes' if s['analyse'][run.kind] else 'no'}; stop after {s['stop_after']} failures; "
          f"limits {s['limits']['turns']} turns, {s['limits']['usd']} USD per agent; stats: {s['stats'] or 'off'}")
    if st["missing"]:
        print("missing ## Runs settings (defaults used; suggest /setup-workflow check): " + ", ".join(st["missing"]))
    if resumed:
        print("queue: " + (" ".join(st["queue"]) or "(empty)"))


def run_start(args):
    opts, pos = take_opts(args, {"--max", "--skip", "--footer"}, {"--user-only"})
    if len(pos) != 1:
        print('usage: workflow-lists run start fixes|features [--user-only] [--max N] [--skip IDS] [--footer "<attribution lines>"]')
        return 2
    root, run = need_run(pos[0])
    resumed = start_run(root, run, opts)
    print_settings(run, resumed)
    return 0


def run_queue(args):
    opts, pos = take_opts(args, set(), {"--append"})
    if not pos:
        print("usage: workflow-lists run queue KIND [--append] ID[:SIZE]...")
        return 2
    _, run = need_state(pos[0])
    st = run.state
    ids = []
    for tok in pos[1:]:
        for t in re.split(r"[,\s]+", tok):
            if t:
                ref, _, size = t.partition(":")
                ids.append(ref)
                if size:
                    st["sizes"][ref] = size.upper()
    st["queue"] = (st["queue"] if opts.get("--append") else []) + [i for i in ids if i not in st["queue"]]
    run.save()
    print(f"queue: {' '.join(st['queue']) or '(empty)'} ({plural(len(st['queue']), 'item')})")
    return 0


def run_skip(args):
    if len(args) < 2:
        print("usage: workflow-lists run skip KIND ID...")
        return 2
    _, run = need_state(args[0])
    for ref in args[1:]:
        run.log(f"skip {ref}")
        if ref in run.state["queue"]:
            run.state["queue"].remove(ref)
    run.save()
    print("skipped: " + " ".join(args[1:]))
    return 0


def run_log(args):
    if len(args) < 2:
        print("usage: workflow-lists run log KIND LINE")
        return 2
    _, run = need_state(args[0])
    run.log(" ".join(args[1:]))
    return 0


def next_item(run):
    """Pick the next unit of work. Returns {"status": NEXT|REDECIDE|EMPTY|LIMIT, ...}."""
    root, st = run.root, run.state
    note, escalated, rework = None, False, None
    if st.get("rework"):
        r = st.pop("rework")
        ref, model, rework = r["id"], r["model"], r
    elif st.get("retry"):
        r = st.pop("retry")
        ref, model, escalated = r["id"], [r["model"], None], True
        note = f"An earlier attempt with {r['from']} failed: {r['reason']}."
        if r.get("branch"):
            note += (f" Its changes are on branch `{r['branch']}` (`git diff {st['run_branch']}...{r['branch']}`); "
                     "use them if helpful, but start from the current code.")
    else:
        if st["max"] and len(st["started"]) >= st["max"]:
            return {"status": "LIMIT", "line": f"LIMIT: {st['max']} items done; go to the after-run steps"}
        if not st["queue"]:
            again = [b for b in st["blocked"] if b not in st["redecided"]]
            if again:
                st["redecided"] += again
                run.save()
                return {"status": "REDECIDE", "ids": again, "line": "REDECIDE: " + " ".join(again)
                        + " (blocked during the run: triage and ask again with --only, then queue --append)"}
            return {"status": "EMPTY", "line": "EMPTY: the queue is done; go to the after-run steps"}
        ref = st["queue"].pop(0)
        hit = index(load(root)).get(ref)
        model = item_model_spec(run, hit[1] if hit else None)
        if ref not in st["started"]:
            st["started"].append(ref)
    hit = index(load(root)).get(ref)
    size = st["sizes"].get(ref) or (item_size(hit[1]) if hit else "?")
    entry = rework["entry"] if rework else ("\n".join(hit[0].raw.split("\n")[slice(*entry_span(*hit))]) if hit else "")
    st["current"] = {"id": ref, "before": git(root, "rev-parse", "--short", "HEAD"), "model": model,
                     "escalated": escalated, "size": size, "entry": entry, "rework": rework}
    run.save()
    m = "inherit (omit `model`)" if model[0] == "inherit" else model[0]
    line = f"NEXT: {ref} | model {m}" + (f" | effort {model[1]}" if model[1] else "") + f" | size {size}"
    if rework:
        line += f" | rework round {rework['round']}"
        note = rework["note"]
    return {"status": "NEXT", "id": ref, "model": model, "size": size, "note": note, "line": line, "rework": rework}


def run_next(args):
    if len(args) != 1:
        print("usage: workflow-lists run next KIND")
        return 2
    _, run = need_state(args[0])
    n = next_item(run)
    print(n["line"])
    if n.get("note"):
        print(f"APPEND TO PROMPT: {n['note']}")
    return 0


RESULT_LINE_RE = re.compile(r"^(BLOCKED|DEFAULTS|SCOPE|UNVERIFIED|NOTE|RESULT):\s*(.*)$")


def result_lines(answer):
    return [(m.group(1), m.group(2).strip()) for m in
            (RESULT_LINE_RE.match(l.strip()) for l in answer.split("\n")) if m]


def test_note(run, ref, before):
    """A NOTE line when the project has tests but the item's commits touched none."""
    if not run.state.get("tests"):
        return None
    subjects = git(run.root, "log", "--format=%s", f"{before}..HEAD") or ""
    if run.kind == "fixes" and not any(s.startswith("fix") for s in subjects.split("\n")):
        return None
    out = git(run.root, "diff", "--name-only", f"{before}..HEAD", "--", *LIST_EXCLUDES) or ""
    files = [p for p in out.split("\n") if p]
    if files and not any(TEST_PATH_RE.search(p) for p in files):
        return f"{ref} — changed no test file (the project has tests)"
    return None


def apply_result(run, answer, review=None, analysis=False):
    """Book an agent's answer. Returns the action line (CONTINUE / REVIEW: … / RETRY: … /
    REWORK: … / STOP: …)."""
    root, st = run.root, run.state
    found = result_lines(answer)
    cur = st.get("current")
    prefix = f"review {review} " if review else ""
    for key, val in found:
        run.log(f"{prefix}{key}: {val}")
    result = next((v for k, v in reversed(found) if k == "RESULT"), None)
    if review and result:  # the words of review-change before plugin 4.0
        result = re.sub(r"^CLEAN\b", "ACCEPTED", re.sub(r"^REVIEWED\b", "ACCEPTED", result))

    if review or analysis:
        if dirty(root):
            st["current"] = None
            run.save()
            return f"STOP: the tree is not clean after the {'review of ' + review if review else 'analysis'}:\n{dirty(root)}"
        if review and result and result.split()[0] == "REWORK":
            reasons = re.sub(r"^REWORK\s*(?:—|-)?\s*", "", result)
            rounds = st["settings"]["rework"]
            done = st["reworked"].get(review, 0)
            if done < rounds and cur and cur.get("id") == review:
                st["reworked"][review] = done + 1
                st["rework"] = {
                    "id": review, "model": cur["model"], "entry": cur["entry"], "round": done + 1,
                    "range": f"{cur['before']}..HEAD",
                    "note": (f"A fresh review of your commits ({cur['before']}..HEAD) asks for rework: {reasons} "
                             "Fix exactly that, verify again and commit a follow-up."),
                }
                st["current"] = None
                run.save()
                return f"REWORK: {review} (round {done + 1} of {rounds}) — {reasons}"
            run.log(f"NOTE: {review} — review asked for rework after the last round: {reasons}")
        st["current"] = None
        run.save()
        return "CONTINUE"

    if not cur:
        return "STOP: no item is in progress (run next first)"
    ref = cur["id"]
    word = result.split()[0] if result else "MISSING"
    if not result:
        run.log(f"RESULT: FAILED {ref} — no RESULT line")
    action = "CONTINUE"
    if word in ("DONE", "PARTIAL"):
        st["consecutive"] = 0
        for br in st.get("saved", {}).pop(ref, []):
            git_run(root, "branch", "-D", br)
        if dirty(root):
            st["current"] = None
            run.save()
            return f"STOP: {ref} reported {word} but left the tree dirty:\n{dirty(root)}"
        if word == "PARTIAL" and not cur.get("rework"):
            st["partial"][ref] = st["partial"].get(ref, 0) + 1
            if st["partial"][ref] == 1:
                st["queue"].append(ref)
                print(f"{ref} is partly done: queued once more at the end")
            else:
                run.log(f"skip {ref}")
                print(f"{ref} is partly done a second time: left open")
        tn = test_note(run, ref, cur["before"])
        if tn:
            run.log(f"NOTE: {tn}")
        lines = changed_lines(root, f"{cur['before']}..HEAD")
        if cur.get("rework"):
            cur["before"] = cur["rework"]["range"].split("..")[0]  # review the whole item again
        final = st["reworked"].get(ref, 0) >= st["settings"]["rework"]
        if cur.get("rework") or review_due(st["settings"]["review"], run.kind, cur["size"], lines):
            rm = st["settings"]["models"]["review"]
            action = (f"REVIEW: {cur['before']}..HEAD {ref}" + (" final" if final else "") + " | model "
                      + ("inherit (omit `model`)" if rm[0] == "inherit" else rm[0])
                      + (f" | effort {rm[1]}" if rm[1] else "") + f" ({lines} changed lines, size {cur['size']})")
            run.save()  # keep `current` for the review's rework decision
            return action
    elif word == "BLOCKED":
        if ref not in st["blocked"]:
            st["blocked"].append(ref)
    elif word == "NOTHING_LEFT":
        pass
    else:
        m = re.match(r"FAILED\s+\S+\s*(?:—|-)?\s*(.*)$", result or "")
        reason = (m.group(1) if m and m.group(1) else None) or ("no RESULT line" if not result else result)
        branch = save_attempt(run, ref, reason, cur.get("before"))
        esc = st["settings"]["escalate"]
        if cur.get("rework"):
            run.log(f"NOTE: {ref} — rework failed: {reason}; the reviewed commits stay as they were")
        elif esc and not cur["escalated"] and cur["model"][0] != esc:
            st["retry"] = {"id": ref, "model": esc, "from": cur["model"][0], "reason": reason, "branch": branch}
            action = f"RETRY: {ref} once more with {esc} (run next gives the prompt addition)"
        else:
            action = record_failure(run, ref, cur["model"][0], reason)
    st["current"] = None
    run.save()
    return action


def run_result(args):
    opts, pos = take_opts(args, {"--review"}, {"--analysis"})
    if len(pos) != 1:
        print("usage: workflow-lists run result KIND [--review ID | --analysis] < the agent's answer")
        return 2
    _, run = need_state(pos[0])
    answer = "" if sys.stdin.isatty() else sys.stdin.read()
    if not opts.get("--review") and not opts.get("--analysis") and not run.state.get("current"):
        print("no item is in progress (run next first)")
        return 2
    action = apply_result(run, answer, review=opts.get("--review"), analysis=bool(opts.get("--analysis")))
    print(action)
    return 1 if action.startswith("STOP") else 0


def run_commit(args):
    if len(args) < 2:
        print('usage: workflow-lists run commit KIND "chore: <description>"')
        return 2
    root, run = need_state(args[0])
    files = [m.group(1) for m in (re.match(r"^\s*[MADRCU?!]{1,2}\s+(.+)$", l) for l in dirty(root).split("\n"))
             if m and Path(m.group(1)).name in LISTS]
    if not files:
        print("nothing to commit in the list files")
        return 0
    c = run.commit(files, " ".join(args[1:]))
    print(f"committed {c}: {' '.join(files)}" if c else "commit failed")
    return 0 if c else 1


def change_size(run):
    """(analyse?, reason, rows, total lines) of the change since the run's start."""
    root, st = run.root, run.state
    start = st["start"]
    commits = git(root, "rev-list", "--count", f"{start}..HEAD") or "0"
    if not st["settings"]["analyse"][run.kind] or commits == "0":
        return False, ('off for ' + run.kind if not st['settings']['analyse'][run.kind] else 'no commits'), [], 0
    ok, out = git_run(root, "diff", "--numstat", f"{start}..HEAD", "--", *LIST_EXCLUDES)
    rows = [l.split("\t") for l in out.split("\n") if l.count("\t") == 2] if ok else []
    total = sum(int(a) + int(b) for a, b, _ in rows if a.isdigit() and b.isdigit())
    return True, "", rows, total


def group_rows(rows):
    groups = {}
    for a, b, path in rows:
        top = path.split("/")[0] if "/" in path else "."
        g = groups.setdefault(top, [0, []])
        g[0] += (int(a) if a.isdigit() else 0) + (int(b) if b.isdigit() else 0)
        g[1].append(path)
    return sorted(groups.items(), key=lambda x: -x[1][0])


def run_changes(args):
    if len(args) != 1:
        print("usage: workflow-lists run changes KIND")
        return 2
    _, run = need_state(args[0])
    yes, why, rows, total = change_size(run)
    if not yes:
        print(f"ANALYSE: no ({why})")
        return 0
    large = len(rows) > 40 or total > 8000
    print(f"ANALYSE: yes, since {run.state['start']}: {plural(len(rows), 'file')}, {total} changed lines — "
          + ("large: split it into parts" if large else "small: one agent"))
    if large:
        for top, (n, paths) in group_rows(rows):
            print(f"  {top}/: {plural(len(paths), 'file')}, {n} lines")
        print(f"part output dir: {run.dir / 'analysis'}")
    return 0


def run_report(run):
    root, st = run.root, run.state
    run.log("end")
    log = run.log_lines()
    done, partial, blocked, gone, failed, defaults, unverified, scopes, reviews, analysis, skipped, notes = ([] for _ in range(12))
    for l in log:
        m = re.match(r"^(?:review (\S+) )?(\w+):\s*(.*)$", l)
        if l.startswith("gone "):
            gone.append(l[5:])
        elif l.startswith("failed "):
            failed.append(l[7:])
        elif l.startswith("skip "):
            skipped.append(l[5:])
        elif m:
            rid, key, val = m.groups()
            if key == "NOTE":
                notes.append((f"review of {rid}: " if rid else "") + val)
            elif rid:
                if key == "RESULT" and (not val.startswith("ACCEPTED") or len(val.split()) > 1):
                    reviews.append(f"{rid}: {val}")
                elif key == "SCOPE":
                    scopes.append(val)
            elif key == "RESULT":
                w = val.split()
                if w and w[0] == "DONE" and len(w) > 1:
                    done.append(w[1])
                elif w and w[0] == "PARTIAL" and len(w) > 1:
                    partial.append(w[1])
                elif w and w[0] == "ANALYSED":
                    analysis.append(val)
            elif key == "BLOCKED":
                blocked.append(val)
            elif key == "DEFAULTS":
                defaults.append(val)
            elif key == "UNVERIFIED":
                unverified.append(val)
            elif key == "SCOPE":
                scopes.append(val)
    blocked = list(dict.fromkeys(b for b in blocked if b.split()[0] not in done))
    notes = list(dict.fromkeys(notes))
    print(f"REPORT: {run.kind} run from {st['start']} on {st['run_branch']} (plugin {st.get('plugin', '?')})"
          + (" (run branch: merge it yourself)" if st['run_branch'].startswith("workflow/") else ""))
    out = git(root, "log", "--oneline", f"{st['start']}..HEAD")
    print("commits:" + ("\n  " + out.replace("\n", "\n  ") if out else " none"))

    def block(title, rows):
        if rows:
            print(f"{title}:")
            for r in rows:
                print(f"  {r}")

    block("done", [" ".join(dict.fromkeys(done))] if done else [])
    block("partly done (rest still open)", partial)
    block("removed as already done (restore from git if wrong)", gone)
    block("blocked (decision needed)", blocked)
    block("skipped", [" ".join(dict.fromkeys(skipped))] if skipped else [])
    lists = load(root)
    held = [it.ref for n in st["lists"] for it in lists[n].items(ideas=False) if "HOLD" in it.tags]
    block("on hold", [" ".join(held)] if held else [])
    block("failed (attempt on the branch)", failed)
    block("defaults chosen", defaults)
    block("not verified", unverified)
    block("notes from the agents (side issues, missing tests)", notes)
    block("reviews that changed something or asked for rework", reviews)
    block("after-run analysis", analysis)
    block("commits without a fitting scope (suggested scopes)", scopes)
    if st["missing"]:
        block("missing ## Runs settings (defaults used; /setup-workflow check)", [", ".join(st["missing"])])
    _, found = run_checks(root, st["lists"])
    block("list errors", [format_problem(p) for p in found if p["level"] == "error"])
    if st["user_only"]:
        open_claude = sum(1 for it in lists["CLAUDE_ANALYSIS.md"].items() if "HOLD" not in it.tags)
        print(f"CLAUDE_ANALYSIS.md (not part of this run): {open_claude} open")
    if st.get("spent"):
        print(f"cost: {st['spent']:.2f} USD for the headless agents" + (f" (stats in {st['settings']['stats']})" if st["settings"].get("stats") else ""))
    print("nothing was pushed")


def run_end(args):
    if len(args) != 1:
        print("usage: workflow-lists run end KIND")
        return 2
    _, run = need_state(args[0])
    run.stat({"role": "run", "id": None, "outcome": "end", "cost_usd": 0.0,
              "commits": int(git(run.root, "rev-list", "--count", f"{run.state['start']}..HEAD") or 0)})
    run.save()
    run_report(run)
    return 0


# --------------------------------------------------------------------------- headless driver


def headless(run, prompt, model, role):
    """Run one `claude -p` agent and wait. Returns (answer text, stats record)."""
    proc, t0 = headless_async(run, prompt, model, role)
    if proc is None:
        return f"RESULT: FAILED — could not start claude: {t0}", {"role": role, "model": model[0], "outcome": "error"}
    return headless_wait(proc, t0, model, role)


def plugin_prompt(skill, argument):
    return (f"You are working in the repo at the current directory, unattended: nobody will answer "
            f"questions. Invoke the `dev-workflow:{skill}` skill with the argument `{argument}` (if the "
            f"Skill tool is unavailable, read `{PLUGIN_ROOT}/skills/{skill}/SKILL.md` and follow it "
            f"exactly). Work on exactly that, and end with the lines that skill defines.")


def rework_prompt(run, n):
    r = n["rework"]
    return (f"You are working in the repo at the current directory, unattended: nobody will answer "
            f"questions. {r['note']}\n\nThe item is {n['id']}. Its list entry was already deleted (the "
            f"lists are not yours to edit); it read:\n\n{r['entry']}\n\nRun `workflow-lists brief --context` "
            f"for the rules, standards and verification, read `{PLUGIN_ROOT}/skills/setup-workflow/work-item.md` "
            f"sections C to E and G, then do the rework: fix what the review asks, run the verification and "
            f"the item's Verify steps, and commit the follow-up with the same commit type as the reviewed "
            f"commits and their `Refs:` footer with `, rework` inside the parentheses. Keep your final answer "
            f"to at most three plain lines plus the result lines of work-item.md section H, ending with "
            f"`RESULT: DONE {n['id']} <short commit>` or `RESULT: FAILED {n['id']} — <reason>`.")


def outcome_of(answer):
    r = next((v for k, v in reversed(result_lines(answer)) if k == "RESULT"), "")
    return (r.split() or ["MISSING"])[0]


def run_go(args):
    opts, pos = take_opts(args, {"--max", "--skip", "--footer", "--extra"}, {"--user-only", "--auto"})
    if len(pos) != 1:
        print("usage: workflow-lists run go fixes|features [--auto [--max N] [--skip IDS] [--footer TEXT] [--user-only]] [--extra ARGS]")
        return 2
    kind = pos[0]
    root, run = need_run(kind)
    if not run.state or opts.get("--auto"):
        if not opts.get("--auto"):
            print(f"no {kind} run is prepared: run the /{'fix-all-findings' if kind == 'fixes' else 'implement-all-features'} "
                  "skill (triage and decisions), or `run go --auto` to queue only the items that are READY as written")
            return 2
        resumed = start_run(root, run, opts)
        print_settings(run, resumed)
        if not resumed or not run.state["queue"]:
            lists = ["USER_ANALYSIS.md"] if opts.get("--user-only") else RUN_KINDS[kind]
            out = subprocess.run([sys.executable, "-I", __file__, "triage", *lists, "--skip", opts.get("--skip", "")],
                                 cwd=root, capture_output=True, text=True).stdout
            ready = [l.split()[1] for l in out.split("\n") if l.startswith("READY: ")]
            other = [l for l in out.split("\n") if l.startswith(("CHECK: ", "FAILED: "))]
            if other:
                print("left out (need triage with the skill):\n  " + "\n  ".join(other))
            order = next((l[7:].split() for l in out.split("\n") if l.startswith("ORDER: ")), [])
            run.state["queue"] = [r for r in order if r in ready]
            run.save()
            print(f"queue: {' '.join(run.state['queue']) or '(empty)'}")
    st = run.state
    extras = opts.get("--extra") or ("user-only" if st.get("user_only") else "")
    skill = ITEM_SKILL[kind]
    status = None
    while True:
        n = next_item(run)
        status = n["status"]
        if status != "NEXT":
            print(n["line"])
            break
        print(n["line"], flush=True)
        if n["rework"]:
            prompt = rework_prompt(run, n)
        else:
            prompt = plugin_prompt(skill, f"{n['id']} unattended {extras}".strip())
            if n["note"]:
                prompt += "\n\n" + n["note"]
        cur = dict(st["current"])
        answer, rec = headless(run, prompt, n["model"], "item")
        rec.update({"id": n["id"], "size": n["size"], "escalated": cur["escalated"],
                    "rework_round": n["rework"]["round"] if n["rework"] else 0, "outcome": outcome_of(answer)})
        run.stat(rec)
        for line in answer.strip().split("\n")[-6:]:
            if RESULT_LINE_RE.match(line.strip()):
                print("  " + line.strip())
        action = apply_result(run, answer)
        print(action + (f"  [{rec.get('turns')} turns, {rec.get('cost_usd') or 0:.2f} USD]" if rec.get("turns") else ""), flush=True)
        while action.startswith("REVIEW:"):
            m = re.match(r"REVIEW: (\S+) (\S+)( final)? \| model (\S+)(?: \(omit `model`\))?(?: \| effort (\S+))?", action)
            rng, ref, final, rmodel, reffort = m.group(1), m.group(2), bool(m.group(3)), m.group(4), m.group(5)
            r_answer, r_rec = headless(run, plugin_prompt("review-change", f"{rng} {ref} unattended" + (" final" if final else "")),
                                       [rmodel, reffort], "review")
            r_rec.update({"id": ref, "size": n["size"], "outcome": outcome_of(r_answer)})
            run.stat(r_rec)
            for line in r_answer.strip().split("\n")[-6:]:
                if RESULT_LINE_RE.match(line.strip()):
                    print("  review " + line.strip())
            action = apply_result(run, r_answer, review=ref)
            print(action + (f"  [{r_rec.get('turns')} turns, {r_rec.get('cost_usd') or 0:.2f} USD]" if r_rec.get("turns") else ""), flush=True)
        if action.startswith("STOP"):
            status = "STOP"
            break
    if status == "REDECIDE":
        run.save()
        print("the run pauses: decide these items with the skill (it runs `run go` again afterwards)")
        return 3
    if status in ("EMPTY", "LIMIT"):
        after_run(run)
    run_end([kind])
    return 1 if status == "STOP" else 0


def after_run(run):
    """The closing analysis of a run's changes, split into parallel part agents when large."""
    root, st = run.root, run.state
    yes, why, rows, total = change_size(run)
    if not yes:
        print(f"ANALYSE: no ({why})")
        return
    start = st["start"]
    large = len(rows) > 40 or total > 8000
    print(f"ANALYSE: since {start}, {plural(len(rows), 'file')}, {total} changed lines" + (", split into parts" if large else ""), flush=True)
    amodel = st["settings"]["models"]["analysis"]
    parts = ""
    if large:
        groups = group_rows(rows)
        # 3-8 parts: merge the smallest top-level groups until at most 8 remain
        while len(groups) > 8:
            a, b = groups.pop(), groups.pop()
            groups.append((f"{b[0]}+{a[0]}", [a[1][0] + b[1][0], a[1][1] + b[1][1]]))
        out_dir = run.dir / "analysis"
        out_dir.mkdir(parents=True, exist_ok=True)
        procs = []
        for i, (top, (_, paths)) in enumerate(groups, 1):
            prompt = (f"Read-only analysis; don't edit any project file. Read "
                      f"`{PLUGIN_ROOT}/skills/analyse-code/part.md` and follow it as a part agent for "
                      f"{' '.join(paths)} since {start}, `after-run`, with the output file `{out_dir / f'part-{i}.md'}`.")
            procs.append((i, top, headless_async(run, prompt, amodel, "analysis-part")))
        for i, top, (proc, t0) in procs:
            answer, rec = headless_wait(proc, t0, amodel, "analysis-part")
            rec.update({"id": f"part-{i}", "outcome": "done" if "PART DONE" in answer else outcome_of(answer)})
            run.stat(rec)
            print(f"  part {i} ({top}): {answer.strip().split(chr(10))[-1][:80]}", flush=True)
        parts = f" parts={out_dir}"
    answer, rec = headless(run, plugin_prompt("analyse-code", f"since={start} after-run{parts} unattended"), amodel, "analysis")
    rec.update({"id": None, "outcome": outcome_of(answer)})
    run.stat(rec)
    action = apply_result(run, answer, analysis=True)
    print(f"analysis: {next((v for k, v in result_lines(answer) if k == 'RESULT'), 'no RESULT line')}; {action}", flush=True)


def headless_async(run, prompt, model, role):
    """Start a `claude -p` agent without waiting. Items get the full limits, the other roles half."""
    s = run.state["settings"]
    turns, usd = s["limits"]["turns"], s["limits"]["usd"]
    if role != "item":
        turns, usd = max(10, turns // 2), usd / 2
    exe = os.environ.get("WORKFLOW_LISTS_CLAUDE", "claude")
    cmd = [exe, "-p", prompt, "--output-format", "json", "--no-session-persistence",
           "--permission-mode", s["permissions"], "--max-turns", str(turns), "--max-budget-usd", str(usd)]
    if model[0] and model[0] != "inherit":
        cmd += ["--model", model[0]]
    if model[1]:
        cmd += ["--effort", model[1]]
    env = {k: v for k, v in os.environ.items() if k != "CLAUDECODE"}
    try:
        return subprocess.Popen(cmd, cwd=run.root, stdout=subprocess.PIPE, stderr=subprocess.PIPE, text=True, env=env), time.time()
    except OSError as e:
        return None, str(e)


def headless_wait(proc, t0, model, role):
    stdout, stderr = proc.communicate()
    try:
        data = json.loads(stdout)
    except ValueError:
        data = {}
    usage = data.get("usage") or {}
    rec = {"role": role, "model": model[0] or "inherit", "effort": model[1],
           "models": sorted((data.get("modelUsage") or {}).keys()), "turns": data.get("num_turns"),
           "duration_s": round(time.time() - t0, 1),
           "api_s": round(data["duration_api_ms"] / 1000, 1) if isinstance(data.get("duration_api_ms"), (int, float)) else None,
           "cost_usd": data.get("total_cost_usd"),
           "input": usage.get("input_tokens"), "cache_write": usage.get("cache_creation_input_tokens"),
           "cache_read": usage.get("cache_read_input_tokens"), "output": usage.get("output_tokens"),
           "subtype": data.get("subtype")}
    answer = data.get("result") or ""
    if not data:
        answer = f"RESULT: FAILED — claude exited {proc.returncode} without JSON output: {(stderr or stdout).strip()[-300:]}"
    elif data.get("subtype") not in (None, "success"):
        answer += f"\nRESULT: FAILED — the agent was stopped: {data['subtype']}"
    elif data.get("is_error"):
        answer += f"\nRESULT: FAILED — agent error: {str(data.get('result'))[:200]}"
    return answer, rec


RUN_COMMANDS = {
    "start": run_start,
    "queue": run_queue,
    "skip": run_skip,
    "log": run_log,
    "next": run_next,
    "result": run_result,
    "commit": run_commit,
    "changes": run_changes,
    "end": run_end,
    "go": run_go,
}


# --------------------------------------------------------------------------- stats


def stats_path(args_file=None):
    if args_file:
        return Path(args_file).expanduser()
    root = find_root(Path.cwd())
    if (root / "USER_WORKFLOW.md").is_file():
        cfg, _ = parse_runs(root)
        if cfg["stats"]:
            return Path(cfg["stats"]).expanduser()
    return Path(DEFAULT_RUNS["stats"]).expanduser()


def fmt_num(v, digits=0):
    if v is None:
        return "-"
    return f"{v:,.{digits}f}"


def cmd_stats(args):
    opts, pos = take_opts(args, {"--file", "--project", "--since", "--by", "--role", "--kind"}, {"--items"})
    path = stats_path(opts.get("--file"))
    if not path.is_file():
        print(f"no stats yet at {path}")
        return 1
    rows = []
    for line in path.read_text(encoding="utf-8").split("\n"):
        if line.strip():
            try:
                rows.append(json.loads(line))
            except ValueError:
                continue
    role = opts.get("--role", "item")
    rows = [r for r in rows if (role == "all" or r.get("role") == role)
            and (not opts.get("--project") or r.get("project") == opts["--project"])
            and (not opts.get("--kind") or r.get("kind") == opts["--kind"])
            and (not opts.get("--since") or r.get("ts", "") >= opts["--since"])]
    if not rows:
        print(f"no matching rows in {path} (role {role})")
        return 1
    if opts.get("--items"):
        print("ts                 project          plugin  kind      id        size model    turns   tokens   wall s  api s   cost  outcome")
        for r in rows:
            toks = sum(r.get(k) or 0 for k in ("input", "cache_write", "cache_read"))
            print(f"{(r.get('ts') or '')[:16]:<19}{(r.get('project') or '')[:16]:<17}{(r.get('plugin') or ''):<8}"
                  f"{(r.get('kind') or ''):<10}{str(r.get('id') or ''):<10}{str(r.get('size') or ''):<5}"
                  f"{(r.get('model') or '')[:8]:<9}{fmt_num(r.get('turns')):>5}{fmt_num(toks):>10}{fmt_num(r.get('duration_s')):>8}"
                  f"{fmt_num(r.get('api_s')):>7}{fmt_num(r.get('cost_usd'), 2):>7}  {r.get('outcome') or ''}")
        return 0
    import statistics
    keys = [k.strip() for k in (opts.get("--by") or "plugin").split(",")]
    groups = {}
    for r in rows:
        groups.setdefault(tuple(str(r.get({"version": "plugin"}.get(k, k)) or "-") for k in keys), []).append(r)

    def med(vals, digits=0):
        vals = [v for v in vals if v is not None]
        return fmt_num(statistics.median(vals), digits) if vals else "-"

    head = " | ".join(keys)
    print(f"{head:<28} agents  done%   med turns  med tokens(ctx)  med out  med wall s  med api s  med cost  total cost")
    for key, rs in sorted(groups.items()):
        done = sum(1 for r in rs if r.get("outcome") in ("DONE", "PARTIAL", "ACCEPTED", "done", "ANALYSED"))
        toks = [sum(r.get(k) or 0 for k in ("input", "cache_write", "cache_read")) for r in rs if r.get("turns") is not None]
        print(f"{' | '.join(key):<28}{len(rs):>7}{100 * done // len(rs):>6}%{med([r.get('turns') for r in rs]):>11}"
              f"{med(toks):>16}{med([r.get('output') for r in rs]):>9}{med([r.get('duration_s') for r in rs]):>12}"
              f"{med([r.get('api_s') for r in rs]):>11}{med([r.get('cost_usd') for r in rs], 2):>10}"
              f"{fmt_num(sum(r.get('cost_usd') or 0 for r in rs), 2):>12}")
    print(f"({len(rows)} rows, role {role}, from {path}; tokens(ctx) = input + cache write + cache read per agent; wall s = elapsed, api s = waiting on the model, the rest is tools and waits)")
    return 0


# --------------------------------------------------------------------------- brief


def cmd_brief(args):
    if len(args) != 1:
        print("usage: workflow-lists brief ID | --context")
        return 2
    root = setup_root()
    lists = load(root)
    it = None
    if args[0] != "--context":
        hit = index(lists).get(args[0])
        if not hit:
            print(f"not found: {args[0]} (no open entry with this id)")
            return 1
        lf, it = hit
        a, b = entry_span(lf, it)
        print(f"==> {lf.name}:{it.line} (the item)")
        print("\n".join(lf.raw.split("\n")[a:b]))
    keep = it.field("keep open for") if it else None
    if keep:
        refs = [m.group(0) for m in PLAN_REF_RE.finditer(re.sub(r'"[^"]*"|“[^”]*”', "", keep))]
        for ref in refs:
            h = index(lists).get(ref)
            if h:
                x, y = entry_span(*h)
                print(f"\n==> {h[0].name}:{h[1].line} (Keep open for: {ref})")
                print("\n".join(h[0].raw.split("\n")[x:y]))
    rules = PLUGIN_ROOT / "skills" / "setup-workflow" / "item-rules.md"
    if rules.is_file():
        print("\n==> rules (item-rules.md)")
        print(rules.read_text(encoding="utf-8").strip())
    uw = (root / "USER_WORKFLOW.md").read_text(encoding="utf-8").split("\n")
    masked = masked_lines("\n".join(uw))
    starts = [n for n, line in enumerate(masked) if re.match(r"^#{1,2} ", line)] + [len(uw)]
    for want in ("design docs", "code standards", "hands-off", "ask before", "commits"):
        k = next((i for i, n in enumerate(starts[:-1]) if masked[n].startswith("## ") and masked[n][3:].strip().lower().startswith(want)), None)
        if k is not None:
            print(f"\n==> USER_WORKFLOW.md")
            print("\n".join(trim(uw[starts[k]:starts[k + 1]])))
    cm = root / "CLAUDE.md"
    if cm.is_file():
        lines = masked_lines(cm.read_text(encoding="utf-8"))
        body = section_body(lines, "Workflow")
        raw = cm.read_text(encoding="utf-8").split("\n")
        for sub in ("### Code scope", "### Verification"):
            idx = [n for n, t in body if t.strip() == sub]
            if idx:
                k = idx[0] - 1
                j = k + 1
                while j < len(raw) and not re.match(r"^#{1,3} ", raw[j]):
                    j += 1
                print(f"\n==> CLAUDE.md")
                print("\n".join(trim(raw[k:j])))
    print(f"\n==> repo: HEAD {git(root, 'rev-parse', '--short', 'HEAD') or 'no commit'}; "
          + ("tree clean" if not dirty(root) else "uncommitted changes (not yours; leave them):\n" + dirty(root)))
    return 0


COMMANDS = {
    "check": cmd_check,
    "summary": cmd_summary,
    "show": cmd_show,
    "section": cmd_section,
    "brief": cmd_brief,
    "stamp": cmd_stamp,
    "delete": cmd_delete,
    "set": cmd_set,
    "add": cmd_add,
    "move": cmd_move,
    "pass": cmd_pass,
    "find": cmd_find,
    "triage": cmd_triage,
    "run": cmd_run,
    "stats": cmd_stats,
    "hook": cmd_hook,
}


def main(argv):
    if len(argv) < 2 or argv[1] not in COMMANDS:
        print(__doc__.strip())
        return 2
    return COMMANDS[argv[1]](argv[2:])


if __name__ == "__main__":
    sys.exit(main(sys.argv))
